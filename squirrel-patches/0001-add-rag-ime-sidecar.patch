+  func rememberRagImeCommittedContext(_ text: String) {
+    let normalized = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !normalized.isEmpty else { return }
+    pruneRagImeCommittedContext()
+    let combined = [ragImeCommittedContext, normalized].filter { !$0.isEmpty }.joined(separator: " ")
+    ragImeCommittedContext = boundedRagImeCommittedContext(combined)
+    ragImeCommittedContextUpdatedAt = Date()
+  }
