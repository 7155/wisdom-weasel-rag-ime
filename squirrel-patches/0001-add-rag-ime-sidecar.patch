+
+  func removeLastRagImeCommittedContextCharacter() {
+    var context = ragImeCommittedContext.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !context.isEmpty else {
+      ragImeCommittedContext = ""
+      ragImeCommittedContextUpdatedAt = .distantPast
+      return
+    }
+    context.removeLast()
+    ragImeCommittedContext = boundedRagImeCommittedContext(context)
+    ragImeCommittedContextUpdatedAt = Date()
+  }
+
+  func boundedRagImeCommittedContext(_ text: String) -> String {
+    let normalized = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    if normalized.count > ragImeCommittedContextLimit {
+      return String(normalized.suffix(ragImeCommittedContextLimit))
+    }
+    return normalized
+  }
