diff --git a/sources/RagImeAssistantPanelController.swift b/sources/RagImeAssistantPanelController.swift
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/sources/RagImeAssistantPanelController.swift
@@ -0,0 +1,320 @@
+import AppKit
+
+final class RagImeAssistantPanelController {
+  typealias TraceHandler = (_ event: String, _ fields: [String: Any]) -> Void
+  private let panel: RagImeNonActivatingPanel
+  private let cardView: RagImeSuggestionCardView
+  private var currentPayload: RagImeAssistantOverlayPayload?
+  private var currentState: RagImeAssistantSurfaceState = .hidden
+  private var renderedSnapshotId = ""
+  private var renderedStableIds: [String] = []
+  private var expandedSnapshotId = ""
+  private var pendingUpdate: DispatchWorkItem?
+  private var lastReliableCaretAnchor: NSPoint?
+  private var lastPositionedAnchor: NSPoint?
+  private var visibleSince: Date?
+  private var generatingTimer: Timer?
+  private var generatingFrame = 0
+  private var didTraceCreation = false
+  private var onSelect: ((RagImeDisplayCandidate, Int) -> Void)?
+  private var onAction: ((RagImeAssistantAction) -> Void)?
+  private var onTrace: TraceHandler?
+
+  init() {
+    panel = RagImeNonActivatingPanel(
+      contentRect: NSRect(x: 0, y: 0, width: 360, height: 40),
+      styleMask: [.borderless, .nonactivatingPanel],
+      backing: .buffered,
+      defer: false
+    )
+    cardView = RagImeSuggestionCardView(frame: panel.contentView?.bounds ?? .zero)
+    panel.isReleasedWhenClosed = false
+    panel.isFloatingPanel = true
+    panel.level = .floating
+    panel.backgroundColor = .clear
+    panel.isOpaque = false
+    panel.hasShadow = true
+    panel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .transient, .ignoresCycle]
+    panel.contentView = cardView
+    cardView.onSelect = { [weak self] candidate, index in self?.onSelect?(candidate, index) }
+    cardView.onAction = { [weak self] action in self?.handle(action) }
+  }
+
+  var isVisible: Bool { panel.isVisible }
+
+  func update(
+    _ payload: RagImeAssistantOverlayPayload?,
+    anchor: NSPoint?,
+    onSelect: ((RagImeDisplayCandidate, Int) -> Void)?,
+    onAction: ((RagImeAssistantAction) -> Void)? = nil,
+    onTrace: TraceHandler? = nil
+  ) {
+    self.onSelect = onSelect
+    self.onAction = onAction
+    self.onTrace = onTrace
+    traceCreationIfNeeded()
+    pendingUpdate?.cancel()
+    let work = DispatchWorkItem { [weak self] in self?.apply(payload, anchor: anchor) }
+    pendingUpdate = work
+    DispatchQueue.main.async(execute: work)
+    trace("assistant_panel_update_coalesced", ["reason": "main_runloop"])
+  }
+
+  func expandPredictions() -> Bool {
+    guard currentState == .compactPrediction, let payload = currentPayload else { return false }
+    guard payload.candidates.filter(RagImeSuggestionCardView.isRealCandidate).count > 1 else { return false }
+    expandedSnapshotId = payload.snapshotId
+    _ = applyVisible(payload, state: .expandedPredictions, anchor: lastReliableCaretAnchor, forceContent: true)
+    return true
+  }
+
+  func showConfirmation(text _: String = "✓ 已插入") {
+    guard let payload = currentPayload else { return }
+    currentState = .transientConfirmation
+    cardView.apply(state: .transientConfirmation, payload: payload)
+    panel.ignoresMouseEvents = true
+    panel.setContentSize(NSSize(width: 280, height: 40))
+    trace("assistant_surface_state_changed", [
+      "surfaceState": RagImeAssistantSurfaceState.transientConfirmation.rawValue,
+      "snapshotId": payload.snapshotId,
+      "reason": "candidate_accepted",
+    ])
+    DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(700)) { [weak self] in
+      guard self?.currentState == .transientConfirmation else { return }
+      self?.dismiss(reason: "confirmation_finished")
+    }
+  }
+
+  func dismiss(reason: String) {
+    pendingUpdate?.cancel()
+    pendingUpdate = nil
+    let duration = visibleSince.map { Int(Date().timeIntervalSince($0) * 1000) } ?? 0
+    currentPayload = nil
+    currentState = .hidden
+    renderedSnapshotId = ""
+    renderedStableIds = []
+    expandedSnapshotId = ""
+    visibleSince = nil
+    stopGeneratingAnimation()
+    if panel.isVisible { panel.orderOut(nil) }
+    trace("assistant_panel_dismissed", ["reason": reason, "visibleDurationMs": duration])
+    trace("assistant_surface_state_changed", ["surfaceState": RagImeAssistantSurfaceState.hidden.rawValue, "reason": reason])
+  }
+
+  private func apply(_ payload: RagImeAssistantOverlayPayload?, anchor: NSPoint?) {
+    let start = CFAbsoluteTimeGetCurrent()
+    guard let payload, payload.visible else {
+      dismiss(reason: payload?.dismissReason ?? "hidden")
+      return
+    }
+    let state = surfaceState(for: payload)
+    guard state != .hidden else {
+      dismiss(reason: payload.phase == "composition" ? "composition" : "passive_pending_or_status_only")
+      return
+    }
+    if let anchor { lastReliableCaretAnchor = anchor }
+    if !state.isExplicit && anchor == nil {
+      trace("assistant_panel_anchor_missing", ["surfaceState": state.rawValue, "anchorSource": "missing", "reason": "passive_requires_caret"])
+      dismiss(reason: "passive_anchor_missing")
+      return
+    }
+    guard applyVisible(payload, state: state, anchor: anchor, forceContent: false) else { return }
+    trace("assistant_panel_content_updated", [
+      "surfaceState": state.rawValue,
+      "snapshotId": payload.snapshotId,
+      "candidateCount": payload.candidates.count,
+      "updateDurationMs": (CFAbsoluteTimeGetCurrent() - start) * 1000,
+    ])
+  }
+
+  @discardableResult
+  private func applyVisible(_ payload: RagImeAssistantOverlayPayload, state: RagImeAssistantSurfaceState, anchor: NSPoint?, forceContent: Bool) -> Bool {
+    let stableIds = payload.candidates.filter(RagImeSuggestionCardView.isRealCandidate).map {
+      $0.candidateStableId ?? "\($0.sourceType):\($0.insertText)"
+    }
+    if payload.snapshotId == renderedSnapshotId && stableIds == renderedStableIds && state == currentState && !forceContent {
+      trace("assistant_panel_reused", ["snapshotId": payload.snapshotId, "reason": "same_snapshot_stable_ids"])
+      return false
+    }
+    let wasVisible = panel.isVisible
+    currentPayload = payload
+    currentState = state
+    renderedSnapshotId = payload.snapshotId
+    renderedStableIds = stableIds
+    cardView.apply(state: state, payload: payload)
+    updateGeneratingAnimation(for: state)
+    panel.ignoresMouseEvents = state == .compactPrediction
+    panel.setContentSize(contentSize(for: state, payload: payload))
+    position(state: state, anchor: anchor)
+    if !wasVisible {
+      visibleSince = Date()
+      panel.alphaValue = NSWorkspace.shared.accessibilityDisplayShouldReduceMotion ? 1 : 0
+      panel.orderFront(nil)
+      if !NSWorkspace.shared.accessibilityDisplayShouldReduceMotion {
+        NSAnimationContext.runAnimationGroup { context in
+          context.duration = 0.1
+          panel.animator().alphaValue = 1
+        }
+      }
+      trace("assistant_panel_first_visible", ["surfaceState": state.rawValue, "snapshotId": payload.snapshotId])
+    }
+    trace("assistant_surface_state_changed", [
+      "surfaceState": state.rawValue,
+      "snapshotId": payload.snapshotId,
+      "candidateStableIds": stableIds,
+      "candidateCount": stableIds.count,
+      "sourceTypes": payload.candidates.map(\.sourceType),
+      "reason": forceContent ? "user_expand" : "payload",
+    ])
+    return true
+  }
+
+  private func surfaceState(for payload: RagImeAssistantOverlayPayload) -> RagImeAssistantSurfaceState {
+    if payload.phase == "composition" { return .hidden }
+    let explicit = payload.phase == "active_rag" || payload.uiMode.contains("active_rag")
+    let realCandidates = payload.candidates.filter(RagImeSuggestionCardView.isRealCandidate)
+    if explicit { return realCandidates.isEmpty ? .explicitGenerating : .explicitResult }
+    guard !realCandidates.isEmpty else { return .hidden }
+    if expandedSnapshotId == payload.snapshotId && realCandidates.count > 1 { return .expandedPredictions }
+    return .compactPrediction
+  }
+
+  private func updateGeneratingAnimation(for state: RagImeAssistantSurfaceState) {
+    guard state == .explicitGenerating else {
+      stopGeneratingAnimation()
+      return
+    }
+    generatingFrame = 0
+    let reduceMotion = NSWorkspace.shared.accessibilityDisplayShouldReduceMotion
+    cardView.updateGeneratingFrame(generatingFrame, reduceMotion: reduceMotion)
+    trace("assistant_generating_animation_started", [
+      "intervalMs": 500,
+      "reduceMotion": reduceMotion,
+      "surfaceState": state.rawValue,
+    ])
+    guard !reduceMotion, generatingTimer == nil else { return }
+    let timer = Timer(timeInterval: 0.5, repeats: true) { [weak self] _ in
+      guard let self, self.currentState == .explicitGenerating else { return }
+      self.generatingFrame = (self.generatingFrame + 1) % 4
+      self.cardView.updateGeneratingFrame(self.generatingFrame, reduceMotion: false)
+    }
+    generatingTimer = timer
+    RunLoop.main.add(timer, forMode: .common)
+  }
+
+  private func stopGeneratingAnimation() {
+    let wasRunning = generatingTimer != nil
+    generatingTimer?.invalidate()
+    generatingTimer = nil
+    generatingFrame = 0
+    if wasRunning {
+      trace("assistant_generating_animation_stopped", ["reason": "surface_state_changed"])
+    }
+  }
+
+  private func contentSize(for state: RagImeAssistantSurfaceState, payload: RagImeAssistantOverlayPayload) -> NSSize {
+    let realCandidates = payload.candidates.filter(RagImeSuggestionCardView.isRealCandidate)
+    let longest = realCandidates.map { $0.text.isEmpty ? $0.insertText : $0.text }.max(by: { $0.count < $1.count }) ?? ""
+    let measuredWidth = (longest as NSString).size(withAttributes: [.font: NSFont.systemFont(ofSize: 13.5)]).width + 108
+    let width = min(520, max(280, min(420, measuredWidth)))
+    switch state {
+    case .compactPrediction: return NSSize(width: width, height: RagImeSuggestionCardView.compactHeight)
+    case .expandedPredictions: return NSSize(width: width, height: RagImeSuggestionCardView.rowHeight * CGFloat(min(3, realCandidates.count)))
+    case .explicitGenerating: return NSSize(width: max(360, width), height: RagImeSuggestionCardView.thinkingHeight)
+    case .explicitResult:
+      let text = realCandidates.first.map { $0.text.isEmpty ? $0.insertText : $0.text } ?? ""
+      let rect = (text as NSString).boundingRect(
+        with: NSSize(width: max(336, width - 24), height: 1000),
+        options: [.usesLineFragmentOrigin, .usesFontLeading],
+        attributes: [.font: NSFont.systemFont(ofSize: 13.5)]
+      )
+      return NSSize(width: max(360, width), height: min(220, max(96, ceil(rect.height) + 74)))
+    case .transientConfirmation, .hidden: return NSSize(width: 280, height: 40)
+    }
+  }
+
+  private func position(state: RagImeAssistantSurfaceState, anchor: NSPoint?) {
+    let start = CFAbsoluteTimeGetCurrent()
+    let resolved: (NSPoint, String)?
+    if let anchor {
+      lastReliableCaretAnchor = anchor
+      resolved = (anchor, "caret")
+    } else if state.isExplicit, let lastReliableCaretAnchor {
+      resolved = (lastReliableCaretAnchor, "last_reliable_caret")
+    } else if state.isExplicit {
+      let mouse = NSEvent.mouseLocation
+      if NSScreen.screens.contains(where: { $0.visibleFrame.contains(mouse) }) {
+        resolved = (mouse, "mouse")
+      } else if let screen = NSScreen.main?.visibleFrame {
+        resolved = (NSPoint(x: screen.midX, y: screen.midY), "screen_center")
+      } else { resolved = nil }
+    } else { resolved = nil }
+    guard let (point, source) = resolved else { return }
+    if let lastPositionedAnchor,
+      abs(lastPositionedAnchor.x - point.x) <= 8,
+      abs(lastPositionedAnchor.y - point.y) <= 8,
+      panel.isVisible { return }
+    lastPositionedAnchor = point
+    guard let screen = (NSScreen.screens.first { $0.visibleFrame.contains(point) } ?? NSScreen.main)?.visibleFrame else { return }
+    let size = panel.frame.size
+    var origin = NSPoint(x: point.x, y: point.y - size.height - 6)
+    if origin.y < screen.minY + 8 { origin.y = point.y + 22 }
+    origin.x = min(max(origin.x, screen.minX + 8), screen.maxX - size.width - 8)
+    origin.y = min(max(origin.y, screen.minY + 8), screen.maxY - size.height - 8)
+    panel.setFrameOrigin(origin)
+    trace("assistant_panel_positioned", [
+      "surfaceState": state.rawValue,
+      "anchorSource": source,
+      "positionDurationMs": (CFAbsoluteTimeGetCurrent() - start) * 1000,
+    ])
+  }
+
+  private func handle(_ action: RagImeAssistantAction) {
+    switch action {
+    case .insert, .replace:
+      guard let payload = currentPayload,
+        let index = payload.candidates.firstIndex(where: RagImeSuggestionCardView.isRealCandidate) else { return }
+      onSelect?(payload.candidates[index], index)
+    case .more(let sourceView): showMoreMenu(relativeTo: sourceView)
+    default: onAction?(action)
+    }
+  }
+
+  private func showMoreMenu(relativeTo sourceView: NSView) {
+    let menu = NSMenu()
+    let copy = NSMenuItem(title: "复制", action: #selector(copyResult), keyEquivalent: "")
+    copy.target = self
+    menu.addItem(copy)
+    let evidence = NSMenuItem(title: "查看依据", action: #selector(copyEvidence), keyEquivalent: "")
+    evidence.target = self
+    menu.addItem(evidence)
+    menu.addItem(.separator())
+    for title in ["记住", "不再推荐"] {
+      let item = NSMenuItem(title: title, action: nil, keyEquivalent: "")
+      item.isEnabled = false
+      menu.addItem(item)
+    }
+    menu.popUp(positioning: nil, at: NSPoint(x: 0, y: sourceView.bounds.height), in: sourceView)
+  }
+
+  @objc private func copyResult() {
+    guard let candidate = currentPayload?.candidates.first(where: RagImeSuggestionCardView.isRealCandidate) else { return }
+    NSPasteboard.general.clearContents()
+    NSPasteboard.general.setString(candidate.text.isEmpty ? candidate.insertText : candidate.text, forType: .string)
+  }
+
+  @objc private func copyEvidence() {
+    guard let evidence = currentPayload?.candidates.first(where: RagImeSuggestionCardView.isRealCandidate)?.evidencePreview,
+      !evidence.isEmpty else { return }
+    NSPasteboard.general.clearContents()
+    NSPasteboard.general.setString(evidence, forType: .string)
+  }
+
+  private func traceCreationIfNeeded() {
+    guard !didTraceCreation else { return }
+    didTraceCreation = true
+    trace("assistant_panel_created", ["createCount": 1])
+  }
+
+  private func trace(_ event: String, _ fields: [String: Any]) { onTrace?(event, fields) }
+}
diff --git a/sources/RagImeSelectedTextProvider.swift b/sources/RagImeSelectedTextProvider.swift
new file mode 100644
index 0000000..df9eb69
--- /dev/null
+++ b/sources/RagImeSelectedTextProvider.swift
@@ -0,0 +1,476 @@
+//
+//  RagImeSelectedTextProvider.swift
+//  Squirrel
+//
+
+import AppKit
+import ApplicationServices
+import CryptoKit
+import Foundation
+import InputMethodKit
+
+struct RagImeSelectedTextCapture {
+  let selectedText: String
+  let selectedTextHash: String
+  let selectedTextChars: Int
+  let selectedTextPreview: String
+  let surroundingBefore: String
+  let surroundingAfter: String
+  let canReplaceSelection: Bool
+  let captureEpoch: Int
+  let captureSource: String
+}
+
+struct RagImeForegroundTextCaptureResult {
+  let snapshot: RagImeForegroundTextSnapshot?
+  let failureReason: String
+}
+
+final class RagImeForegroundContextResolver {
+  private let accessibilityProvider = RagImeSelectedTextProvider()
+
+  func captureFromTextInputClient(
+    _ client: IMKTextInput?,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80
+  ) -> RagImeForegroundTextCaptureResult {
+    guard let client else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "text_input_client_missing")
+    }
+    let selectedRange = client.selectedRange()
+    guard selectedRange.location != NSNotFound, selectedRange.location >= 0, selectedRange.length >= 0 else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "selected_range_invalid")
+    }
+    let beforeLength = min(max(0, selectedRange.location), max(0, beforeLimit))
+    let beforeRange = NSRange(location: max(0, selectedRange.location - beforeLength), length: beforeLength)
+    guard let beforeValue = client.attributedSubstring(from: beforeRange)?.string else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "attributed_substring_unavailable")
+    }
+    let selectedText = selectedRange.length > 0
+      ? (client.attributedSubstring(from: selectedRange)?.string ?? "")
+      : ""
+    let afterRange = NSRange(location: selectedRange.location + selectedRange.length, length: max(0, afterLimit))
+    let afterText = client.attributedSubstring(from: afterRange)?.string ?? ""
+    let before = beforeValue.trimmingCharacters(in: .whitespacesAndNewlines)
+    let selected = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    let after = afterText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !before.isEmpty || !selected.isEmpty || !after.isEmpty else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "attributed_substring_empty")
+    }
+    let capturedAtMs = Int(Date().timeIntervalSince1970 * 1000)
+    let group = accessibilityProvider.resolveContextGroupIdentity(sourceAppBundleId: sourceAppBundleId)
+    return RagImeForegroundTextCaptureResult(
+      snapshot: RagImeForegroundTextSnapshot(
+        available: true,
+        source: "text_input_client",
+        confidence: 0.92,
+        freshnessMs: 0,
+        selectedTextHash: selected.isEmpty ? "" : ragImeStableTextHash(selected),
+        selectedTextChars: selected.count,
+        selectedTextPreview: String(selected.prefix(48)),
+        surroundingBefore: before,
+        surroundingAfter: after,
+        wholeValueHash: "",
+        wholeValueChars: 0,
+        canReplaceSelection: !selected.isEmpty,
+        captureEpoch: captureEpoch,
+        capturedAtMs: capturedAtMs,
+        sourceAppBundleId: sourceAppBundleId,
+        inputSourceId: inputSourceId,
+        captureFailureReason: "",
+        warnings: ["text_input_client_ok"],
+        snapshotId: "ctx_\(UUID().uuidString)",
+        contextGroupId: group.id,
+        contextGroupLevel: group.level,
+        contextGroupConfidence: group.confidence,
+        commitTextMatched: false
+      ),
+      failureReason: ""
+    )
+  }
+
+  func captureFromAccessibility(
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80
+  ) -> RagImeForegroundTextCaptureResult {
+    accessibilityProvider.resolveForegroundTextForSidecar(
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit,
+      allowAccessibility: true
+    )
+  }
+}
+
+final class RagImeSelectedTextProvider {
+  func captureForegroundTextForSidecar(
+    captureEpoch: Int,
+    sourceAppBundleId: String = "",
+    inputSourceId: String = "",
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80,
+    allowAccessibility: Bool = true
+  ) -> RagImeForegroundTextSnapshot? {
+    resolveForegroundTextForSidecar(
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit,
+      allowAccessibility: allowAccessibility
+    ).snapshot
+  }
+
+  func resolveForegroundTextForSidecar(
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80,
+    allowAccessibility: Bool = true
+  ) -> RagImeForegroundTextCaptureResult {
+    guard allowAccessibility else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "accessibility_disabled")
+    }
+    guard let focused = focusedTextElement() else {
+      let reason = AXIsProcessTrusted() ? "ax_focused_element_missing" : "ax_not_trusted"
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: reason)
+    }
+    let selectedRange = selectedTextRange(in: focused)
+    if let range = selectedRange,
+       let snapshot = foregroundSnapshotFromStringForRange(
+        focused,
+        selectedRange: range,
+        captureEpoch: captureEpoch,
+        sourceAppBundleId: sourceAppBundleId,
+        inputSourceId: inputSourceId,
+        beforeLimit: beforeLimit,
+        afterLimit: afterLimit
+       ) {
+      return RagImeForegroundTextCaptureResult(snapshot: snapshot, failureReason: "")
+    }
+    if let snapshot = foregroundSnapshotFromWholeValue(
+      focused,
+      selectedRange: selectedRange,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit
+    ) {
+      return RagImeForegroundTextCaptureResult(snapshot: snapshot, failureReason: "")
+    }
+    let reason = selectedRange == nil ? "ax_selected_range_unavailable" : "ax_string_for_range_failed"
+    return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: reason)
+  }
+
+  func captureSelectedTextForActiveRag(
+    captureEpoch: Int,
+    allowAccessibility: Bool = true,
+    allowClipboardFallback: Bool = true
+  ) -> RagImeSelectedTextCapture? {
+    if allowAccessibility, let axCapture = captureSelectedTextViaAccessibility(captureEpoch: captureEpoch) {
+      return axCapture
+    }
+    guard allowClipboardFallback else { return nil }
+    return captureSelectedTextViaClipboardFallbackPreservingPasteboard(captureEpoch: captureEpoch)
+  }
+
+  private func captureSelectedTextViaAccessibility(captureEpoch: Int) -> RagImeSelectedTextCapture? {
+    guard let focused = focusedTextElement() else { return nil }
+    var selectedObject: AnyObject?
+    let selectedResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXSelectedTextAttribute as CFString,
+      &selectedObject
+    )
+    guard selectedResult == .success, let selectedText = selectedObject as? String else {
+      return nil
+    }
+    return makeCapture(
+      selectedText: selectedText,
+      surroundingBefore: "",
+      surroundingAfter: "",
+      canReplaceSelection: true,
+      captureEpoch: captureEpoch,
+      captureSource: "accessibility_selected_text"
+    )
+  }
+
+  private func focusedTextElement() -> AXUIElement? {
+    let systemWide = AXUIElementCreateSystemWide()
+    var focusedObject: AnyObject?
+    let focusedResult = AXUIElementCopyAttributeValue(
+      systemWide,
+      kAXFocusedUIElementAttribute as CFString,
+      &focusedObject
+    )
+    guard focusedResult == .success, let focused = focusedObject else {
+      return nil
+    }
+    return (focused as! AXUIElement)
+  }
+
+  private func selectedTextRange(in focused: AXUIElement) -> CFRange? {
+    var rangeObject: AnyObject?
+    let rangeResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXSelectedTextRangeAttribute as CFString,
+      &rangeObject
+    )
+    guard rangeResult == .success, let rangeObject = rangeObject else {
+      return nil
+    }
+    let rangeValue = rangeObject as! AXValue
+    var range = CFRange(location: 0, length: 0)
+    guard AXValueGetValue(rangeValue, .cfRange, &range), range.location != kCFNotFound else {
+      return nil
+    }
+    return range
+  }
+
+  private func foregroundSnapshotFromStringForRange(
+    _ focused: AXUIElement,
+    selectedRange: CFRange,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int,
+    afterLimit: Int
+  ) -> RagImeForegroundTextSnapshot? {
+    let cursorStart = max(0, selectedRange.location)
+    let selectedLength = max(0, selectedRange.length)
+    let beforeStart = max(0, cursorStart - max(0, beforeLimit))
+    let beforeLength = max(0, cursorStart - beforeStart)
+    let afterStart = max(0, cursorStart + selectedLength)
+    guard let before = accessibilityString(for: CFRange(location: beforeStart, length: beforeLength), in: focused) else {
+      return nil
+    }
+    let selectedText = selectedLength > 0
+      ? (accessibilityString(for: CFRange(location: cursorStart, length: selectedLength), in: focused) ?? "")
+      : ""
+    let after = accessibilityString(for: CFRange(location: afterStart, length: max(0, afterLimit)), in: focused) ?? ""
+    return makeForegroundSnapshot(
+      surroundingBefore: before,
+      surroundingAfter: after,
+      selectedText: selectedText,
+      wholeValue: "",
+      confidence: 0.86,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      warnings: ["string_for_range"]
+    )
+  }
+
+  private func foregroundSnapshotFromWholeValue(
+    _ focused: AXUIElement,
+    selectedRange: CFRange?,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int,
+    afterLimit: Int
+  ) -> RagImeForegroundTextSnapshot? {
+    guard let value = accessibilityValueString(in: focused), !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+      return nil
+    }
+    let whole = value as NSString
+    let location = min(max(0, selectedRange?.location ?? whole.length), whole.length)
+    let selectedLength = min(max(0, selectedRange?.length ?? 0), max(0, whole.length - location))
+    let beforeStart = max(0, location - max(0, beforeLimit))
+    let before = whole.substring(with: NSRange(location: beforeStart, length: location - beforeStart))
+    let selectedText = selectedLength > 0
+      ? whole.substring(with: NSRange(location: location, length: selectedLength))
+      : ""
+    let afterStart = min(whole.length, location + selectedLength)
+    let afterLength = min(max(0, afterLimit), max(0, whole.length - afterStart))
+    let after = whole.substring(with: NSRange(location: afterStart, length: afterLength))
+    var warnings = ["ax_value_fallback"]
+    if selectedRange == nil {
+      warnings.append("selected_range_unavailable")
+    }
+    return makeForegroundSnapshot(
+      surroundingBefore: before,
+      surroundingAfter: after,
+      selectedText: selectedText,
+      wholeValue: value,
+      confidence: selectedRange == nil ? 0.62 : 0.72,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      warnings: warnings
+    )
+  }
+
+  private func accessibilityString(for range: CFRange, in focused: AXUIElement) -> String? {
+    guard range.location >= 0, range.length > 0 else { return "" }
+    var mutableRange = range
+    guard let rangeValue = AXValueCreate(.cfRange, &mutableRange) else { return nil }
+    var textObject: AnyObject?
+    let textResult = AXUIElementCopyParameterizedAttributeValue(
+      focused,
+      kAXStringForRangeParameterizedAttribute as CFString,
+      rangeValue,
+      &textObject
+    )
+    guard textResult == .success else { return nil }
+    return textObject as? String
+  }
+
+  private func accessibilityValueString(in focused: AXUIElement) -> String? {
+    var valueObject: AnyObject?
+    let valueResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXValueAttribute as CFString,
+      &valueObject
+    )
+    guard valueResult == .success else { return nil }
+    return valueObject as? String
+  }
+
+  private func makeForegroundSnapshot(
+    surroundingBefore: String,
+    surroundingAfter: String,
+    selectedText: String,
+    wholeValue: String,
+    confidence: Double,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    warnings: [String]
+  ) -> RagImeForegroundTextSnapshot? {
+    let compactBefore = surroundingBefore.trimmingCharacters(in: .whitespacesAndNewlines)
+    let compactAfter = surroundingAfter.trimmingCharacters(in: .whitespacesAndNewlines)
+    let compactSelected = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !compactBefore.isEmpty || !compactAfter.isEmpty || !compactSelected.isEmpty else { return nil }
+    let group = resolveContextGroupIdentity(sourceAppBundleId: sourceAppBundleId)
+    return RagImeForegroundTextSnapshot(
+      available: true,
+      source: "accessibility",
+      confidence: confidence,
+      freshnessMs: 0,
+      selectedTextHash: compactSelected.isEmpty ? "" : ragImeStableTextHash(compactSelected),
+      selectedTextChars: compactSelected.count,
+      selectedTextPreview: String(compactSelected.prefix(48)),
+      surroundingBefore: compactBefore,
+      surroundingAfter: compactAfter,
+      wholeValueHash: wholeValue.isEmpty ? "" : ragImeStableTextHash(wholeValue),
+      wholeValueChars: wholeValue.count,
+      canReplaceSelection: !compactSelected.isEmpty,
+      captureEpoch: captureEpoch,
+      capturedAtMs: Int(Date().timeIntervalSince1970 * 1000),
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      captureFailureReason: "",
+      warnings: warnings,
+      snapshotId: "ctx_\(UUID().uuidString)",
+      contextGroupId: group.id,
+      contextGroupLevel: group.level,
+      contextGroupConfidence: group.confidence,
+      commitTextMatched: false
+    )
+  }
+
+  func resolveContextGroupIdentity(sourceAppBundleId: String) -> (id: String, level: String, confidence: Double) {
+    guard let focused = focusedTextElement() else {
+      return (ragImeContextGroupId(prefix: "app", values: [sourceAppBundleId]), "app", 0.5)
+    }
+    if let document = accessibilityStringAttribute(kAXDocumentAttribute as CFString, element: focused), !document.isEmpty {
+      return (ragImeContextGroupId(prefix: "doc", values: [sourceAppBundleId, document]), "document", 1.0)
+    }
+    var windowObject: AnyObject?
+    if AXUIElementCopyAttributeValue(focused, kAXWindowAttribute as CFString, &windowObject) == .success,
+       let windowObject {
+      let window = windowObject as! AXUIElement
+      if let title = accessibilityStringAttribute(kAXTitleAttribute as CFString, element: window), !title.isEmpty {
+        return (ragImeContextGroupId(prefix: "doc", values: [sourceAppBundleId, title]), "document", 0.85)
+      }
+    }
+    return (ragImeContextGroupId(prefix: "app", values: [sourceAppBundleId]), "app", 0.5)
+  }
+
+  private func accessibilityStringAttribute(_ attribute: CFString, element: AXUIElement) -> String? {
+    var value: AnyObject?
+    guard AXUIElementCopyAttributeValue(element, attribute, &value) == .success else { return nil }
+    return value as? String
+  }
+
+  private func captureSelectedTextViaClipboardFallbackPreservingPasteboard(captureEpoch: Int) -> RagImeSelectedTextCapture? {
+    let pasteboard = NSPasteboard.general
+    let previousChangeCount = pasteboard.changeCount
+    let previousItems = pasteboard.pasteboardItems ?? []
+    sendCopyShortcutForActiveRagSelection()
+    Thread.sleep(forTimeInterval: 0.08)
+    let selectedText = pasteboard.string(forType: .string) ?? ""
+    restorePasteboardItems(previousItems, previousChangeCount: previousChangeCount)
+    return makeCapture(
+      selectedText: selectedText,
+      surroundingBefore: "",
+      surroundingAfter: "",
+      canReplaceSelection: !selectedText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+      captureEpoch: captureEpoch,
+      captureSource: "clipboard_fallback_restored"
+    )
+  }
+
+  private func sendCopyShortcutForActiveRagSelection() {
+    let source = CGEventSource(stateID: .combinedSessionState)
+    let keyDown = CGEvent(keyboardEventSource: source, virtualKey: 8, keyDown: true)
+    let keyUp = CGEvent(keyboardEventSource: source, virtualKey: 8, keyDown: false)
+    keyDown?.flags = .maskCommand
+    keyUp?.flags = .maskCommand
+    keyDown?.post(tap: .cghidEventTap)
+    keyUp?.post(tap: .cghidEventTap)
+  }
+
+  private func restorePasteboardItems(_ items: [NSPasteboardItem], previousChangeCount: Int) {
+    let pasteboard = NSPasteboard.general
+    pasteboard.clearContents()
+    if !items.isEmpty {
+      pasteboard.writeObjects(items)
+    }
+    traceRagImeSelectedTextProviderContract("clipboard_fallback_restores_clipboard_contract", previousChangeCount: previousChangeCount)
+  }
+
+  private func makeCapture(
+    selectedText: String,
+    surroundingBefore: String,
+    surroundingAfter: String,
+    canReplaceSelection: Bool,
+    captureEpoch: Int,
+    captureSource: String
+  ) -> RagImeSelectedTextCapture? {
+    let compact = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !compact.isEmpty else { return nil }
+    return RagImeSelectedTextCapture(
+      selectedText: compact,
+      selectedTextHash: ragImeStableTextHash(compact),
+      selectedTextChars: compact.count,
+      selectedTextPreview: String(compact.prefix(48)),
+      surroundingBefore: surroundingBefore,
+      surroundingAfter: surroundingAfter,
+      canReplaceSelection: canReplaceSelection,
+      captureEpoch: captureEpoch,
+      captureSource: captureSource
+    )
+  }
+}
+
+func traceRagImeSelectedTextProviderContract(_ event: String, previousChangeCount: Int) {
+  _ = event
+  _ = previousChangeCount
+}
+
+private func ragImeContextGroupId(prefix: String, values: [String]) -> String {
+  let material = values.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.joined(separator: "\u{001f}")
+  return "\(prefix):\(ragImeStableTextHash(material).prefix(16))"
+}
diff --git a/sources/RagImeSidecarClient.swift b/sources/RagImeSidecarClient.swift
new file mode 100644
index 0000000..bed7543
--- /dev/null
+++ b/sources/RagImeSidecarClient.swift
@@ -0,0 +1,437 @@
+//
+//  RagImeSidecarClient.swift
+//  Squirrel
+//
+
+import CryptoKit
+import Foundation
+
+struct RagImeSidecarClient {
+  private static let healthLock = NSLock()
+  private static var disabledUntil = Date.distantPast
+  private static var consecutiveFailures = 0
+
+  let pythonExecutable: String
+  let repoRoot: String
+  let dbPath: String
+  let project: String
+  let maxVisibleCandidates: Int
+  let maxSideCandidates: Int
+  let latencyBudgetMs: Int
+  let debounceMs: Int
+  let timeoutSeconds: TimeInterval
+  let sidecarURL: URL?
+  let frontendTrace: Bool
+
+  init?(config: SquirrelConfig?) {
+    guard config?.getBool("rag_ime/enabled") == true else { return nil }
+    let repoRoot = Self.trimmed(config?.getString("rag_ime/repo_root"))
+    guard !repoRoot.isEmpty else {
+      print("RAG IME sidecar disabled: rag_ime/repo_root is empty")
+      return nil
+    }
+    let configuredPython = Self.trimmed(config?.getString("rag_ime/python"))
+    let configuredDbPath = Self.trimmed(config?.getString("rag_ime/db_path"))
+    let configuredProject = Self.trimmed(config?.getString("rag_ime/project"))
+    let configuredSidecarURL = Self.trimmed(config?.getString("rag_ime/sidecar_url"))
+
+    self.pythonExecutable = configuredPython.isEmpty ? "/usr/bin/python3" : configuredPython
+    self.repoRoot = repoRoot
+    self.dbPath = configuredDbPath.isEmpty ? "\(repoRoot)/.rag-ime-data/rag-ime.sqlite" : configuredDbPath
+    self.project = configuredProject.isEmpty ? "wisdom-weasel-rag-ime" : configuredProject
+    self.maxVisibleCandidates = Self.intConfig(config, "rag_ime/max_visible_candidates", fallback: 8, range: 1...10)
+    self.maxSideCandidates = Self.intConfig(config, "rag_ime/max_side_candidates", fallback: 5, range: 0...10)
+    self.latencyBudgetMs = Self.intConfig(config, "rag_ime/latency_budget_ms", fallback: 900, range: 30...3000)
+    self.debounceMs = Self.intConfig(config, "rag_ime/debounce_ms", fallback: 80, range: 0...500)
+    self.timeoutSeconds = TimeInterval(Self.intConfig(config, "rag_ime/timeout_ms", fallback: 1200, range: 30...3000)) / 1000
+    self.sidecarURL = configuredSidecarURL.isEmpty ? nil : URL(string: configuredSidecarURL)
+    self.frontendTrace = config?.getBool("rag_ime/frontend_trace") == true
+  }
+
+  func request(_ request: RagImeSidecarRequest) throws -> RagImeSidecarResponse {
+    if let remainingMs = Self.sidecarCooldownRemainingMs(), remainingMs > 0 {
+      throw RagImeSidecarError.circuitOpen(remainingMs)
+    }
+    guard let sidecarURL else {
+      throw RagImeSidecarError.transport("sidecar_url missing; passive input path does not run CLI fallback")
+    }
+    do {
+      let outputData = try postJSON(request, to: endpoint("rime-suggest", base: sidecarURL))
+      Self.recordSidecarSuccess()
+      return try JSONDecoder().decode(RagImeSidecarResponse.self, from: outputData)
+    } catch {
+      let cooldownMs = Self.recordSidecarFailure()
+      print("RAG IME sidecar HTTP request failed; passive CLI fallback disabled; cooldownMs=\(cooldownMs): \(error)")
+      throw error
+    }
+  }
+
