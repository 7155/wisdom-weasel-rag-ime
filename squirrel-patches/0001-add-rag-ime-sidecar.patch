+    let payload = RagImeAssistantOverlayPayload(
+      schemaVersion: "rag-ime.assistant-overlay.v1",
+      visible: true,
+      uiMode: "active_rag_thinking",
+      phase: "active_rag",
+      inputMode: "active_rag_assist",
+      statusText: "正在生成...",
+      animation: RagImeAssistantOverlayAnimation(kind: "thinking_dots", frame: 0),
+      candidates: [],
+      sourceCards: [],
+      snapshotId: request.sessionId,
+      sessionFingerprint: "",
+      expiresAfterMs: max(15000, request.latencyBudgetMs + 3000),
+      keyPolicy: RagImeKeyPolicyPayload(
+        numberKeys: "pass_through",
+        tab: "accept_top_when_ready",
+        optionNumber: "select_candidate_by_ordinal",
+        escape: "dismiss_prediction"
+      ),
+      overlayConfig: nil,
+      progressive: nil,
+      frontendTransaction: [
