+      "selectionEpoch": response.selectionEpoch,
+      "panelSessionId": response.panelSessionId,
+      "frontAppBundleId": response.frontAppBundleId,
+      "candidateCount": response.candidateCount,
+      "uiMode": response.uiMode,
+      "overlay": true,
+      "traceIncludesText": false,
+    ])
+  }
