+  func ragImeDisplayTraceTransactionFields() -> [String: Any] {
+    guard let candidate = ragImeDisplayCandidates.first(where: { $0.sourceType != "status" }) ?? ragImeDisplayCandidates.first else {
+      return [:]
+    }
+    var fields: [String: Any] = [:]
+    let frontendRevision = ragImeDisplayCandidateIntMetadata(candidate, "frontendRevision")
+    if frontendRevision >= 0 {
+      fields["frontendRevision"] = frontendRevision
+    }
+    let selectionEpoch = ragImeDisplayCandidateIntMetadata(candidate, "selectionEpoch")
+    if selectionEpoch >= 0 {
+      fields["selectionEpoch"] = selectionEpoch
+    }
+    let panelSessionId = ragImeDisplayCandidateStringMetadata(candidate, "panelSessionId")
+    if !panelSessionId.isEmpty {
+      fields["panelSessionId"] = panelSessionId
+    }
+    let compositionHash = ragImeDisplayCandidateStringMetadata(candidate, "compositionHash")
+    if !compositionHash.isEmpty {
+      fields["compositionHash"] = compositionHash
+    }
+    let committedContextHash = ragImeDisplayCandidateStringMetadata(candidate, "committedContextHash")
+    if !committedContextHash.isEmpty {
+      fields["committedContextHash"] = committedContextHash
+    }
+    return fields
+  }
