diff --git a/sources/RagImeSidecarClient.swift b/sources/RagImeSidecarClient.swift
new file mode 100644
index 0000000..8ca780a
--- /dev/null
+++ b/sources/RagImeSidecarClient.swift
@@ -0,0 +1,326 @@
+//
+//  RagImeSidecarClient.swift
+//  Squirrel
+//
+
+import Foundation
+
+struct RagImeSidecarClient {
+  let pythonExecutable: String
+  let repoRoot: String
+  let dbPath: String
+  let project: String
+  let maxVisibleCandidates: Int
+  let maxSideCandidates: Int
+  let latencyBudgetMs: Int
+  let debounceMs: Int
+  let timeoutSeconds: TimeInterval
+  let sidecarURL: URL?
+
+  init?(config: SquirrelConfig?) {
+    guard config?.getBool("rag_ime/enabled") == true else { return nil }
+    let repoRoot = Self.trimmed(config?.getString("rag_ime/repo_root"))
+    guard !repoRoot.isEmpty else {
+      print("RAG IME sidecar disabled: rag_ime/repo_root is empty")
+      return nil
+    }
+    let configuredPython = Self.trimmed(config?.getString("rag_ime/python"))
+    let configuredDbPath = Self.trimmed(config?.getString("rag_ime/db_path"))
+    let configuredProject = Self.trimmed(config?.getString("rag_ime/project"))
+    let configuredSidecarURL = Self.trimmed(config?.getString("rag_ime/sidecar_url"))
+
+    self.pythonExecutable = configuredPython.isEmpty ? "/usr/bin/python3" : configuredPython
+    self.repoRoot = repoRoot
+    self.dbPath = configuredDbPath.isEmpty ? "\(repoRoot)/.rag-ime-data/rag-ime.sqlite" : configuredDbPath
+    self.project = configuredProject.isEmpty ? "wisdom-weasel-rag-ime" : configuredProject
+    self.maxVisibleCandidates = Self.intConfig(config, "rag_ime/max_visible_candidates", fallback: 8, range: 1...10)
+    self.maxSideCandidates = Self.intConfig(config, "rag_ime/max_side_candidates", fallback: 8, range: 0...10)
+    self.latencyBudgetMs = Self.intConfig(config, "rag_ime/latency_budget_ms", fallback: 180, range: 30...2000)
+    self.debounceMs = Self.intConfig(config, "rag_ime/debounce_ms", fallback: 40, range: 0...500)
+    self.timeoutSeconds = TimeInterval(Self.intConfig(config, "rag_ime/timeout_ms", fallback: 1200, range: 100...5000)) / 1000
+    self.sidecarURL = configuredSidecarURL.isEmpty ? nil : URL(string: configuredSidecarURL)
+  }
+
+  func request(_ request: RagImeSidecarRequest) throws -> RagImeSidecarResponse {
+    if let sidecarURL {
+      do {
+        let outputData = try postJSON(request, to: endpoint("rime-suggest", base: sidecarURL))
+        return try JSONDecoder().decode(RagImeSidecarResponse.self, from: outputData)
+      } catch {
+        print("RAG IME sidecar HTTP request failed, falling back to CLI: \(error)")
+      }
+    }
+
+    let requestFile = FileManager.default.temporaryDirectory
+      .appendingPathComponent("rag-ime-\(request.sessionId)-\(request.requestSeq).json")
+    let requestData = try JSONEncoder().encode(request)
+    try requestData.write(to: requestFile, options: .atomic)
+    defer { try? FileManager.default.removeItem(at: requestFile) }
+
+    let outputData = try runCli([
+      "rime-suggest-json",
+      "--payload-file",
+      requestFile.path,
+    ])
+    return try JSONDecoder().decode(RagImeSidecarResponse.self, from: outputData)
+  }
+
+  func recordSideCandidateCommit(
+    _ candidate: RagImeDisplayCandidate,
+    query: String,
+    recentContext: String,
+    preedit: String
+  ) throws {
+    let insertText = candidate.insertText.isEmpty ? candidate.text : candidate.insertText
+    guard !Self.trimmed(insertText).isEmpty else { return }
+    let selectionPayload = RagImeSelectionPayload(
+      candidate: candidate,
+      query: query,
+      recentContext: recentContext,
+      committedContext: recentContext,
+      preedit: preedit,
+      project: project,
+      source: "squirrel_rime_sidecar",
+      app: "squirrel"
+    )
+    if let sidecarURL {
+      do {
+        _ = try postJSON(selectionPayload, to: endpoint("rime-select", base: sidecarURL))
+        return
+      } catch {
+        print("RAG IME rime-select failed, falling back to legacy commit/action: \(error)")
+      }
+    } else {
+      do {
+        let requestFile = FileManager.default.temporaryDirectory
+          .appendingPathComponent("rag-ime-selection-\(UUID().uuidString).json")
+        let requestData = try JSONEncoder().encode(selectionPayload)
+        try requestData.write(to: requestFile, options: .atomic)
+        defer { try? FileManager.default.removeItem(at: requestFile) }
+        _ = try runCli([
+          "rime-select-json",
+          "--payload-file",
+          requestFile.path,
+        ])
+        return
+      } catch {
+        print("RAG IME rime-select CLI failed, falling back to legacy commit/action: \(error)")
+      }
+    }
+    try recordSideCandidateCommitLegacy(
+      candidate,
+      insertText: insertText,
+      query: query,
+      recentContext: recentContext,
+      preedit: preedit
+    )
+  }
+
+  func recordSideCandidateCommitLegacy(
+    _ candidate: RagImeDisplayCandidate,
+    insertText: String,
+    query: String,
+    recentContext: String,
+    preedit: String
+  ) throws {
+    let commitPayload = RagImeCommitPayload(
+      text: insertText,
+      recentContext: recentContext,
+      preedit: preedit,
+      project: project,
+      source: "squirrel_rime_sidecar",
+      tags: ["squirrel", "rime-sidecar"]
+    )
+    if let sidecarURL {
+      _ = try postJSON(commitPayload, to: endpoint("commit", base: sidecarURL))
+    } else {
+      _ = try runCli([
+        "commit",
+        insertText,
+        "--recent-context",
+        recentContext,
+        "--preedit",
+        preedit,
+        "--source",
+        "squirrel_rime_sidecar",
+        "--project",
+        project,
+        "--tag",
+        "squirrel",
+        "--tag",
+        "rime-sidecar",
+      ])
+    }
+
+    guard candidate.sourceType == "rag",
+          !candidate.memoryId.isEmpty,
+          !candidate.suggestionId.isEmpty,
+          let sourceEventId = candidate.sourceEventId else {
+      return
+    }
+    let actionPayload = RagImeActionPayload(
+      actionType: "accepted",
+      memoryId: candidate.memoryId,
+      suggestionId: candidate.suggestionId,
+      sourceEventId: sourceEventId,
+      query: query,
+      surfaceText: candidate.text
+    )
+    if let sidecarURL {
+      _ = try postJSON(actionPayload, to: endpoint("action", base: sidecarURL))
+    } else {
+      _ = try runCli([
+        "action-json",
+        "accepted",
+        "--memory-id",
+        candidate.memoryId,
+        "--suggestion-id",
+        candidate.suggestionId,
+        "--source-event-id",
+        String(sourceEventId),
+        "--query",
+        query,
+        "--surface-text",
+        candidate.text,
+      ])
+    }
+  }
+}
+
+struct RagImeSelectionPayload: Encodable {
+  let candidate: RagImeDisplayCandidate
+  let query: String
+  let recentContext: String
+  let committedContext: String
+  let preedit: String
+  let project: String
+  let source: String
+  let app: String
+}
+
+struct RagImeCommitPayload: Encodable {
+  let text: String
+  let recentContext: String
+  let preedit: String
+  let project: String
+  let source: String
+  let tags: [String]
+}
+
+struct RagImeActionPayload: Encodable {
+  let actionType: String
+  let memoryId: String
+  let suggestionId: String
+  let sourceEventId: Int
+  let query: String
+  let surfaceText: String
+}
+
+enum RagImeSidecarError: Error, CustomStringConvertible {
+  case timeout
+  case failedExit(Int, String)
+  case badResponse(Int)
+  case transport(String)
+
+  var description: String {
+    switch self {
+    case .timeout:
+      return "sidecar timed out"
+    case .failedExit(let status, let stderr):
+      return "sidecar exited with \(status): \(stderr)"
+    case .badResponse(let status):
+      return "sidecar HTTP returned \(status)"
+    case .transport(let message):
+      return "sidecar HTTP transport failed: \(message)"
+    }
+  }
+}
+
+private extension RagImeSidecarClient {
+  static func trimmed(_ value: String?) -> String {
+    return value?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+  }
+
+  static func intConfig(_ config: SquirrelConfig?, _ key: String, fallback: Int, range: ClosedRange<Int>) -> Int {
+    guard let configuredValue = config?.getDouble(key) else { return fallback }
+    return min(max(Int(configuredValue), range.lowerBound), range.upperBound)
+  }
+
+  func runCli(_ cliArguments: [String]) throws -> Data {
+    let process = Process()
+    process.executableURL = URL(fileURLWithPath: pythonExecutable)
+    process.currentDirectoryURL = URL(fileURLWithPath: repoRoot)
+    process.arguments = ["-m", "rag_ime.cli", "--db-path", dbPath] + cliArguments
+    process.environment = sidecarEnvironment()
+
+    let stdout = Pipe()
+    let stderr = Pipe()
+    process.standardOutput = stdout
+    process.standardError = stderr
+
+    try process.run()
+    let deadline = Date().addingTimeInterval(timeoutSeconds)
+    while process.isRunning && Date() < deadline {
+      Thread.sleep(forTimeInterval: 0.01)
+    }
+    if process.isRunning {
+      process.terminate()
+      throw RagImeSidecarError.timeout
+    }
+    let outputData = stdout.fileHandleForReading.readDataToEndOfFile()
+    let errorData = stderr.fileHandleForReading.readDataToEndOfFile()
+    guard process.terminationStatus == 0 else {
+      let stderrText = String(data: errorData, encoding: .utf8) ?? ""
+      throw RagImeSidecarError.failedExit(Int(process.terminationStatus), stderrText)
+    }
+    return outputData
+  }
+
+  func endpoint(_ name: String, base: URL) -> URL {
+    return base.appendingPathComponent(name)
+  }
+
+  func postJSON<T: Encodable>(_ payload: T, to url: URL) throws -> Data {
+    var request = URLRequest(url: url, timeoutInterval: timeoutSeconds)
+    request.httpMethod = "POST"
+    request.setValue("application/json; charset=utf-8", forHTTPHeaderField: "Content-Type")
+    request.httpBody = try JSONEncoder().encode(payload)
+
+    let semaphore = DispatchSemaphore(value: 0)
+    var result: Result<(Data, HTTPURLResponse), Error>?
+    let task = URLSession.shared.dataTask(with: request) { data, response, error in
+      defer { semaphore.signal() }
+      if let error {
+        result = .failure(error)
+        return
+      }
+      guard let httpResponse = response as? HTTPURLResponse else {
+        result = .failure(RagImeSidecarError.transport("missing HTTP response"))
+        return
+      }
+      result = .success((data ?? Data(), httpResponse))
+    }
+    task.resume()
+    if semaphore.wait(timeout: .now() + timeoutSeconds) == .timedOut {
+      task.cancel()
+      throw RagImeSidecarError.timeout
+    }
+    let (data, response) = try result?.get() ?? (Data(), HTTPURLResponse())
+    guard (200..<300).contains(response.statusCode) else {
+      throw RagImeSidecarError.badResponse(response.statusCode)
+    }
+    return data
+  }
+
+  func sidecarEnvironment() -> [String: String] {
+    var environment = ProcessInfo.processInfo.environment
+    if let existingPythonPath = environment["PYTHONPATH"], !existingPythonPath.isEmpty {
+      environment["PYTHONPATH"] = "\(repoRoot):\(existingPythonPath)"
+    } else {
+      environment["PYTHONPATH"] = repoRoot
+    }
+    environment["RAG_IME_CORE_MODE"] = environment["RAG_IME_CORE_MODE"] ?? "local"
+    environment["RAG_IME_DB_PATH"] = dbPath
+    return environment
+  }
+}
