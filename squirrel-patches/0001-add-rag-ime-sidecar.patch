+func ragImeCompactWhitespace(_ text: String) -> String {
+  return text
+    .components(separatedBy: .whitespacesAndNewlines)
+    .filter { !$0.isEmpty }
+    .joined(separator: " ")
+}
+
+func ragImeStableTextHash(_ text: String) -> String {
+  let normalized = ragImeCompactWhitespace(text)
+  let digest = SHA256.hash(data: Data(normalized.utf8))
+  let hex = digest.map { String(format: "%02x", $0) }.joined()
+  return "sha256:" + String(hex.prefix(16))
+}
