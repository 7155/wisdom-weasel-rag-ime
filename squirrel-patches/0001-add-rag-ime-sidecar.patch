+  func ragImeDisplayPanelPayload(fallbackLabels: [String]) -> (candidates: [String], comments: [String], labels: [String]) {
+    let visibleCandidates = ragImeDisplayCandidates.filter { !ragImeDisplayCandidateIsShortcutOnlyAction($0) }
+    let candidates = visibleCandidates.map { ragImeDisplayText(for: $0) }
+    let comments = visibleCandidates.map { ragImeDisplayComment(for: $0) }
+    let labels = visibleCandidates.enumerated().map { index, candidate in
+      if candidate.sourceType == "status" || candidate.isStatus == true || candidate.selectionAction == "none" {
+        return ""
+      }
+      return candidate.label.isEmpty ? ragImeFallbackLabel(index: index, fallbackLabels: fallbackLabels) : candidate.label
+    }
+    return (candidates, comments, labels)
+  }
