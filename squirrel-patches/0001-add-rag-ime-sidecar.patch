+  func canSelectRagImeOverlayCandidate(_ candidate: RagImeDisplayCandidate) -> Bool {
+    guard candidate.selectionAction != "none", candidate.sourceType != "status", candidate.isStatus != true else { return false }
+    if let expiresAt = ragImeOverlayExpiresAt {
+      guard Date() <= expiresAt else { return false }
+    }
+    if !ragImeOverlaySessionFingerprint.isEmpty {
+      guard ragImeDisplayCandidateSessionFingerprint(candidate) == ragImeOverlaySessionFingerprint else { return false }
+    }
+    if !ragImeOverlaySnapshotId.isEmpty && !(candidate.snapshotId ?? "").isEmpty {
+      guard candidate.snapshotId == ragImeOverlaySnapshotId else { return false }
+    }
+    guard ragImeDisplayCandidateIntMetadata(candidate, "frontendRevision") == ragImeFrontendRevision else { return false }
+    guard ragImeDisplayCandidateIntMetadata(candidate, "selectionEpoch") == ragImeSelectionEpoch else { return false }
+    guard ragImeDisplayCandidateStringMetadata(candidate, "panelSessionId") == ragImeOverlayPanelSessionId else { return false }
+    let compositionHash = ragImeDisplayCandidateStringMetadata(candidate, "compositionHash")
+    if !compositionHash.isEmpty {
+      guard compositionHash == ragImeOverlayCompositionHash else { return false }
+    }
+    let committedContextHash = ragImeDisplayCandidateStringMetadata(candidate, "committedContextHash")
+    if !committedContextHash.isEmpty {
+      guard committedContextHash == ragImeOverlayCommittedContextHash else { return false }
+    }
+    return true
+  }
+
+  func commitRagImeAssistantCandidate(
+    _ candidate: RagImeDisplayCandidate,
+    route: String,
+    index: Int,
+    replaceSelection: Bool = false
+  ) -> Bool {
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return false }
+    if candidate.selectionAction == "start_agent_deep_search_from_context" {
+      return startRagImeAgentDeepSearchFromContext(actionCandidate: candidate)
+    }
+    if candidate.selectionAction == "start_active_rag_from_context" {
+      return startRagImeActiveRagAssistFromContext(actionCandidate: candidate)
+    }
+    guard candidate.selectionAction == "commit_side_candidate" else { return false }
+    let insertText = ragImeStripSourceSuffix(candidate.insertText.isEmpty ? candidate.text : candidate.insertText)
+    guard !insertText.isEmpty else { return false }
+    let recentContext = syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeOverlayPreedit)
+    traceRagImeFrontendEvent("assistant_overlay_candidate_accepted", fields: [
+      "route": route,
+      "index": index,
+      "candidate": ragImeTraceCandidateSummary(candidate, index: index),
+      "selectionEpoch": ragImeSelectionEpoch,
+      "panelSessionId": ragImeOverlayPanelSessionId,
+      "snapshotId": ragImeOverlaySnapshotId,
+      "commitMode": replaceSelection ? "replace_selection" : "insert_at_cursor",
+    ])
+    traceRagImeFrontendEvent("side_candidate_commit", fields: [
+      "index": index,
+      "candidate": ragImeTraceCandidateSummary(candidate, index: index),
+      "query": ragImeOverlaySemanticQuery,
+      "preedit": ragImeOverlayPreedit,
+      "recentContextChars": recentContext.count,
+      "overlay": true,
+    ])
+    if replaceSelection {
+      guard replaceRagImeAssistantSelection(with: insertText, candidate: candidate) else { return false }
+    } else {
+      commit(string: insertText)
+    }
+    rimeAPI.clear_composition(session)
+    recordRagImeSideCandidateCommit(
+      candidate,
+      shownCandidates: ragImeOverlayCandidates,
+      query: ragImeOverlaySemanticQuery,
+      recentContext: recentContext,
+      preedit: ragImeOverlayPreedit,
+      contextGroupId: ragImeDisplayContextGroupId,
+      contextGroupLevel: ragImeDisplayContextGroupLevel
+    ) { _ in }
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    scheduleRagImePostCommitContinuation(committedText: insertText, sourceCandidate: candidate)
+    rimeUpdate(clearReservedComments: false, requestSidecar: false)
+    showRagImeAssistantOverlayFeedback(
+      statusText: "继续联想",
+      snapshotId: "continuation:\(ragImeFrontendRevision):\(ragImeSelectionEpoch)",
+      semanticQuery: recentContext,
+      expiresAfterMs: 12_000,
+      animated: true
+    )
+    return true
+  }
+
+  func replaceRagImeAssistantSelection(with text: String, candidate: RagImeDisplayCandidate) -> Bool {
+    guard let client else { return false }
+    guard case .string(let placement)? = candidate.metadata["placement"], placement == "replace_selection" else {
+      return false
+    }
+    guard case .string(let expectedHash)? = candidate.metadata["selectedTextHash"], !expectedHash.isEmpty else {
+      return false
+    }
+    guard ragImeActiveRagFrontAppBundleId.isEmpty || ragImeActiveRagFrontAppBundleId == currentApp else {
+      traceRagImeFrontendEvent("assistant_overlay_replace_rejected", fields: ["reason": "front_app_changed"])
+      return false
+    }
+    let selectedRange = client.selectedRange()
+    guard selectedRange.location != NSNotFound, selectedRange.length > 0,
+      let selectedText = client.attributedSubstring(from: selectedRange)?.string,
+      ragImeStableTextHash(selectedText) == expectedHash else {
+      traceRagImeFrontendEvent("assistant_overlay_replace_rejected", fields: ["reason": "selection_changed"])
+      return false
+    }
+    let previousContext = syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeOverlayPreedit)
+    client.insertText(text, replacementRange: selectedRange)
+    ragImeCommittedContext = actualRagImeCommittedContextFromClient(
+      fallback: [previousContext, text].filter { !$0.isEmpty }.joined(separator: " ")
+    )
+    ragImeCommittedContextUpdatedAt = ragImeCommittedContext.isEmpty ? .distantPast : Date()
+    traceRagImeFrontendEvent("assistant_overlay_selection_replaced", fields: [
+      "selectedTextHash": expectedHash,
+      "replacementChars": text.count,
+      "traceIncludesText": false,
+    ])
+    return true
+  }
+
+  func handleRagImeAssistantAction(_ action: RagImeAssistantAction) {
+    switch action {
+    case .remember:
+      recordRagImeAssistantCandidateAction("remember")
+    case .suppress:
+      recordRagImeAssistantCandidateAction("suppress")
+    case .stop:
+      dismissRagImeAssistantOverlay(reason: "user_stop")
+    case .retry:
+      _ = startRagImeActiveRagAssistFromContext()
+    default:
+      break
+    }
+  }
+
+  func recordRagImeAssistantCandidateAction(_ action: String) {
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return }
+    guard let sidecarClient = ragImeSidecarClient,
+      let candidate = ragImeOverlayCandidates.first(where: { RagImeSuggestionCardView.isRealCandidate($0) }) else { return }
+    let candidateSummary = ragImeTraceCandidateSummary(candidate, index: 0)
+    let query = ragImeOverlaySemanticQuery
+    let app = currentApp
+    let privacyDisposition = ragImePrivacyDisposition
+    DispatchQueue.global(qos: .utility).async { [weak self] in
+      do {
+        let receipt = try sidecarClient.recordAssistantCandidateAction(
+          candidate,
+          action: action,
+          query: query,
+          app: app,
+          privacyDisposition: privacyDisposition
+        )
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("assistant_overlay_feedback_recorded", fields: [
+            "action": action,
+            "ok": receipt.ok,
+            "memoryId": receipt.memoryId ?? "",
+            "tombstoneId": receipt.tombstoneId ?? 0,
+            "candidate": candidateSummary,
+          ])
+          if receipt.ok && action == "suppress" {
+            self?.dismissRagImeAssistantOverlay(reason: "candidate_suppressed")
+          }
+        }
+      } catch {
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("assistant_overlay_feedback_failed", fields: [
+            "action": action,
+            "error": String(describing: error),
+            "candidate": candidateSummary,
+          ])
+        }
+      }
+    }
+  }
