+  func startRagImeActiveRagAssistFromShortcut() -> Bool {
+    guard requireRagImeActiveRagEnabled(trigger: "shortcut") else { return false }
+    if ragImeAssistantOverlayController.isVisible,
+      let actionIndex = ragImeOverlayCandidates.firstIndex(where: { candidate in
+        candidate.selectionAction == "start_active_rag_from_context"
+          || (candidate.sourceType == "action" && candidate.displayLane == "assistant_overlay")
+      }) {
+      let actionCandidate = ragImeOverlayCandidates[actionIndex]
+      guard canSelectRagImeOverlayCandidate(actionCandidate) else {
+        traceRagImeFrontendEvent("active_rag_shortcut_rejected", fields: [
+          "reason": "overlay_transaction_mismatch",
+          "candidate": ragImeTraceCandidateSummary(actionCandidate, index: actionIndex),
+          "selectionEpoch": ragImeSelectionEpoch,
+          "panelSessionId": ragImeOverlayPanelSessionId,
+        ])
+        dismissRagImeAssistantOverlay(reason: "stale_overlay_action")
+        return false
+      }
+      traceRagImeFrontendEvent("active_rag_shortcut_action_button_route", fields: [
+        "candidate": ragImeTraceCandidateSummary(actionCandidate, index: actionIndex),
+        "shortcut": ragImeActiveRagShortcutSetting(),
+        "selectionEpoch": ragImeSelectionEpoch,
+        "panelSessionId": ragImeOverlayPanelSessionId,
+        "overlay": true,
+      ])
+      return startRagImeActiveRagAssistFromContext(actionCandidate: actionCandidate)
+    }
+    if ragImePanelUsesDisplayCandidates,
+      let actionIndex = ragImeDisplayCandidates.firstIndex(where: { candidate in
+        candidate.selectionAction == "start_active_rag_from_context"
+          || (candidate.sourceType == "action" && candidate.displayLane == "active_rag")
+      }) {
+      guard canSelectCurrentRagImeDisplayCandidates() else {
+        traceRagImeFrontendEvent("active_rag_shortcut_rejected", fields: [
+          "reason": "display_session_not_live",
+          "selectionEpoch": ragImeSelectionEpoch,
+          "panelSessionId": ragImeDisplayPanelSessionId,
+        ])
+        clearRagImeDisplayCandidates()
+        return false
+      }
+      let actionCandidate = ragImeDisplayCandidates[actionIndex]
+      guard canSelectRagImeDisplayCandidate(actionCandidate) else {
+        traceRagImeFrontendEvent("active_rag_shortcut_rejected", fields: [
+          "reason": "transaction_mismatch",
+          "candidate": ragImeTraceCandidateSummary(actionCandidate, index: actionIndex),
+          "selectionEpoch": ragImeSelectionEpoch,
+          "panelSessionId": ragImeDisplayPanelSessionId,
+        ])
+        clearRagImeDisplayCandidates()
+        return false
+      }
+      traceRagImeFrontendEvent("active_rag_shortcut_action_button_route", fields: [
+        "candidate": ragImeTraceCandidateSummary(actionCandidate, index: actionIndex),
+        "shortcut": ragImeActiveRagShortcutSetting(),
+        "selectionEpoch": ragImeSelectionEpoch,
+        "panelSessionId": ragImeDisplayPanelSessionId,
+      ])
+      return startRagImeActiveRagAssistFromContext(actionCandidate: actionCandidate)
+    }
+    return startRagImeActiveRagAssistFromSelection()
+  }
