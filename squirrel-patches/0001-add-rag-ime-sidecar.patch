+  func recordRagImeAcceptedEditFeedbackIfNeeded() {
+    guard !ragImeNativeCompositionIsActive() else { return }
+    guard !ragImeAcceptedEditText.isEmpty,
+          Date().timeIntervalSince(ragImeAcceptedEditAt) <= 10,
+          !enforceRagImeSensitiveFieldGuard(),
+          ragImePrivacyDisposition == "allowed",
+          let sidecarClient = ragImeSidecarClient else {
+      clearRagImeAcceptedEditFeedback()
+      return
+    }
+    let currentContext = ragImeCompactWhitespace(
+      syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeDisplayPreedit)
+    )
+    guard currentContext.hasSuffix(ragImeAcceptedEditText) else {
+      clearRagImeAcceptedEditFeedback()
+      return
+    }
+    let sourceType = ragImeAcceptedEditSourceType
+    let candidateId = ragImeAcceptedEditCandidateId
+    let candidateText = ragImeAcceptedEditText
+    let preedit = ragImeAcceptedEditPreedit
+    let contextHash = ragImeAcceptedEditContextHash
+    let acceptedAtMs = Int(ragImeAcceptedEditAt.timeIntervalSince1970 * 1000)
+    let app = currentApp
+    let privacyDisposition = ragImePrivacyDisposition
+    clearRagImeAcceptedEditFeedback()
+    DispatchQueue.global(qos: .utility).async { [weak self] in
+      do {
+        let receipt = try sidecarClient.recordAcceptedCandidateBackspace(
+          sourceType: sourceType,
+          candidateId: candidateId,
+          candidateText: candidateText,
+          preedit: preedit,
+          contextHash: contextHash,
+          acceptedAtMs: acceptedAtMs,
+          app: app,
+          privacyDisposition: privacyDisposition
+        )
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("accepted_candidate_backspace_feedback_recorded", fields: [
+            "ok": receipt.ok,
+            "recorded": receipt.recorded,
+            "rimeRecorded": receipt.rimeRecorded,
+            "sourceType": sourceType,
+            "candidateTextChars": candidateText.count,
+            "traceIncludesText": false,
+          ])
+        }
+      } catch {
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("accepted_candidate_backspace_feedback_failed", fields: [
+            "sourceType": sourceType,
+            "candidateTextChars": candidateText.count,
+            "error": String(describing: error),
+            "traceIncludesText": false,
+          ])
+        }
+      }
+    }
+  }
