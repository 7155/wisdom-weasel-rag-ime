+  func currentRagImeInputAnchor() -> NSPoint? {
+    guard let client else { return nil }
+    var inputPos = NSRect()
+    client.attributes(forCharacterIndex: 0, lineHeightRectangle: &inputPos)
+    guard inputPos.width.isFinite, inputPos.height.isFinite, inputPos.origin.x.isFinite, inputPos.origin.y.isFinite else {
+      return nil
+    }
+    guard inputPos.width > 0 || inputPos.height > 0 else {
+      return nil
+    }
+    return NSPoint(x: inputPos.minX, y: inputPos.minY)
+  }
