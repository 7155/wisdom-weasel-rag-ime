+
+  func ragImeBooleanSetting(userDefaultsKey: String, environmentKey: String, defaultValue: Bool) -> Bool {
+    if let defaultsValue = UserDefaults.standard.object(forKey: userDefaultsKey) as? Bool {
+      return defaultsValue
+    }
+    let envValue = (ProcessInfo.processInfo.environment[environmentKey] ?? "").lowercased()
+    if ["1", "true", "yes", "on"].contains(envValue) { return true }
+    if ["0", "false", "no", "off"].contains(envValue) { return false }
+    return defaultValue
+  }
+
+  func ragImeShortcutKeyMatches(_ keyName: String, keyCode: UInt16) -> Bool {
+    return ragImeShortcutKeyCodes(keyName).contains(keyCode)
+  }
+
+  func ragImeShortcutKeyCodes(_ keyName: String) -> [UInt16] {
+    switch keyName.lowercased() {
+    case "r": return [15]
+    case ".", "period", "dot": return [47]
+    case "space": return [49]
+    case "return": return [36]
+    case "enter": return [36, 76]
+    default: return []
+    }
+  }
