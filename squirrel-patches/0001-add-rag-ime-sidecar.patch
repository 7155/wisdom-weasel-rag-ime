+  func ragImeDisplayBadge(for candidate: RagImeDisplayCandidate) -> String {
+    guard ragImeCandidateSourceBadgesEnabled() else {
+      return ""
+    }
+    if let badge = candidate.badge, !badge.isEmpty {
+      return badge
+    }
+    switch candidate.sourceType {
+    case "model":
+      return "模"
+    case "rag":
+      return "查"
+    case "memory":
+      return "忆"
+    case "rime":
