+    guard ragImeDisplayCandidateIntMetadata(candidate, "frontendRevision") == ragImeFrontendRevision else { return false }
+    guard ragImeDisplayCandidateIntMetadata(candidate, "selectionEpoch") == ragImeSelectionEpoch else { return false }
+    guard ragImeDisplayCandidateStringMetadata(candidate, "panelSessionId") == ragImeOverlayPanelSessionId else { return false }
+    let compositionHash = ragImeDisplayCandidateStringMetadata(candidate, "compositionHash")
+    if !compositionHash.isEmpty {
+      guard compositionHash == ragImeOverlayCompositionHash else { return false }
+    }
+    let committedContextHash = ragImeDisplayCandidateStringMetadata(candidate, "committedContextHash")
+    if !committedContextHash.isEmpty {
