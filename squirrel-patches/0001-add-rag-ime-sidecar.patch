+  func ragImeDisplayCandidateIntMetadata(_ candidate: RagImeDisplayCandidate, _ key: String) -> Int {
+    guard let value = candidate.metadata[key] else { return -1 }
+    switch value {
+    case .number(let number):
+      return Int(number)
