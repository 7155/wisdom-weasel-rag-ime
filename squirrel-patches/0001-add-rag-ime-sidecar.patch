+  func ragImeNativeSelectionSnapshot(
+    at index: Int,
+    acceptedText: String = ""
+  ) -> (preedit: String, acceptedText: String, rejectedText: String, rank: Int, shownCount: Int)? {
+    guard index >= 0, index < ragImeLatestNativeCandidates.count else { return nil }
+    let rawInput = ragImeCompactWhitespace(ragImeLatestNativeRawInput)
+    let selectedText = ragImeCompactWhitespace(
+      acceptedText.isEmpty ? ragImeLatestNativeCandidates[index] : acceptedText
+    )
+    guard !rawInput.isEmpty, !selectedText.isEmpty else { return nil }
+    let pageSize = max(1, ragImeLatestNativePageSize)
+    let rank = max(1, ragImeLatestNativePage * pageSize + index + 1)
+    let rejectedText: String
+    if ragImeLatestNativePage == 0 && index > 0 {
+      let first = ragImeCompactWhitespace(ragImeLatestNativeCandidates[0])
+      rejectedText = first == selectedText ? "" : first
+    } else {
+      rejectedText = ""
+    }
+    return (rawInput, selectedText, rejectedText, rank, ragImeLatestNativeCandidates.count)
+  }
+
+  func recordRagImeNativeSelection(
+    _ selection: (preedit: String, acceptedText: String, rejectedText: String, rank: Int, shownCount: Int)
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return }
+    guard let sidecarClient = ragImeSidecarClient else { return }
+    let selectionId = UUID().uuidString
+    let app = currentApp
+    let privacyDisposition = ragImePrivacyDisposition
+    DispatchQueue.global(qos: .utility).async { [weak self] in
+      do {
+        let receipt = try sidecarClient.recordNativeRimeSelection(
+          selectionId: selectionId,
+          preedit: selection.preedit,
+          acceptedText: selection.acceptedText,
+          rejectedText: selection.rejectedText,
+          candidateRank: selection.rank,
+          shownCandidateCount: selection.shownCount,
+          app: app,
+          privacyDisposition: privacyDisposition
+        )
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("native_rime_rank_feedback_recorded", fields: [
+            "ok": receipt.ok,
+            "recorded": receipt.recorded,
+            "eventId": receipt.eventId,
+            "action": receipt.action,
+            "candidateRank": receipt.candidateRank,
+            "preedit": selection.preedit,
+            "text": selection.acceptedText,
+          ])
+        }
+      } catch {
+        DispatchQueue.main.async {
+          self?.traceRagImeFrontendEvent("native_rime_rank_feedback_failed", fields: [
+            "error": String(describing: error),
+            "candidateRank": selection.rank,
+          ])
+        }
+      }
+    }
+  }
