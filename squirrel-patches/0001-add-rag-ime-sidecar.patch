+  func invalidateRagImeDisplayForInputChange(reason: String, keyCode: UInt16) {
+    ragImeInputGeneration += 1
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    let generation = ragImeInputGeneration
+    let frontendRevision = ragImeFrontendRevision
+    let selectionEpoch = ragImeSelectionEpoch
+    let previousCount = ragImeDisplayCandidates.count
+    clearRagImeDisplayCandidates()
+    ragImePendingRequestWorkItem?.cancel()
+    ragImePendingRequestWorkItem = nil
+    ragImePendingRequestFingerprint = ""
+    ragImeLastRequestFingerprint = ""
+    cancelRagImePendingContinuation(reason: reason, keyCode: keyCode)
+    traceRagImeFrontendEvent("display_invalidated_by_input_change", fields: [
+      "reason": reason,
+      "keyCode": Int(keyCode),
+      "inputGeneration": generation,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "previousDisplayCount": previousCount,
+    ])
+    traceRagImeFrontendEvent("frontend_transaction_invalidated", fields: [
+      "reason": reason,
+      "keyCode": Int(keyCode),
+      "inputGeneration": generation,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "previousDisplayCount": previousCount,
+    ])
+    let actual = syncRagImeCommittedContextFromClient(excludingMarkedText: "")
+    traceRagImeFrontendEvent("committed_context_resynced_after_delete", fields: [
+      "keyCode": Int(keyCode),
+      "inputGeneration": generation,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "committedContextHash": ragImeStableTextHash(actual),
+      "committedContextChars": actual.count,
+      "committedContextSuffix": String(actual.suffix(80)),
+    ])
+  }
+
+  func invalidateRagImeForegroundTransaction(reason: String, keyCode: UInt16 = 0) {
+    ragImeInputGeneration += 1
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    let previousCount = ragImeDisplayCandidates.count
+    clearRagImeDisplayCandidates()
+    ragImePendingRequestWorkItem?.cancel()
+    ragImePendingRequestWorkItem = nil
+    ragImePendingRequestFingerprint = ""
