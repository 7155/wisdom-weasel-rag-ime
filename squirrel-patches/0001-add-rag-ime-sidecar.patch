+  func clearRagImeAcceptedEditFeedback() {
+    ragImeAcceptedEditSourceType = ""
+    ragImeAcceptedEditCandidateId = ""
+    ragImeAcceptedEditText = ""
+    ragImeAcceptedEditPreedit = ""
+    ragImeAcceptedEditContextHash = ""
+    ragImeAcceptedEditAt = .distantPast
