+  func rememberRagImeAcceptedEditFeedback(
+    sourceType: String,
+    candidateId: String,
+    text: String,
+    preedit: String,
+    contextHash: String
+  ) {
+    let normalized = ragImeCompactWhitespace(text)
+    guard !normalized.isEmpty, !["status", "action"].contains(sourceType) else {
+      clearRagImeAcceptedEditFeedback()
+      return
+    }
+    ragImeAcceptedEditSourceType = sourceType
+    ragImeAcceptedEditCandidateId = candidateId.isEmpty ? "accepted:\(ragImeStableTextHash(normalized))" : candidateId
+    ragImeAcceptedEditText = normalized
+    ragImeAcceptedEditPreedit = ragImeCompactWhitespace(preedit)
+    ragImeAcceptedEditContextHash = contextHash
+    ragImeAcceptedEditAt = Date()
+  }
