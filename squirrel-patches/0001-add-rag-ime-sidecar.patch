+  private func performRagImeControlAction(_ action: String) {
+    guard let url = URL(string: "http://127.0.0.1:8766/api/runtime/action"),
+          let body = try? JSONSerialization.data(withJSONObject: ["action": action]) else { return }
+    var request = URLRequest(url: url)
+    request.httpMethod = "POST"
+    request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+    request.httpBody = body
+    URLSession.shared.dataTask(with: request).resume()
+  }
