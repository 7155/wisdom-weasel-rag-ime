+  func traceRagImeFrontendEvent(_ event: String, fields: [String: Any]) {
+    let includeText = ProcessInfo.processInfo.environment["RAG_IME_TRACE_INCLUDE_TEXT"] == "1"
+    var payload = ragImeSanitizedTraceFields(fields, includeText: includeText)
+    payload["frontendBuild"] = "rag-ime.foreground-trace.v2"
+    payload["schemaVersion"] = "rag-ime.squirrel-frontend-trace.v1"
+    payload["event"] = event
+    payload["timestampMs"] = Int(Date().timeIntervalSince1970 * 1000)
+    payload["sessionId"] = String(session)
+    payload["schemaId"] = schemaId
+    if event == "panel_display_candidates" {
+      for (key, value) in ragImeDisplayTraceTransactionFields() {
+        payload[key] = payload[key] ?? value
+      }
+    }
+    payload["frontendRevision"] = payload["frontendRevision"] ?? ragImeFrontendRevision
+    payload["selectionEpoch"] = payload["selectionEpoch"] ?? ragImeSelectionEpoch
+    payload["panelSessionId"] = payload["panelSessionId"] ?? ragImeDisplayPanelSessionId
+    payload["traceIncludesText"] = includeText
+
+    guard JSONSerialization.isValidJSONObject(payload) else { return }
+    do {
+      let logDirectory = FileManager.default.homeDirectoryForCurrentUser
+        .appendingPathComponent("Library/Logs/RagIme", isDirectory: true)
+      try FileManager.default.createDirectory(at: logDirectory, withIntermediateDirectories: true)
+      let logFile = logDirectory.appendingPathComponent("squirrel-frontend.jsonl")
+      var data = try JSONSerialization.data(withJSONObject: payload, options: [.sortedKeys])
+      data.append(0x0a)
+      if !FileManager.default.fileExists(atPath: logFile.path) {
+        FileManager.default.createFile(atPath: logFile.path, contents: nil)
+      }
+      let handle = try FileHandle(forWritingTo: logFile)
+      defer { try? handle.close() }
+      try handle.seekToEnd()
+      handle.write(data)
+    } catch {
+      print("RAG IME frontend trace failed: \(error)")
+    }
+  }
+
+  func ragImeSanitizedTraceFields(_ fields: [String: Any], includeText: Bool) -> [String: Any] {
+    var sanitized: [String: Any] = [:]
+    for (key, value) in fields {
+      sanitized[key] = ragImeSanitizedTraceValue(value, key: key, includeText: includeText)
+    }
+    return sanitized
+  }
+
+  func ragImeSanitizedTraceValue(_ value: Any, key: String, includeText: Bool) -> Any {
+    if includeText {
+      return value
+    }
+    if let text = value as? String {
+      guard ragImeTraceKeyCarriesUserText(key), !text.isEmpty else { return text }
+      return [
+        "chars": ragImeCompactWhitespace(text).count,
+        "hash": ragImeStableTextHash(text),
+      ] as [String: Any]
+    }
+    if let dictionary = value as? [String: Any] {
+      var sanitized: [String: Any] = [:]
+      for (childKey, childValue) in dictionary {
+        sanitized[childKey] = ragImeSanitizedTraceValue(childValue, key: childKey, includeText: includeText)
+      }
+      return sanitized
+    }
+    if let array = value as? [Any] {
+      return array.map { item in ragImeSanitizedTraceValue(item, key: key, includeText: includeText) }
+    }
+    return value
+  }
