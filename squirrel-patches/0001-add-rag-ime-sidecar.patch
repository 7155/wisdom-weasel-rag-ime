+  func ragImeDisplayCandidateMatchesTransaction(_ candidate: RagImeDisplayCandidate, response: RagImeSidecarResponse) -> Bool {
+    let responseSnapshotId = response.predictionSession?.snapshotId ?? response.predictionSession?.stableSnapshotId ?? ""
+    if !responseSnapshotId.isEmpty && candidate.snapshotId != responseSnapshotId {
+      return false
+    }
+    let isStatusCandidate = candidate.sourceType == "status" || candidate.isStatus == true || candidate.selectionAction == "none"
+    if let ordinal = candidate.candidateOrdinal, ordinal <= 0, !isStatusCandidate {
+      return false
+    }
+    return ragImeDisplayCandidateIntMetadata(candidate, "frontendRevision") == response.frontendRevision
+      && ragImeDisplayCandidateIntMetadata(candidate, "selectionEpoch") == response.selectionEpoch
+      && ragImeDisplayCandidateStringMetadata(candidate, "panelSessionId") == response.panelSessionId
+      && ragImeDisplayCandidateStringMetadata(candidate, "compositionHash") == response.compositionHash
+      && ragImeDisplayCandidateStringMetadata(candidate, "committedContextHash") == response.committedContextHash
+  }
