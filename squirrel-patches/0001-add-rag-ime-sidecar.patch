+      && response.selectionEpoch == request.selectionEpoch
+      && response.panelSessionId == request.panelSessionId
+      && response.frontAppBundleId == request.frontAppBundleId else {
+      traceRagImeFrontendEvent("active_rag_response_dropped_stale", fields: [
+        "reason": "active_rag_anchor_mismatch",
+        "selectedTextHash": request.selectedTextHash,
+        "frontendRevision": request.frontendRevision,
+        "selectionEpoch": request.selectionEpoch,
+        "panelSessionId": request.panelSessionId,
+        "frontAppBundleId": request.frontAppBundleId,
+      ])
+      return
+    }
+    let activeStatusText = response.candidates.first(where: { $0.sourceType == "status" || $0.isStatus == true })?.text
+    let activeOverlayCandidates = response.candidates.filter { candidate in
+      candidate.sourceType != "status" && candidate.isStatus != true
+    }
+    let activeOverlayPayload = RagImeAssistantOverlayPayload(
+      schemaVersion: "rag-ime.assistant-overlay.v1",
+      visible: response.thinkingRow || !activeOverlayCandidates.isEmpty,
+      uiMode: response.uiMode,
+      phase: "active_rag",
+      inputMode: "active_rag_assist",
+      statusText: activeStatusText ?? (response.thinkingRow ? "DeepSeek 思考中..." : "DeepSeek 已生成"),
+      animation: RagImeAssistantOverlayAnimation(kind: response.thinkingRow ? "thinking_dots" : "none", frame: max(0, response.elapsedMs ?? 0) / 250 % 3),
+      candidates: activeOverlayCandidates,
+      sourceCards: [],
+      snapshotId: response.sessionId,
+      sessionFingerprint: "",
+      expiresAfterMs: Int(ragImePostCommitDisplayHoldoverDuration * 1000),
+      keyPolicy: response.keyPolicy,
+      progressive: nil,
+      frontendTransaction: nil,
+      dismissReason: ""
+    )
+    ragImeActiveRagSelectedTextHash = response.selectedTextHash
+    ragImeActiveRagFrontAppBundleId = response.frontAppBundleId
+    ragImeActiveRagFrontendRevision = response.frontendRevision
+    ragImeActiveRagSelectionEpoch = response.selectionEpoch
+    applyRagImeAssistantOverlay(
+      activeOverlayPayload,
+      semanticQuery: request.context,
