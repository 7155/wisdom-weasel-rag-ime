+      "reason": reason,
+      "keyCode": Int(keyCode),
+      "inputGeneration": ragImeInputGeneration,
+      "frontendRevision": ragImeFrontendRevision,
+      "selectionEpoch": ragImeSelectionEpoch,
+      "previousDisplayCount": previousCount,
