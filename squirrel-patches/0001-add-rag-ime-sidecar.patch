+    guard ragImeAssistantOverlayController.isVisible else { return false }
+    guard ordinal > 0 else { return false }
+    guard let index = ragImeOverlayCandidates.firstIndex(where: { candidate in
+      candidate.candidateOrdinal == ordinal && (candidate.isSelectable ?? true)
+    }) ?? (ordinal == 1 ? ragImeOverlayCandidates.firstIndex(where: {
+      ($0.isSelectable ?? true) && $0.sourceType != "status" && $0.sourceType != "action"
+    }) : nil) else {
+      return false
+    }
+    let candidate = ragImeOverlayCandidates[index]
+    guard candidate.sourceType != "raw_english" && candidate.sourceType != "rime" && candidate.sourceType != "status" else {
+      return false
+    }
+    if route == "tab",
+      case .bool(let streamingPartial)? = candidate.metadata["streamingPartial"],
+      streamingPartial {
+      traceRagImeFrontendEvent("assistant_overlay_tab_waiting_for_result", fields: [
+        "panelSessionId": ragImeOverlayPanelSessionId,
+        "candidateCount": ragImeOverlayCandidates.count,
+        "reason": "streaming_partial",
+      ])
