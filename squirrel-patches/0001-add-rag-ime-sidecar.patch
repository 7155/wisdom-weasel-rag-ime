+      ragImeDisplayRawInput,
+      ragImeDisplayPreedit,
+      ragImeDisplaySemanticQuery,
+      ragImeDisplayQueryBasis,
+      String(ragImeDisplayUpdatedAt.timeIntervalSince1970),
+      String(ragImeDisplayCandidates.count),
+    ].joined(separator: "\u{1f}")
+  }
