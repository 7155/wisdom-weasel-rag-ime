+    traceRagImeFrontendEvent(eventName, fields: [
+      "key": key,
+      "route": route,
+      "ordinal": ordinal,
+      "index": index,
+      "candidate": ragImeTraceCandidateSummary(candidate, index: index),
+      "overlay": true,
