+  }
+
+  func actualRagImeCommittedContextFromClient(fallback: String, excludingMarkedText markedText: String = "") -> String {
+    guard let client else {
+      return boundedRagImeCommittedContext(fallback)
+    }
+    let selectedRange = client.selectedRange()
+    guard selectedRange.location != NSNotFound, selectedRange.location > 0 else {
+      return boundedRagImeCommittedContext(fallback)
+    }
+    let readLimit = ragImeCommittedContextLimit + markedText.utf16.count + 1
+    let length = min(selectedRange.location, readLimit)
+    let range = NSRange(location: selectedRange.location - length, length: length)
+    guard let attributed = client.attributedSubstring(from: range) else {
+      return boundedRagImeCommittedContext(fallback)
+    }
+    var text = attributed.string.trimmingCharacters(in: .whitespacesAndNewlines)
+    for suffix in [markedText, "　"] where !suffix.isEmpty && text.hasSuffix(suffix) {
+      text.removeLast(suffix.count)
+      text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+    guard !text.isEmpty else {
+      return boundedRagImeCommittedContext(fallback)
+    }
+    return boundedRagImeCommittedContext(text)
+  }
+
+  func pruneRagImeCommittedContext(now: Date = Date()) {
+    guard !ragImeCommittedContext.isEmpty else { return }
+    if now.timeIntervalSince(ragImeCommittedContextUpdatedAt) > 90 {
+      ragImeCommittedContext = ""
+      ragImeCommittedContextUpdatedAt = .distantPast
+    }
+  }
