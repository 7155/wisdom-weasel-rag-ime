+  func openRagImeAgentControlCenter(sessionId: String) {
+    let workspace = NSWorkspace.shared
+    let configuration = NSWorkspace.OpenConfiguration()
+    configuration.activates = true
+    let notifyAgentDestination = {
+      DistributedNotificationCenter.default().post(
+        name: Notification.Name("com.rag-ime.control.open-agent"),
+        object: nil,
+        userInfo: ["sessionId": sessionId]
+      )
+    }
+    if let appURL = workspace.urlForApplication(withBundleIdentifier: "com.rag-ime.control") {
+      workspace.openApplication(at: appURL, configuration: configuration) { _, _ in
+        DispatchQueue.main.async { notifyAgentDestination() }
+      }
+      return
+    }
+    let userApp = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Applications/RagImeControl.app")
+    if FileManager.default.fileExists(atPath: userApp.path) {
+      workspace.openApplication(at: userApp, configuration: configuration) { _, _ in
+        DispatchQueue.main.async { notifyAgentDestination() }
+      }
+    }
+  }
