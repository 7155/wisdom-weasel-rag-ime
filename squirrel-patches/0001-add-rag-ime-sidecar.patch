+  func ragImeDisplaySessionStillLive(now: Date = Date()) -> Bool {
+    guard let expiresAt = ragImeDisplayExpiresAt else { return true }
+    return now <= expiresAt
+  }
+
+  func scheduleRagImeDisplayExpiry() {
+    ragImeDisplayExpiryWorkItem?.cancel()
+    guard !ragImeDisplayCandidates.isEmpty else {
+      ragImeDisplayExpiryWorkItem = nil
+      return
+    }
+    let stateFingerprint = ragImeDisplayStateFingerprint()
+    let delay: TimeInterval
+    if let expiresAt = ragImeDisplayExpiresAt {
+      delay = max(0.05, expiresAt.timeIntervalSinceNow)
+    } else if ragImeDisplayRawInput.isEmpty && ragImeDisplayPreedit.isEmpty {
+      delay = ragImePostCommitDisplayHoldoverDuration
+    } else {
+      delay = ragImeDisplayHoldoverDuration
+    }
+    let workItem = DispatchWorkItem { [weak self] in
+      guard let self else { return }
+      guard self.ragImeDisplayStateFingerprint() == stateFingerprint else { return }
+      guard !self.ragImeDisplayCandidates.isEmpty else { return }
+      let candidateCount = self.ragImeDisplayCandidates.count
+      self.clearRagImeDisplayCandidates()
+      self.traceRagImeFrontendEvent("panel_expired_cleared", fields: [
+        "candidateCount": candidateCount,
+        "delayMs": Int(delay * 1000),
+      ])
+      self.rimeUpdate(clearReservedComments: false, requestSidecar: false)
+    }
+    ragImeDisplayExpiryWorkItem = workItem
+    DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: workItem)
+  }
