+  @discardableResult
+  func enforceRagImeSensitiveFieldGuard() -> Bool {
+    let status = ragImeSelectedTextProvider.sensitiveFieldStatus(sourceAppBundleId: currentApp)
+    ragImePrivacyDisposition = status.privacyDisposition
+    if status.isSensitive {
+      let changed = !ragImeSensitiveFieldActive || ragImeSensitiveFieldReason != status.reason
+      ragImeSensitiveFieldActive = true
+      ragImeSensitiveFieldReason = status.reason
+      if changed {
+        clearRagImeSensitiveRuntimeState()
+        traceRagImeFrontendEvent("sensitive_field_suppressed", fields: [
+          "sensitiveField": true,
+          "reason": status.reason,
+          "frontAppBundleId": currentApp,
+        ])
+      }
+      return true
+    }
+    if ragImeSensitiveFieldActive {
+      let previousReason = ragImeSensitiveFieldReason
+      clearRagImeSensitiveRuntimeState()
+      traceRagImeFrontendEvent("sensitive_field_exited", fields: [
+        "sensitiveField": true,
+        "reason": previousReason,
+        "frontAppBundleId": currentApp,
+      ])
+      ragImeSensitiveFieldActive = false
+      ragImeSensitiveFieldReason = ""
+    }
+    ragImePrivacyDisposition = "allowed"
+    return false
+  }
+
+  func clearRagImeSensitiveRuntimeState() {
+    ragImePrivacyDisposition = "unknown"
+    ragImeInputGeneration += 1
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    ragImeCommittedContext = ""
+    ragImeCommittedContextUpdatedAt = .distantPast
+    ragImeLastForegroundTextSnapshot = nil
+    ragImeForegroundCaptureToken = nil
+    ragImeCommitBurstWorkItem?.cancel()
+    ragImeCommitBurstWorkItem = nil
+    ragImeCommitBurstGeneration += 1
+    ragImeCommitBurstDeltaChars = 0
+    ragImeCommitBurstTexts = []
+    ragImePendingRequestWorkItem?.cancel()
+    ragImePendingRequestWorkItem = nil
+    ragImeLastRequestFingerprint = ""
+    ragImePendingRequestFingerprint = ""
+    resetRagImePendingContinuationState()
+    cancelRagImeActiveRagSession(reason: "sensitive_field")
+    clearRagImeDisplayCandidates()
+    dismissRagImeAssistantOverlay(reason: "sensitive_field")
+  }
