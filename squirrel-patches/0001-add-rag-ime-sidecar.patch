+  func beginRagImeActiveRagSession(_ request: RagImeActiveRagRequest) -> Int {
+    cancelRagImeActiveRagSession(reason: "superseded")
+    ragImeActiveRagGeneration += 1
+    ragImeActiveRagOverlaySignature = ""
+    ragImeActiveRagSelectedTextHash = request.selectedTextHash
+    ragImeActiveRagFrontAppBundleId = request.frontAppBundleId
+    ragImeActiveRagFrontendRevision = request.frontendRevision
+    ragImeActiveRagSelectionEpoch = request.selectionEpoch
+    ragImeActiveRagPanelSessionId = request.panelSessionId
+    ragImeActiveRagInputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    return ragImeActiveRagGeneration
+  }
+
+  func cancelRagImeActiveRagSession(reason: String) {
+    let hadActiveSession = !ragImeActiveRagPanelSessionId.isEmpty
+      || !ragImeActiveRagSelectedTextHash.isEmpty
+      || ragImeActiveRagPollWorkItem != nil
+    ragImeActiveRagPollWorkItem?.cancel()
+    ragImeActiveRagPollWorkItem = nil
+    ragImeActiveRagOverlaySignature = ""
+    guard hadActiveSession else { return }
+    let cancelledSelectedTextHash = ragImeActiveRagSelectedTextHash
+    let cancelledFrontAppBundleId = ragImeActiveRagFrontAppBundleId
+    let cancelledFrontendRevision = ragImeActiveRagFrontendRevision
+    let cancelledSelectionEpoch = ragImeActiveRagSelectionEpoch
+    let cancelledPanelSessionId = ragImeActiveRagPanelSessionId
+    ragImeActiveRagGeneration += 1
+    ragImeActiveRagSelectedTextHash = ""
+    ragImeActiveRagFrontAppBundleId = ""
+    ragImeActiveRagFrontendRevision = 0
+    ragImeActiveRagSelectionEpoch = 0
+    ragImeActiveRagPanelSessionId = ""
+    ragImeActiveRagInputSourceId = ""
+    traceRagImeFrontendEvent("active_rag_session_cancelled", fields: [
+      "reason": reason,
+      "activeRagGeneration": ragImeActiveRagGeneration,
+      "selectedTextHash": cancelledSelectedTextHash,
+      "frontAppBundleId": cancelledFrontAppBundleId,
+      "frontendRevision": cancelledFrontendRevision,
+      "selectionEpoch": cancelledSelectionEpoch,
+      "panelSessionId": cancelledPanelSessionId,
+      "traceIncludesText": false,
+    ])
+  }
+
+  func ragImeActiveRagSessionIsLive(_ request: RagImeActiveRagRequest, generation: Int) -> Bool {
+    let liveInputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    return generation == ragImeActiveRagGeneration
+      && request.selectedTextHash == ragImeActiveRagSelectedTextHash
+      && request.frontAppBundleId == currentApp
+      && request.frontAppBundleId == ragImeActiveRagFrontAppBundleId
+      && request.frontendRevision == ragImeFrontendRevision
+      && request.frontendRevision == ragImeActiveRagFrontendRevision
+      && request.selectionEpoch == ragImeSelectionEpoch
+      && request.selectionEpoch == ragImeActiveRagSelectionEpoch
+      && request.panelSessionId == ragImeActiveRagPanelSessionId
+      && liveInputSourceId == ragImeActiveRagInputSourceId
+  }
