@@ -0,0 +1,165 @@
+//
+//  RagImeSidecarModels.swift
+//  Squirrel
+//
+
+import Foundation
+
+struct RagImeSidecarRequest: Codable {
+  let sessionId: String
+  let requestSeq: Int
+  let rawInput: String
+  let preedit: String
+  let commitTextPreview: String
+  let committedContext: String
+  let project: String
+  let latencyBudgetMs: Int
+  let maxVisibleCandidates: Int
+  let maxSideCandidates: Int
+  let rimeContext: RagImeRimeContextPayload
+}
+
+struct RagImeRimeContextPayload: Codable {
+  let candidates: [RagImeRimeCandidatePayload]
+  let highlightedIndex: Int
+  let page: Int
+  let isLastPage: Bool
+}
+
+struct RagImeRimeCandidatePayload: Codable {
+  let label: String
+  let text: String
+  let comment: String
+  let index: Int?
+}
+
+struct RagImeSidecarResponse: Codable {
+  let schemaVersion: String
+  let sessionId: String
+  let requestSeq: Int
+  let project: String
+  let rawInput: String
+  let preedit: String
+  let committedContext: String
+  let semanticQuery: String
+  let queryBasis: String
+  let triggerDecision: RagImeTriggerDecision?
+  let historyContext: String
+  let latencyBudgetMs: Int
+  let rimeContext: RagImeRimeContextPayload
+  let modelPredictions: [RagImeModelPrediction]
+  let ragCandidates: [RagImeSuggestion]
+  let displayCandidates: [RagImeDisplayCandidate]
+  let selectionActions: RagImeSelectionActions
+  let mergePolicy: RagImeMergePolicy
+}
+
+struct RagImeTriggerDecision: Codable {
+  let shouldRefresh: Bool
+  let reason: String
+  let idleMs: Int
+  let semanticSignalLength: Int
+  let forceSideCandidates: Bool
+}
+
+struct RagImeModelPrediction: Codable, Hashable {
+  let text: String
+  let rank: Int
+  let providerName: String
+  let latencyMs: Int
+  let confidence: Double
+  let metadata: [String: RagImeJSONValue]
+}
+
+struct RagImeSuggestion: Codable, Hashable {
+  let suggestionId: String
+  let surfaceText: String
+  let insertText: String
+  let suggestionType: String
+  let sourceEventId: Int
+  let memoryId: String
+  let evidencePreview: String
+  let expandedEvidence: String
+  let confidence: Double
+  let actions: [String]
+  let metadata: [String: RagImeJSONValue]
+}
+
+struct RagImeDisplayCandidate: Codable, Hashable {
+  let label: String
+  let selectionKey: String?
+  let selectionRank: Int?
+  let text: String
+  let insertText: String
+  let sourceType: String
+  let selectionAction: String
+  let sourceIndex: Int
+  let comment: String
+  let evidencePreview: String
+  let suggestionId: String
+  let memoryId: String
+  let sourceEventId: Int?
+  let rimeIndex: Int?
+  let displayLayout: String?
+  let displayLane: String?
+  let metadata: [String: RagImeJSONValue]
+}
+
+struct RagImeSelectionActions: Codable {
+  let rime: String
+  let side: String
+}
+
+struct RagImeMergePolicy: Codable {
+  let rimeFirst: Bool
+  let maxVisibleCandidates: Int
+  let maxSideCandidates: Int
+  let maxModelSideCandidates: Int?
+  let ragKeepsRemainingSideSlots: Bool?
+  let rawPinyinFallback: Bool
+  let sideCandidatesEnabled: Bool?
+}
+
+enum RagImeJSONValue: Codable, Hashable {
+  case string(String)
+  case number(Double)
+  case bool(Bool)
+  case array([RagImeJSONValue])
+  case object([String: RagImeJSONValue])
+  case null
+
+  init(from decoder: Decoder) throws {
+    let container = try decoder.singleValueContainer()
+    if container.decodeNil() {
+      self = .null
+    } else if let value = try? container.decode(Bool.self) {
+      self = .bool(value)
+    } else if let value = try? container.decode(Double.self) {
+      self = .number(value)
+    } else if let value = try? container.decode(String.self) {
+      self = .string(value)
+    } else if let value = try? container.decode([RagImeJSONValue].self) {
+      self = .array(value)
+    } else {
+      self = .object(try container.decode([String: RagImeJSONValue].self))
+    }
+  }
+
+  func encode(to encoder: Encoder) throws {
+    var container = encoder.singleValueContainer()
+    switch self {
+    case .string(let value):
+      try container.encode(value)
+    case .number(let value):
+      try container.encode(value)
+    case .bool(let value):
+      try container.encode(value)
+    case .array(let value):
+      try container.encode(value)
+    case .object(let value):
+      try container.encode(value)
+    case .null:
+      try container.encodeNil()
+    }
+  }
+}
