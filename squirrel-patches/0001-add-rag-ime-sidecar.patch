+  func startRagImeActiveRagAssistFromSelection() -> Bool {
+    guard requireRagImeActiveRagEnabled(trigger: "selection") else { return false }
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return false }
+    guard let sidecarClient = ragImeSidecarClient else { return false }
+    let provider = ragImeSelectedTextProvider
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    let frontendRevision = ragImeFrontendRevision
+    let selectionEpoch = ragImeSelectionEpoch
+    let panelSessionId = UUID().uuidString
+    let allowAccessibility = ragImeActiveRagAccessibilityCaptureEnabled()
+    let allowClipboardFallback = ragImeActiveRagClipboardFallbackEnabled()
+    guard let capture = provider.captureSelectedTextForActiveRag(
+      captureEpoch: selectionEpoch,
+      sourceAppBundleId: currentApp,
+      allowAccessibility: allowAccessibility,
+      allowClipboardFallback: allowClipboardFallback
+    ) else {
+      traceRagImeFrontendEvent("active_rag_selected_text_capture_failed", fields: [
+        "frontendRevision": frontendRevision,
+        "selectionEpoch": selectionEpoch,
+        "panelSessionId": panelSessionId,
+        "frontAppBundleId": currentApp,
+        "allowAccessibility": allowAccessibility,
+        "allowClipboardFallback": allowClipboardFallback,
+      ])
+      traceRagImeFrontendEvent("active_rag_shortcut_context_fallback", fields: [
+        "reason": "selected_text_unavailable",
+        "frontendRevision": frontendRevision,
+        "selectionEpoch": selectionEpoch,
+        "panelSessionId": panelSessionId,
+      ])
+      return startRagImeActiveRagAssistFromContext()
+    }
+    let requestContext = ragImeCompactWhitespace(
+      [capture.surroundingBefore, capture.selectedText, capture.surroundingAfter].joined(separator: " ")
+    )
+    let request = RagImeActiveRagRequest(
+      schemaVersion: "rag-ime.active-rag-request.v1",
+      sessionId: String(session),
+      selectedText: capture.selectedText,
+      selectedTextHash: capture.selectedTextHash,
+      selectedTextChars: capture.selectedTextChars,
+      selectedTextPreview: capture.selectedTextPreview,
+      frontendRevision: frontendRevision,
+      selectionEpoch: selectionEpoch,
+      panelSessionId: panelSessionId,
+      frontAppBundleId: currentApp,
+      privacyDisposition: ragImePrivacyDisposition,
+      surroundingBefore: capture.surroundingBefore,
+      surroundingAfter: capture.surroundingAfter,
+      canReplaceSelection: capture.canReplaceSelection,
+      captureEpoch: capture.captureEpoch,
+      placement: capture.canReplaceSelection ? "replace_selection" : "show_only",
+      intent: "rewrite",
+      context: requestContext,
+      contextSource: capture.captureSource,
+      contextChars: requestContext.count,
+      contextHash: ragImeStableTextHash(requestContext),
+      project: sidecarClient.project,
+      maxCandidates: 1,
+      latencyBudgetMs: 120000
+    )
+    traceRagImeFrontendEvent("active_rag_thinking_displayed", fields: [
+      "selectedTextHash": request.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "contextHash": request.contextHash,
+      "contextChars": request.contextChars,
+      "contextSource": request.contextSource,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "panelSessionId": panelSessionId,
+      "frontAppBundleId": currentApp,
+      "captureSource": capture.captureSource,
+      "allowAccessibility": allowAccessibility,
+      "allowClipboardFallback": allowClipboardFallback,
+      "traceIncludesText": false,
+    ])
+    let activeGeneration = beginRagImeActiveRagSession(request)
+    showRagImeActiveRagThinkingPlaceholder(request: request)
+    sendRagImeActiveRagStartRequest(request, sidecarClient: sidecarClient, generation: activeGeneration)
+    return true
+  }
+
+  func startRagImeActiveRagAssistFromContext(actionCandidate: RagImeDisplayCandidate? = nil) -> Bool {
+    guard requireRagImeActiveRagEnabled(trigger: "context") else { return false }
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return false }
+    guard let sidecarClient = ragImeSidecarClient else { return false }
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    let frontendRevision = ragImeFrontendRevision
+    let selectionEpoch = ragImeSelectionEpoch
+    let panelSessionId = UUID().uuidString
+    let inputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    let accessibilityForeground = ragImeSelectedTextProvider.captureForegroundTextForSidecar(
+      captureEpoch: selectionEpoch,
+      sourceAppBundleId: currentApp,
+      inputSourceId: inputSourceId,
+      beforeLimit: 1200,
+      afterLimit: 120,
+      allowAccessibility: ragImeActiveRagAccessibilityCaptureEnabled()
+    )
+    let imkForeground = ragImeForegroundContextResolver.captureFromTextInputClient(
+      client,
+      captureEpoch: selectionEpoch,
+      sourceAppBundleId: currentApp,
+      inputSourceId: inputSourceId,
+      beforeLimit: 1200,
+      afterLimit: 120
+    ).snapshot
+    let freshForeground: RagImeForegroundTextSnapshot? = {
+      switch (accessibilityForeground, imkForeground) {
+      case let (accessibility?, imk?):
+        let accessibilityChars = ragImeCompactWhitespace(accessibility.surroundingBefore).count
+        let imkChars = ragImeCompactWhitespace(imk.surroundingBefore).count
+        return imkChars > accessibilityChars ? imk : accessibility
+      case let (accessibility?, nil):
+        return accessibility
+      case let (nil, imk?):
+        return imk
+      default:
+        return nil
+      }
+    }()
+    let clientContext = ragImeCompactWhitespace(
+      syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeDisplayPreedit)
+    )
+    let capturedBefore = ragImeCompactWhitespace(freshForeground?.surroundingBefore ?? "")
+    let useClientContext = clientContext.count > capturedBefore.count
+    let surroundingBefore = useClientContext ? clientContext : capturedBefore
+    let surroundingAfter = ragImeCompactWhitespace(freshForeground?.surroundingAfter ?? "")
+    let semanticQuery = ragImeCompactWhitespace(ragImeDisplaySemanticQuery)
+    // Insert-at-caret generation is grounded in text before the caret. Text
+    // after the caret remains provenance, but must not replace the current
+    // request with a later paragraph from the same editor.
+    let context = surroundingBefore
+    let anchorText = ragImeActiveRagContextAnchor(context.isEmpty ? semanticQuery : context)
+    guard !anchorText.isEmpty else {
+      traceRagImeFrontendEvent("active_rag_context_button_rejected", fields: [
+        "reason": "empty_context_anchor",
+        "frontendRevision": frontendRevision,
+        "selectionEpoch": selectionEpoch,
+        "panelSessionId": panelSessionId,
+      ])
+      return false
+    }
+    let request = RagImeActiveRagRequest(
+      schemaVersion: "rag-ime.active-rag-request.v1",
+      sessionId: String(session),
+      selectedText: anchorText,
+      selectedTextHash: ragImeStableTextHash(anchorText),
+      selectedTextChars: anchorText.count,
+      selectedTextPreview: String(anchorText.prefix(80)),
+      frontendRevision: frontendRevision,
+      selectionEpoch: selectionEpoch,
+      panelSessionId: panelSessionId,
+      frontAppBundleId: currentApp,
+      privacyDisposition: ragImePrivacyDisposition,
+      surroundingBefore: surroundingBefore,
+      surroundingAfter: surroundingAfter,
+      canReplaceSelection: false,
+      captureEpoch: selectionEpoch,
+      placement: "insert_after_selection",
+      intent: "complete",
+      context: context.isEmpty ? anchorText : context,
+      contextSource: useClientContext
+        ? "text_input_client"
+        : (freshForeground?.source ?? (clientContext.isEmpty ? "missing" : "text_input_client")),
+      contextChars: (context.isEmpty ? anchorText : context).count,
+      contextHash: ragImeStableTextHash(context.isEmpty ? anchorText : context),
+      project: sidecarClient.project,
+      maxCandidates: 1,
+      latencyBudgetMs: 120000
+    )
+    traceRagImeFrontendEvent("active_rag_context_button_triggered", fields: [
+      "selectedTextHash": request.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "panelSessionId": panelSessionId,
+      "frontAppBundleId": currentApp,
+      "sourceCandidate": actionCandidate.map { ragImeTraceCandidateSummary($0, index: 0) } ?? [:],
+      "foregroundSource": request.contextSource,
+      "accessibilityContextChars": accessibilityForeground.map {
+        ragImeCompactWhitespace($0.surroundingBefore).count
+      } ?? 0,
+      "imkContextChars": imkForeground.map { ragImeCompactWhitespace($0.surroundingBefore).count } ?? 0,
+      "clientContextChars": clientContext.count,
+      "contextChars": request.context.count,
+      "maxCandidates": request.maxCandidates,
+      "traceIncludesText": false,
+    ])
+    let activeGeneration = beginRagImeActiveRagSession(request)
+    showRagImeActiveRagThinkingPlaceholder(request: request)
+    sendRagImeActiveRagStartRequest(request, sidecarClient: sidecarClient, generation: activeGeneration)
+    return true
+  }
+
+  func startRagImeAgentDeepSearchFromContext(
+    actionCandidate: RagImeDisplayCandidate? = nil
+  ) -> Bool {
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return false }
+    guard let sidecarClient = ragImeSidecarClient else { return false }
+    let committedContext = ragImeCompactWhitespace(
+      syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeOverlayPreedit)
+    )
+    let semanticQuery = ragImeCompactWhitespace(
+      ragImeOverlaySemanticQuery.isEmpty ? ragImeDisplaySemanticQuery : ragImeOverlaySemanticQuery
+    )
+    let query = ragImeActiveRagContextAnchor(semanticQuery.isEmpty ? committedContext : semanticQuery)
+    guard !query.isEmpty else {
+      traceRagImeFrontendEvent("agent_deep_search_rejected", fields: ["reason": "empty_context_anchor"])
+      return false
+    }
+    let evidence = ragImeOverlayCandidates.compactMap { candidate -> RagImeAgentDeepSearchEvidence? in
+      let preview = ragImeCompactWhitespace(candidate.evidencePreview)
+      guard !preview.isEmpty, ["rag", "memory"].contains(candidate.sourceType) else { return nil }
+      return RagImeAgentDeepSearchEvidence(
+        sourceType: candidate.sourceType,
+        sourceBadge: candidate.sourceBadge ?? "",
+        candidateStableId: candidate.candidateStableId ?? "",
+        memoryId: candidate.memoryId,
+        sourceEventId: candidate.sourceEventId,
+        evidencePreview: String(preview.prefix(600))
+      )
+    }
+    let request = RagImeAgentDeepSearchRequest(
+      query: query,
+      context: String(committedContext.prefix(8000)),
+      contextSource: committedContext.isEmpty ? "missing" : "text_input_client",
+      frontAppBundleId: currentApp,
+      privacyDisposition: ragImePrivacyDisposition,
+      evidence: Array(evidence.prefix(8))
+    )
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    traceRagImeFrontendEvent("agent_deep_search_submitted", fields: [
+      "frontAppBundleId": currentApp,
+      "queryChars": query.count,
+      "contextChars": request.context.count,
+      "evidenceCount": request.evidence.count,
+      "sourceCandidate": actionCandidate.map { ragImeTraceCandidateSummary($0, index: 0) } ?? [:],
+      "traceIncludesText": false,
+    ])
+    dismissRagImeAssistantOverlay(reason: "agent_deep_search_submitted")
+    sidecarClient.postAgentDeepSearch(request) { [weak self] result in
+      guard let self else { return }
+      switch result {
+      case .success(let receipt):
+        self.traceRagImeFrontendEvent("agent_deep_search_accepted", fields: [
+          "sessionId": receipt.sessionId,
+          "sessionCreated": receipt.sessionCreated,
+          "turnId": receipt.turnId,
+        ])
+        self.openRagImeAgentControlCenter(sessionId: receipt.sessionId)
+      case .failure:
+        self.traceRagImeFrontendEvent("agent_deep_search_failed", fields: [
+          "reason": "transport_or_runtime_error",
+        ])
+        NSSound.beep()
+        self.openRagImeAgentControlCenter(sessionId: "")
+      }
+    }
+    return true
+  }
+
+  func ragImeActiveRagContextAnchor(_ text: String) -> String {
+    let normalized = ragImeCompactWhitespace(text)
+    guard normalized.count > 120 else { return normalized }
+    return String(normalized.suffix(120))
+  }
