+import CryptoKit
+import Foundation
+
+struct RagImeSidecarClient {
+  private static let healthLock = NSLock()
+  private static var disabledUntil = Date.distantPast
+  private static var consecutiveFailures = 0
+
+  let pythonExecutable: String
+  let repoRoot: String
+  let dbPath: String
+  let project: String
+  let maxVisibleCandidates: Int
+  let maxSideCandidates: Int
+  let latencyBudgetMs: Int
+  let debounceMs: Int
+  let postCommitIdleMs: Int
+  let timeoutSeconds: TimeInterval
+  let sidecarURL: URL?
+  let frontendTrace: Bool
+
+  init?(config: SquirrelConfig?) {
+    guard config?.getBool("rag_ime/enabled") == true else { return nil }
+    let repoRoot = Self.trimmed(config?.getString("rag_ime/repo_root"))
+    guard !repoRoot.isEmpty else {
+      print("RAG IME sidecar disabled: rag_ime/repo_root is empty")
+      return nil
+    }
+    let configuredPython = Self.trimmed(config?.getString("rag_ime/python"))
+    let configuredDbPath = Self.trimmed(config?.getString("rag_ime/db_path"))
+    let configuredProject = Self.trimmed(config?.getString("rag_ime/project"))
+    let configuredSidecarURL = Self.trimmed(config?.getString("rag_ime/sidecar_url"))
+
+    self.pythonExecutable = configuredPython.isEmpty ? "/usr/bin/python3" : configuredPython
+    self.repoRoot = repoRoot
+    self.dbPath = configuredDbPath.isEmpty ? "\(repoRoot)/.rag-ime-data/rag-ime.sqlite" : configuredDbPath
+    self.project = configuredProject.isEmpty ? "wisdom-weasel-rag-ime" : configuredProject
+    self.maxVisibleCandidates = Self.intConfig(config, "rag_ime/max_visible_candidates", fallback: 8, range: 1...10)
+    self.maxSideCandidates = Self.intConfig(config, "rag_ime/max_side_candidates", fallback: 5, range: 0...10)
+    self.latencyBudgetMs = Self.intConfig(config, "rag_ime/latency_budget_ms", fallback: 900, range: 30...3000)
+    self.debounceMs = Self.intConfig(config, "rag_ime/debounce_ms", fallback: 80, range: 0...500)
+    self.postCommitIdleMs = Self.intConfig(config, "rag_ime/post_commit_idle_ms", fallback: 420, range: 40...1000)
+    self.timeoutSeconds = TimeInterval(Self.intConfig(config, "rag_ime/timeout_ms", fallback: 1200, range: 30...3000)) / 1000
+    self.sidecarURL = configuredSidecarURL.isEmpty ? nil : URL(string: configuredSidecarURL)
+    self.frontendTrace = config?.getBool("rag_ime/frontend_trace") == true
+  }
+
+  func request(_ request: RagImeSidecarRequest) throws -> RagImeSidecarResponse {
+    guard request.privacyDisposition == "allowed" else {
+      throw RagImeSidecarError.transport("foreground privacy disposition is not allowed")
+    }
+    if let remainingMs = Self.sidecarCooldownRemainingMs(), remainingMs > 0 {
+      throw RagImeSidecarError.circuitOpen(remainingMs)
+    }
+    guard let sidecarURL else {
+      throw RagImeSidecarError.transport("sidecar_url missing; passive input path does not run CLI fallback")
+    }
+    do {
+      let outputData = try postJSON(request, to: endpoint("rime-suggest", base: sidecarURL))
+      Self.recordSidecarSuccess()
+      return try JSONDecoder().decode(RagImeSidecarResponse.self, from: outputData)
+    } catch {
+      let cooldownMs = Self.recordSidecarFailure()
+      print("RAG IME sidecar HTTP request failed; passive CLI fallback disabled; cooldownMs=\(cooldownMs): \(error)")
+      throw error
+    }
+  }
+
+  func postActiveRagStart(_ request: RagImeActiveRagRequest, completion: @escaping (RagImeActiveRagResponse) -> Void) {
+    guard request.privacyDisposition == "allowed" else {
+      completion(RagImeActiveRagResponse.failure(sessionId: request.sessionId, request: request, reason: "privacy_not_allowed"))
+      return
+    }
+    DispatchQueue.global(qos: .userInitiated).async {
+      do {
+        let outputData: Data
+        if let sidecarURL {
+          outputData = try postJSON(request, to: endpoint("active-rag/start", base: sidecarURL))
+        } else {
+          outputData = try runCli([
+            "active-rag-demo",
+            "--selected-text", request.selectedText,
+            "--surrounding-before", request.surroundingBefore,
+            "--surrounding-after", request.surroundingAfter,
+            "--intent", request.intent,
+            "--placement", request.placement,
+            "--context", request.context,
+            "--project", request.project,
+            "--max-candidates", String(request.maxCandidates),
+          ])
+        }
+        let response = try JSONDecoder().decode(RagImeActiveRagResponse.self, from: outputData)
+        DispatchQueue.main.async { completion(response) }
+      } catch {
+        print("RAG IME Active RAG start failed: \(error)")
+        let response = RagImeActiveRagResponse.failure(sessionId: request.sessionId, request: request, reason: "start_transport_error")
+        DispatchQueue.main.async { completion(response) }
+      }
+    }
+  }
+
+  func postActiveRagStatus(sessionId: String, request: RagImeActiveRagRequest, completion: @escaping (RagImeActiveRagResponse) -> Void) {
+    guard request.privacyDisposition == "allowed" else {
+      completion(RagImeActiveRagResponse.failure(sessionId: sessionId, request: request, reason: "privacy_not_allowed"))
+      return
+    }
+    guard let sidecarURL else {
+      completion(RagImeActiveRagResponse.failure(sessionId: sessionId, request: request, reason: "sidecar_url_missing"))
+      return
+    }
+    DispatchQueue.global(qos: .userInitiated).async {
+      do {
+        let outputData = try postJSON(
+          ["sessionId": sessionId, "privacyDisposition": request.privacyDisposition],
+          to: endpoint("active-rag/status", base: sidecarURL)
+        )
+        let response = try JSONDecoder().decode(RagImeActiveRagResponse.self, from: outputData)
+        DispatchQueue.main.async { completion(response) }
+      } catch {
+        print("RAG IME Active RAG status failed: \(error)")
+        let response = RagImeActiveRagResponse.failure(sessionId: sessionId, request: request, reason: "status_transport_error")
+        DispatchQueue.main.async { completion(response) }
+      }
+    }
+  }
+
+  func postAgentDeepSearch(
+    _ request: RagImeAgentDeepSearchRequest,
+    completion: @escaping (Result<RagImeAgentDeepSearchReceipt, Error>) -> Void
+  ) {
+    guard request.privacyDisposition == "allowed" else {
+      completion(.failure(RagImeSidecarError.transport("foreground privacy disposition is not allowed")))
+      return
+    }
+    guard let sidecarURL else {
+      completion(.failure(RagImeSidecarError.transport("sidecar_url missing; Pi deep search requires the local sidecar")))
+      return
+    }
+    DispatchQueue.global(qos: .userInitiated).async {
+      do {
+        let data = try postJSON(
+          request,
+          to: endpoint("agent/deep-search", base: sidecarURL),
+          timeoutOverride: 30
+        )
+        let receipt = try JSONDecoder().decode(RagImeAgentDeepSearchReceipt.self, from: data)
+        DispatchQueue.main.async { completion(.success(receipt)) }
+      } catch {
+        DispatchQueue.main.async { completion(.failure(error)) }
+      }
+    }
+  }
+
+  func recordSideCandidateCommit(
+    _ candidate: RagImeDisplayCandidate,
+    shownCandidates: [RagImeDisplayCandidate],
+    query: String,
+    recentContext: String,
+    preedit: String,
+    contextGroupId: String,
+    contextGroupLevel: String,
+    privacyDisposition: String
+  ) throws -> RagImeSelectionReceipt {
+    guard privacyDisposition == "allowed" else {
+      throw RagImeSidecarError.transport("foreground privacy disposition is not allowed")
+    }
+    let insertText = candidate.insertText.isEmpty ? candidate.text : candidate.insertText
+    guard !Self.trimmed(insertText).isEmpty else {
+      return RagImeSelectionReceipt(
+        schemaVersion: "rag-ime.rime-selection.v1",
+        ok: false,
+        eventId: "",
+        recordedActionCount: 0
+      )
+    }
+    let selectionPayload = RagImeSelectionPayload(
+      candidate: candidate,
+      shownCandidates: shownCandidates,
+      query: query,
+      recentContext: recentContext,
+      committedContext: recentContext,
+      preedit: preedit,
+      project: project,
+      source: "squirrel_rime_sidecar",
+      app: "squirrel",
+      contextGroupId: contextGroupId,
+      contextGroupLevel: contextGroupLevel,
+      privacyDisposition: privacyDisposition
+    )
+    if let sidecarURL {
+      do {
+        let data = try postJSON(selectionPayload, to: endpoint("rime-select", base: sidecarURL))
+        return try JSONDecoder().decode(RagImeSelectionReceipt.self, from: data)
+      } catch {
+        print("RAG IME rime-select failed, falling back to legacy commit/action: \(error)")
+      }
+    } else {
+      do {
+        let requestFile = FileManager.default.temporaryDirectory
+          .appendingPathComponent("rag-ime-selection-\(UUID().uuidString).json")
+        let requestData = try JSONEncoder().encode(selectionPayload)
+        try requestData.write(to: requestFile, options: .atomic)
+        defer { try? FileManager.default.removeItem(at: requestFile) }
+        let data = try runCli([
+          "rime-select-json",
+          "--payload-file",
+          requestFile.path,
+        ])
+        return try JSONDecoder().decode(RagImeSelectionReceipt.self, from: data)
+      } catch {
+        print("RAG IME rime-select CLI failed, falling back to legacy commit/action: \(error)")
+      }
+    }
+    return try recordSideCandidateCommitLegacy(
+      candidate,
+      insertText: insertText,
+      query: query,
+      recentContext: recentContext,
+      preedit: preedit,
+      contextGroupId: contextGroupId,
+      contextGroupLevel: contextGroupLevel,
+      privacyDisposition: privacyDisposition
+    )
+  }
+
+  func recordNativeRimeSelection(
+    selectionId: String,
+    preedit: String,
+    acceptedText: String,
+    rejectedText: String,
+    candidateRank: Int,
+    shownCandidateCount: Int,
+    app: String,
+    privacyDisposition: String
+  ) throws -> RagImeNativeRimeSelectionReceipt {
+    guard privacyDisposition == "allowed" else {
+      throw RagImeSidecarError.transport("foreground privacy disposition is not allowed")
+    }
+    guard let sidecarURL else {
+      return RagImeNativeRimeSelectionReceipt(
+        schemaVersion: "rag-ime.rime-rank-selection.v1",
+        ok: false,
+        recorded: false,
+        dryRun: false,
+        eventId: 0,
+        action: "",
+        candidateRank: max(1, candidateRank),
+        sourceType: "rime"
+      )
+    }
+    let payload = RagImeNativeRimeSelectionPayload(
+      schemaVersion: "rag-ime.rime-rank-selection.v1",
+      selectionId: selectionId,
+      sourceType: "rime",
+      selectionSource: "patched_squirrel",
+      preedit: preedit,
+      acceptedText: acceptedText,
+      rejectedText: rejectedText,
+      candidateRank: max(1, candidateRank),
+      shownCandidateCount: max(0, shownCandidateCount),
+      app: app,
+      project: project,
+      privacyDisposition: privacyDisposition,
+      dryRun: false
+    )
+    let data = try postJSON(payload, to: endpoint("rime-rank-feedback", base: sidecarURL))
+    return try JSONDecoder().decode(RagImeNativeRimeSelectionReceipt.self, from: data)
+  }
+
+  func recordAcceptedCandidateBackspace(
+    sourceType: String,
+    candidateId: String,
+    candidateText: String,
+    preedit: String,
+    contextHash: String,
+    acceptedAtMs: Int,
+    app: String,
+    privacyDisposition: String
+  ) throws -> RagImeAcceptedEditFeedbackReceipt {
+    guard privacyDisposition == "allowed" else {
+      throw RagImeSidecarError.transport("foreground privacy disposition is not allowed")
+    }
+    guard let sidecarURL else {
+      return RagImeAcceptedEditFeedbackReceipt(
+        schemaVersion: "rag-ime.candidate-edit-feedback.v1",
+        ok: false,
+        recorded: false,
+        rimeRecorded: false,
+        event: nil,
+        sourceType: sourceType
+      )
+    }
+    let payload = RagImeAcceptedEditFeedbackPayload(
+      schemaVersion: "rag-ime.candidate-edit-feedback.v1",
+      sourceType: sourceType,
+      candidateId: candidateId,
+      candidateText: candidateText,
+      preedit: preedit,
+      contextHash: contextHash,
+      acceptedAtMs: acceptedAtMs,
+      deleteCount: 1,
+      app: app,
+      project: project,
+      privacyDisposition: privacyDisposition
+    )
+    let data = try postJSON(payload, to: endpoint("candidate-edit-feedback", base: sidecarURL))
+    return try JSONDecoder().decode(RagImeAcceptedEditFeedbackReceipt.self, from: data)
+  }
+
+  func recordSideCandidateCommitLegacy(
+    _ candidate: RagImeDisplayCandidate,
+    insertText: String,
+    query: String,
+    recentContext: String,
+    preedit: String,
+    contextGroupId: String,
+    contextGroupLevel: String,
+    privacyDisposition: String
+  ) throws -> RagImeSelectionReceipt {
+    guard privacyDisposition == "allowed" else {
+      throw RagImeSidecarError.transport("foreground privacy disposition is not allowed")
+    }
+    let commitPayload = RagImeCommitPayload(
+      text: insertText,
+      recentContext: recentContext,
+      preedit: preedit,
+      project: project,
+      source: "squirrel_rime_sidecar",
+      tags: ["squirrel", "rime-sidecar"],
+      contextGroupId: contextGroupId,
+      contextGroupLevel: contextGroupLevel,
+      privacyDisposition: privacyDisposition
+    )
+    if let sidecarURL {
+      _ = try postJSON(commitPayload, to: endpoint("commit", base: sidecarURL))
+    } else {
+      _ = try runCli([
+        "commit",
+        insertText,
+        "--recent-context",
+        recentContext,
+        "--preedit",
+        preedit,
+        "--source",
+        "squirrel_rime_sidecar",
+        "--project",
+        project,
+        "--tag",
+        "squirrel",
+        "--tag",
+        "rime-sidecar",
+        "--privacy-disposition",
+        privacyDisposition,
+      ])
+    }
+
+    guard candidate.sourceType == "rag",
+          !candidate.memoryId.isEmpty,
+          !candidate.suggestionId.isEmpty,
+          let sourceEventId = candidate.sourceEventId else {
+      return RagImeSelectionReceipt(
+        schemaVersion: "rag-ime.rime-selection.v1",
+        ok: true,
+        eventId: "",
+        recordedActionCount: 0
+      )
+    }
+    let actionPayload = RagImeActionPayload(
+      actionType: "accepted",
+      memoryId: candidate.memoryId,
+      suggestionId: candidate.suggestionId,
+      sourceEventId: sourceEventId,
+      query: query,
+      surfaceText: candidate.text,
+      privacyDisposition: privacyDisposition
+    )
+    if let sidecarURL {
+      _ = try postJSON(actionPayload, to: endpoint("action", base: sidecarURL))
+    } else {
+      _ = try runCli([
+        "action-json",
+        "accepted",
+        "--memory-id",
+        candidate.memoryId,
+        "--suggestion-id",
+        candidate.suggestionId,
+        "--source-event-id",
+        String(sourceEventId),
+        "--query",
+        query,
+        "--surface-text",
+        candidate.text,
+        "--privacy-disposition",
+        privacyDisposition,
+      ])
+    }
+    return RagImeSelectionReceipt(
+      schemaVersion: "rag-ime.rime-selection.v1",
+      ok: true,
+      eventId: String(sourceEventId),
+      recordedActionCount: 1
+    )
+  }
