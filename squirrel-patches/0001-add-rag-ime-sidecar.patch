+  func ragImeAssistantOverlayPreservingSessionActions(
+    _ payload: RagImeAssistantOverlayPayload
+  ) -> RagImeAssistantOverlayPayload {
+    guard payload.phase == "post_commit" || payload.inputMode == "post_commit_predicting" else {
+      return payload
+    }
+    let requiredActions = [
+      "start_active_rag_from_context",
+      "start_agent_deep_search_from_context",
+    ]
+    let visibleActions = Set(payload.candidates.map(\.selectionAction))
+    let priorActions = ragImeOverlayCandidates.filter { candidate in
+      candidate.sourceType == "action" && requiredActions.contains(candidate.selectionAction)
+    }
+    var candidates = payload.candidates
+    var preservedActions: [String] = []
+    for selectionAction in requiredActions where !visibleActions.contains(selectionAction) {
+      guard let template = priorActions.first(where: { $0.selectionAction == selectionAction }) else {
+        continue
+      }
+      candidates.append(ragImeRebindOverlayActionCandidate(template, to: payload))
+      preservedActions.append(selectionAction)
+    }
+    guard !preservedActions.isEmpty else { return payload }
+    traceRagImeFrontendEvent("assistant_overlay_session_actions_preserved", fields: [
+      "snapshotId": payload.snapshotId,
+      "preservedActions": preservedActions,
+      "incomingCandidateCount": payload.candidates.count,
+      "effectiveCandidateCount": candidates.count,
+    ])
+    return payload.replacingCandidates(candidates)
+  }
+
+  func ragImeRebindOverlayActionCandidate(
+    _ template: RagImeDisplayCandidate,
+    to payload: RagImeAssistantOverlayPayload
+  ) -> RagImeDisplayCandidate {
+    var metadata = template.metadata
+    let referenceMetadata = payload.candidates.first?.metadata ?? [:]
+    let transactionKeys = [
+      "frontendRevision",
+      "selectionEpoch",
+      "panelSessionId",
+      "frontAppBundleId",
+      "inputSourceId",
+      "compositionHash",
+      "committedContextHash",
+    ]
+    for key in transactionKeys {
+      if let value = payload.frontendTransaction?[key] ?? referenceMetadata[key] {
+        metadata[key] = value
+      }
+    }
+    if !payload.sessionFingerprint.isEmpty {
+      metadata["sessionFingerprint"] = .string(payload.sessionFingerprint)
+    }
+    metadata["localPlaceholder"] = .bool(false)
+    metadata["frontendPreservedAction"] = .bool(true)
+    let nowMs = Int(Date().timeIntervalSince1970 * 1000)
+    return RagImeDisplayCandidate(
+      label: template.label,
+      visibleLabel: template.visibleLabel,
+      selectionKey: template.selectionKey,
+      selectionRank: template.selectionRank,
+      candidateOrdinal: template.candidateOrdinal,
+      candidateStableId: template.candidateStableId,
+      snapshotId: payload.snapshotId,
+      snapshotGeneration: payload.candidates.first?.snapshotGeneration ?? template.snapshotGeneration,
+      text: template.text,
+      insertText: template.insertText,
+      sourceType: template.sourceType,
+      selectionAction: template.selectionAction,
+      sourceIndex: template.sourceIndex,
+      comment: template.comment,
+      badge: template.badge,
+      sourceBadge: template.sourceBadge,
+      colorToken: template.colorToken,
+      sourceStability: "frontend_preserved_action",
+      hardContextAnchor: template.hardContextAnchor,
+      queryAnchor: template.queryAnchor,
+      displayAnchor: template.displayAnchor,
+      expiresAtMs: nowMs + max(payload.expiresAfterMs, 8000),
+      minVisibleUntilMs: nowMs + 500,
+      evidencePreview: template.evidencePreview,
+      suggestionId: template.suggestionId,
+      memoryId: template.memoryId,
+      sourceEventId: template.sourceEventId,
+      rimeIndex: template.rimeIndex,
+      displayLayout: template.displayLayout,
+      displayLane: template.displayLane,
+      group: template.group,
+      groupLabel: template.groupLabel,
+      isSelectable: template.isSelectable,
+      isStatus: template.isStatus,
+      metadata: metadata
+    )
+  }
