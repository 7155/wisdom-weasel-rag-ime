+  func ragImeDisplayText(for candidate: RagImeDisplayCandidate) -> String {
+    let text = candidate.text.trimmingCharacters(in: .whitespacesAndNewlines)
+    let base = ragImeStripSourceSuffix(text.isEmpty ? candidate.insertText : text)
+    switch candidate.sourceType {
+    case "model", "rag", "memory", "status", "action":
+      let badge = ragImeDisplayBadge(for: candidate)
+      guard !badge.isEmpty else { return base }
+      return "[\(badge)] \(base)"
+    default:
+      return base
+    }
+  }
+
+  func ragImeStripSourceSuffix(_ text: String) -> String {
+    var value = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    for suffix in ["_model", "_rag", "_memory", " [LLM]", " [RAG]", " LLM", " RAG", " 模", " 查", " 忆"] {
+      if value.hasSuffix(suffix) {
+        let stripped = String(value.dropLast(suffix.count)).trimmingCharacters(in: .whitespacesAndNewlines)
+        if !stripped.isEmpty {
+          value = stripped
+          break
+        }
+      }
+    }
+    return value
+  }
