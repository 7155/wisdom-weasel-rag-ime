+  func commitRagImeAssistantCandidate(_ candidate: RagImeDisplayCandidate, route: String, index: Int) -> Bool {
+    if candidate.selectionAction == "start_active_rag_from_context" {
+      return startRagImeActiveRagAssistFromContext(actionCandidate: candidate)
+    }
+    guard candidate.selectionAction == "commit_side_candidate" else { return false }
+    let insertText = ragImeStripSourceSuffix(candidate.insertText.isEmpty ? candidate.text : candidate.insertText)
+    guard !insertText.isEmpty else { return false }
+    let recentContext = syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeOverlayPreedit)
+    traceRagImeFrontendEvent("assistant_overlay_candidate_accepted", fields: [
+      "route": route,
+      "index": index,
+      "candidate": ragImeTraceCandidateSummary(candidate, index: index),
+      "selectionEpoch": ragImeSelectionEpoch,
+      "panelSessionId": ragImeOverlayPanelSessionId,
+      "snapshotId": ragImeOverlaySnapshotId,
+    ])
+    traceRagImeFrontendEvent("side_candidate_commit", fields: [
+      "index": index,
+      "candidate": ragImeTraceCandidateSummary(candidate, index: index),
+      "query": ragImeOverlaySemanticQuery,
+      "preedit": ragImeOverlayPreedit,
+      "recentContextChars": recentContext.count,
+      "overlay": true,
+    ])
+    commit(string: insertText)
+    rimeAPI.clear_composition(session)
+    recordRagImeSideCandidateCommit(
+      candidate,
+      shownCandidates: ragImeOverlayCandidates,
+      query: ragImeOverlaySemanticQuery,
+      recentContext: recentContext,
+      preedit: ragImeOverlayPreedit,
+      contextGroupId: ragImeDisplayContextGroupId,
+      contextGroupLevel: ragImeDisplayContextGroupLevel
+    ) { [weak self] _ in
+      self?.scheduleRagImePostCommitContinuation(committedText: insertText, sourceCandidate: candidate)
+    }
+    ragImeFrontendRevision += 1
+    ragImeSelectionEpoch += 1
+    dismissRagImeAssistantOverlay(reason: "candidate_accepted")
+    rimeUpdate(clearReservedComments: false, requestSidecar: false)
+    return true
+  }
