+        "contextHash": .string(request.contextHash),
+        "evidenceCount": .number(0),
+        "retrievalAttempted": .bool(false),
+        "diagnosticStatus": .string(request.contextChars > 0 ? "context_captured" : "context_missing"),
+      ],
+      dismissReason: ""
+    )
+    applyRagImeAssistantOverlay(
+      payload,
+      semanticQuery: request.context,
+      preedit: "",
+      traceEvent: "assistant_overlay_active_rag_thinking"
+    )
+  }
+
+  func sendRagImeActiveRagStartRequest(
+    _ request: RagImeActiveRagRequest,
+    sidecarClient: RagImeSidecarClient,
+    generation: Int
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard(),
+      ragImePrivacyDisposition == "allowed",
+      request.privacyDisposition == "allowed",
+      request.frontAppBundleId == currentApp else { return }
+    traceRagImeFrontendEvent("active_rag_start_request_scheduled", fields: [
+      "selectedTextHash": request.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "frontendRevision": request.frontendRevision,
+      "selectionEpoch": request.selectionEpoch,
+      "panelSessionId": request.panelSessionId,
+      "frontAppBundleId": request.frontAppBundleId,
+      "endpoint": "/api/active-rag/start",
+    ])
+    sidecarClient.postActiveRagStart(request) { [weak self] response in
+      guard let self else { return }
+      guard !self.enforceRagImeSensitiveFieldGuard(),
+        self.ragImePrivacyDisposition == "allowed",
+        request.privacyDisposition == "allowed",
+        request.frontAppBundleId == self.currentApp else {
+        self.cancelRagImeActiveRagSession(reason: "privacy_or_focus_changed")
+        return
+      }
+      guard self.ragImeActiveRagSessionIsLive(request, generation: generation) else {
+        self.traceRagImeFrontendEvent("active_rag_response_dropped_stale", fields: [
+          "reason": "start_callback_generation_changed",
+          "activeRagGeneration": generation,
+          "liveActiveRagGeneration": self.ragImeActiveRagGeneration,
+          "panelSessionId": request.panelSessionId,
+          "traceIncludesText": false,
+        ])
+        return
+      }
+      self.applyRagImeActiveRagResponse(response, request: request, generation: generation)
+      if (response.status == "pending" || response.thinkingRow)
+        && self.ragImeActiveRagSessionIsLive(request, generation: generation) {
+        self.scheduleRagImeActiveRagStatusPoll(
+          request: request,
+          response: response,
+          attempt: 1,
+          generation: generation
+        )
+      }
+    }
+  }
+
+  func applyRagImeActiveRagResponse(
+    _ response: RagImeActiveRagResponse,
+    request: RagImeActiveRagRequest,
+    generation: Int
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard(),
+      ragImePrivacyDisposition == "allowed",
+      request.privacyDisposition == "allowed" else { return }
+    guard response.selectedTextHash == request.selectedTextHash
+      && response.frontendRevision == request.frontendRevision
+      && response.selectionEpoch == request.selectionEpoch
+      && response.panelSessionId == request.panelSessionId
+      && response.frontAppBundleId == request.frontAppBundleId
+      && ragImeActiveRagSelectedTextHash == request.selectedTextHash
+      && ragImeActiveRagFrontAppBundleId == request.frontAppBundleId
+      && ragImeActiveRagFrontendRevision == request.frontendRevision
+      && ragImeActiveRagSelectionEpoch == request.selectionEpoch
+      && response.panelSessionId == ragImeActiveRagPanelSessionId
+      && ragImeActiveRagSessionIsLive(request, generation: generation) else {
+      traceRagImeFrontendEvent("active_rag_response_dropped_stale", fields: [
+        "reason": "active_rag_anchor_mismatch",
+        "activeRagGeneration": generation,
+        "liveActiveRagGeneration": ragImeActiveRagGeneration,
+        "selectedTextHash": request.selectedTextHash,
+        "frontendRevision": request.frontendRevision,
+        "selectionEpoch": request.selectionEpoch,
+        "panelSessionId": request.panelSessionId,
+        "frontAppBundleId": request.frontAppBundleId,
+      ])
+      return
+    }
+    let activeStatusText = response.candidates.first(where: { $0.sourceType == "status" || $0.isStatus == true })?.text
+    let activeOverlayCandidates = response.candidates.filter { candidate in
+      candidate.sourceType != "status" && candidate.isStatus != true
+    }
+    let remoteReady: Bool? = {
+      guard case .object(let route)? = response.diagnostics?["route"],
+        case .bool(let ready)? = route["ready"] else { return nil }
+      return ready
+    }()
+    let remoteModelReason: String = {
+      guard case .object(let route)? = response.diagnostics?["route"],
+        case .string(let reason)? = route["skipReason"] else { return response.error ?? "" }
+      return reason
+    }()
+    let retrievalAttempted: Bool = {
+      guard case .object(let retrieval)? = response.diagnostics?["retrieval"],
+        case .bool(let attempted)? = retrieval["attempted"] else { return true }
+      return attempted
+    }()
+    let contextInjection: [String: RagImeJSONValue] = {
+      guard case .object(let injection)? = response.diagnostics?["contextInjection"] else { return [:] }
+      return injection
+    }()
+    let effectiveContextChars: Int = {
+      if case .number(let value)? = contextInjection["effectiveContextChars"] { return Int(value) }
+      if case .number(let value)? = contextInjection["contextChars"] { return Int(value) }
+      return request.contextChars
+    }()
+    let effectiveContextSource: String = {
+      guard case .string(let value)? = contextInjection["source"], !value.isEmpty else { return request.contextSource }
+      return value
+    }()
+    let effectiveContextHash: String = {
+      guard case .string(let value)? = contextInjection["contextHash"], !value.isEmpty else { return request.contextHash }
+      return value
+    }()
+    let timelineRecentInputChars: Int = {
+      guard case .number(let value)? = contextInjection["timelineRecentInputChars"] else { return 0 }
+      return Int(value)
+    }()
+    let foregroundContextChars: Int = {
+      guard case .number(let value)? = contextInjection["foregroundContextChars"] else { return request.contextChars }
+      return Int(value)
+    }()
+    let timelineRecentInputUsedForGeneration: Bool = {
+      guard case .bool(let value)? = contextInjection["timelineRecentInputUsedForGeneration"] else { return false }
+      return value
+    }()
+    let shortForegroundCapture: Bool = {
+      guard case .bool(let value)? = contextInjection["shortForegroundCapture"] else { return request.contextChars < 8 }
+      return value
+    }()
+    let diagnosticStatus: String
+    if effectiveContextChars <= 0 {
+      diagnosticStatus = "context_missing"
+    } else if response.status == "error" {
+      diagnosticStatus = "remote_model_error"
+    } else if activeStatusText?.contains("没有合适") == true {
+      diagnosticStatus = "no_suitable_suggestion"
+    } else if remoteReady == false {
+      diagnosticStatus = remoteModelReason.isEmpty ? "remote_model_disabled" : remoteModelReason
+    } else if retrievalAttempted && response.evidenceCount == 0 {
+      diagnosticStatus = "no_evidence"
+    } else {
+      diagnosticStatus = response.thinkingRow ? "retrieving" : "ready"
+    }
+    var activeDiagnostics: [String: RagImeJSONValue] = [
+      "contextCaptured": .bool(effectiveContextChars > 0),
+      "contextSource": .string(effectiveContextSource),
+      "contextChars": .number(Double(effectiveContextChars)),
+      "foregroundContextChars": .number(Double(foregroundContextChars)),
+      "effectiveContextChars": .number(Double(effectiveContextChars)),
+      "timelineRecentInputChars": .number(Double(timelineRecentInputChars)),
+      "timelineRecentInputUsedForGeneration": .bool(timelineRecentInputUsedForGeneration),
+      "shortForegroundCapture": .bool(shortForegroundCapture),
+      "contextHash": .string(effectiveContextHash),
+      "evidenceCount": .number(Double(response.evidenceCount)),
+      "retrievalAttempted": .bool(retrievalAttempted),
+      "diagnosticStatus": .string(diagnosticStatus),
+    ]
+    if let remoteReady { activeDiagnostics["remoteModelReady"] = .bool(remoteReady) }
+    if !remoteModelReason.isEmpty { activeDiagnostics["remoteModelReason"] = .string(remoteModelReason) }
+    let activeSourceCards = response.evidenceCount > 0 ? [
+      RagImeAssistantSourceCard(
+        sourceType: "rag",
+        sourceBadge: "RAG",
+        title: "已检索 \(response.evidenceCount) 条证据",
+        evidencePreview: "",
+        confidence: nil,
+        suggestionId: "active-rag-evidence:\(response.sessionId)",
+        memoryId: ""
+      ),
+    ] : []
+    let activeOverlayPayload = RagImeAssistantOverlayPayload(
+      schemaVersion: "rag-ime.assistant-overlay.v1",
+      visible: response.thinkingRow || response.status == "error" || activeStatusText != nil || !activeOverlayCandidates.isEmpty,
+      uiMode: response.uiMode,
+      phase: "active_rag",
+      inputMode: "active_rag_assist",
+      statusText: activeStatusText ?? (response.thinkingRow ? "正在生成..." : (response.status == "error" ? "暂未完成，可以重试" : "")),
+      animation: RagImeAssistantOverlayAnimation(kind: response.thinkingRow ? "thinking_dots" : "none", frame: max(0, response.elapsedMs ?? 0) / 250 % 3),
+      candidates: activeOverlayCandidates,
+      sourceCards: activeSourceCards,
+      snapshotId: response.sessionId,
+      sessionFingerprint: "",
+      expiresAfterMs: Int(ragImePostCommitDisplayHoldoverDuration * 1000),
+      keyPolicy: response.keyPolicy,
+      overlayConfig: nil,
+      progressive: nil,
+      frontendTransaction: activeDiagnostics,
+      dismissReason: ""
+    )
+    ragImeActiveRagSelectedTextHash = response.selectedTextHash
+    ragImeActiveRagFrontAppBundleId = response.frontAppBundleId
+    ragImeActiveRagFrontendRevision = response.frontendRevision
+    ragImeActiveRagSelectionEpoch = response.selectionEpoch
+    let overlaySignature = [
+      response.status,
+      response.thinkingRow ? "thinking" : "ready",
+      String(response.evidenceCount),
+      activeOverlayCandidates.map { $0.candidateStableId ?? $0.suggestionId }.joined(separator: ","),
+      response.error ?? "",
+    ].joined(separator: "|")
+    if overlaySignature != ragImeActiveRagOverlaySignature {
+      ragImeActiveRagOverlaySignature = overlaySignature
+      applyRagImeAssistantOverlay(
+        activeOverlayPayload,
+        semanticQuery: request.context,
+        preedit: "",
+        traceEvent: response.thinkingRow ? "assistant_overlay_active_rag_thinking" : "assistant_overlay_active_rag_ready"
+      )
+    } else {
+      traceRagImeFrontendEvent("assistant_overlay_unchanged_skipped", fields: [
+        "snapshotId": response.sessionId,
+        "status": response.status,
+        "thinkingRow": response.thinkingRow,
+      ])
+    }
+    traceRagImeFrontendEvent(response.thinkingRow ? "active_rag_thinking_displayed" : "active_rag_ready_displayed", fields: [
+      "selectedTextHash": response.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "contextHash": effectiveContextHash,
+      "contextChars": effectiveContextChars,
+      "foregroundContextChars": foregroundContextChars,
+      "contextSource": effectiveContextSource,
+      "frontendRevision": response.frontendRevision,
+      "selectionEpoch": response.selectionEpoch,
+      "panelSessionId": response.panelSessionId,
+      "frontAppBundleId": response.frontAppBundleId,
+      "candidateCount": response.candidateCount,
+      "evidenceCount": response.evidenceCount,
+      "diagnosticStatus": diagnosticStatus,
+      "uiMode": response.uiMode,
+      "overlay": true,
+      "traceIncludesText": false,
+    ])
+  }
+
+  func scheduleRagImeActiveRagStatusPoll(
+    request: RagImeActiveRagRequest,
+    response: RagImeActiveRagResponse,
+    attempt: Int,
+    generation: Int
+  ) {
+    guard attempt <= 1200 else { return }
+    guard response.status == "pending" || response.thinkingRow else { return }
+    guard let sidecarClient = ragImeSidecarClient else { return }
+    let serverDelayMs = response.pollAfterMs ?? 0
+    let delayMs = serverDelayMs > 0 ? min(max(serverDelayMs, 80), 180) : 100
+    traceRagImeFrontendEvent("active_rag_status_poll_scheduled", fields: [
+      "sessionId": response.sessionId,
+      "attempt": attempt,
+      "delayMs": delayMs,
+      "selectedTextHash": request.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "frontendRevision": request.frontendRevision,
+      "selectionEpoch": request.selectionEpoch,
+      "panelSessionId": request.panelSessionId,
+      "frontAppBundleId": request.frontAppBundleId,
+      "traceIncludesText": false,
+    ])
+    ragImeActiveRagPollWorkItem?.cancel()
+    let workItem = DispatchWorkItem { [weak self] in
+      guard let self else { return }
+      guard !self.enforceRagImeSensitiveFieldGuard(),
+        self.ragImePrivacyDisposition == "allowed",
+        request.privacyDisposition == "allowed",
+        request.frontAppBundleId == self.currentApp else {
+        self.cancelRagImeActiveRagSession(reason: "privacy_or_focus_changed")
+        return
+      }
+      guard self.ragImeActiveRagSessionIsLive(request, generation: generation) else {
+        self.traceRagImeFrontendEvent("active_rag_status_poll_cancelled", fields: [
+          "reason": "active_rag_generation_changed",
+          "attempt": attempt,
+          "activeRagGeneration": generation,
+          "liveActiveRagGeneration": self.ragImeActiveRagGeneration,
+          "selectedTextHash": request.selectedTextHash,
+          "selectedTextChars": request.selectedTextChars,
+          "frontendRevision": request.frontendRevision,
+          "selectionEpoch": request.selectionEpoch,
+          "panelSessionId": request.panelSessionId,
+          "frontAppBundleId": request.frontAppBundleId,
+          "traceIncludesText": false,
+        ])
+        return
+      }
+      self.ragImeActiveRagPollWorkItem = nil
+      sidecarClient.postActiveRagStatus(sessionId: response.sessionId, request: request) { [weak self] nextResponse in
+        guard let self else { return }
+        guard self.ragImeActiveRagSessionIsLive(request, generation: generation) else {
+          self.traceRagImeFrontendEvent("active_rag_response_dropped_stale", fields: [
+            "reason": "status_callback_generation_changed",
+            "attempt": attempt,
+            "activeRagGeneration": generation,
+            "liveActiveRagGeneration": self.ragImeActiveRagGeneration,
+            "panelSessionId": request.panelSessionId,
+            "traceIncludesText": false,
+          ])
+          return
+        }
+        self.applyRagImeActiveRagResponse(nextResponse, request: request, generation: generation)
+        if (nextResponse.status == "pending" || nextResponse.thinkingRow)
+          && self.ragImeActiveRagSessionIsLive(request, generation: generation) {
+          self.scheduleRagImeActiveRagStatusPoll(
+            request: request,
+            response: nextResponse,
+            attempt: attempt + 1,
+            generation: generation
+          )
+        }
+      }
+    }
+    ragImeActiveRagPollWorkItem = workItem
+    DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(delayMs), execute: workItem)
+  }
+
+  func refreshRagImeSidecar(
+    rawInput: String,
+    preedit: String,
+    commitTextPreview: String,
+    candidates: [String],
+    comments: [String],
+    labels: [String],
+    highlighted: Int,
+    page: Int,
+    lastPage: Bool,
+    requestSidecar: Bool,
+    immediate: Bool = false,
+    commitBurstReady: Bool = false,
+    acceptedCandidateContinuation: Bool = false,
+    commitBurstDeltaChars: Int = 0,
+    commitBurstTexts: [String] = []
+  ) {
+    guard requestSidecar else { return }
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return }
+    if !rawInput.isEmpty || !preedit.isEmpty {
+      ragImeCommitBurstWorkItem?.cancel()
+      ragImeCommitBurstWorkItem = nil
+      let hadAIUI = ragImeAssistantOverlayController.isVisible
+        || ragImePanelUsesDisplayCandidates
+        || !ragImeDisplayCandidates.isEmpty
+      if hadAIUI {
+        clearRagImeDisplayCandidates()
+      } else {
+        ragImePendingRequestWorkItem?.cancel()
+        ragImePendingRequestWorkItem = nil
+        ragImePendingRequestFingerprint = ""
+      }
+      traceRagImeFrontendEvent("rime_composition_started", fields: [
+        "rawInput": rawInput,
+        "preedit": preedit,
+        "candidateCount": candidates.count,
+        "highlighted": highlighted,
+        "page": page,
+      ])
+      if !candidates.isEmpty {
+        traceRagImeFrontendEvent("rime_composition_candidates_visible", fields: [
+          "candidateCount": candidates.count,
+          "highlighted": highlighted,
+          "page": page,
+          "lastPage": lastPage,
+        ])
+      }
+      traceRagImeFrontendEvent("composition_ai_suppressed", fields: [
+        "rawInput": rawInput,
+        "preedit": preedit,
+        "reason": "rime_composition_phase",
+      ])
+      return
+    }
+    // Empty Rime updates also arrive for ASCII passthrough and mode switches.
+    // Only an actual commit burst or accepted AI continuation may enter the
+    // post-commit prediction lane.
+    guard commitBurstReady || acceptedCandidateContinuation else {
+      return
+    }
+    guard let sidecarClient = ragImeSidecarClient else {
+      clearRagImeDisplayCandidates()
+      return
+    }
+    syncRagImeCommittedContextFromClient(excludingMarkedText: preedit)
+    pruneRagImeCommittedContext()
+    let hasPostCommitCaptureSeed = commitBurstReady && !ragImeCompactWhitespace(commitTextPreview).isEmpty
+    guard !rawInput.isEmpty
+      || !preedit.isEmpty
+      || !candidates.isEmpty
+      || !ragImeCommittedContext.isEmpty
+      || hasPostCommitCaptureSeed else {
+      clearRagImeDisplayCandidates()
+      return
+    }
+
+    let rimeCandidates = candidates.enumerated().map { index, text in
+      RagImeRimeCandidatePayload(
+        label: index < labels.count ? labels[index] : "",
+        text: text,
+        comment: index < comments.count ? comments[index] : "",
+        index: index
+      )
+    }
+    let compositionText = preedit.isEmpty ? rawInput : preedit
+    let compositionHash = ragImeStableTextHash(compositionText)
+    let committedContextHash = ragImeStableTextHash(ragImeCommittedContext)
+    let forceSideCandidates = rawInput.isEmpty && preedit.isEmpty
+    let scheduledInputGeneration = ragImeInputGeneration + 1
+    let scheduledAtMs = Int(Date().timeIntervalSince1970 * 1000)
+    let inputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    let cachedForegroundText: RagImeForegroundTextSnapshot? = {
+      guard let snapshot = ragImeLastForegroundTextSnapshot,
+            snapshot.sourceAppBundleId == currentApp,
+            snapshot.inputSourceId == inputSourceId else { return nil }
+      let ageMs = max(0, scheduledAtMs - snapshot.capturedAtMs)
+      guard ageMs <= 1600 else { return nil }
+      return snapshot.withFreshness(ageMs)
+    }()
+    let textInputClientContext = (!rawInput.isEmpty || !preedit.isEmpty)
+      ? ""
+      : actualRagImeCommittedContextFromClient(fallback: "", excludingMarkedText: "")
+    let capturedClientContext = textInputClientContext.isEmpty
+      ? (cachedForegroundText?.surroundingBefore ?? "")
+      : textInputClientContext
+    let fallbackForegroundSource = (!rawInput.isEmpty || !preedit.isEmpty)
+      ? "rime_composition"
+      : (capturedClientContext.isEmpty ? "ime_commit_ledger" : "text_input_client")
+    let fallbackForegroundBefore = (!rawInput.isEmpty || !preedit.isEmpty)
+      ? compositionText
+      : boundedRagImeCommittedContext(capturedClientContext.isEmpty ? ragImeCommittedContext : capturedClientContext)
+    let fallbackCommitText = ragImeCompactWhitespace(commitTextPreview)
+    let fallbackCommitMatched = fallbackCommitText.isEmpty || fallbackForegroundBefore.contains(fallbackCommitText)
+    let fallbackForegroundText = RagImeForegroundTextSnapshot(
+      available: !rawInput.isEmpty || !preedit.isEmpty || !ragImeCommittedContext.isEmpty,
+      source: fallbackForegroundSource,
+      confidence: (!rawInput.isEmpty || !preedit.isEmpty) ? 1.0 : (textInputClientContext.isEmpty ? 0.65 : 0.78),
+      freshnessMs: 0,
+      selectedTextHash: "",
+      selectedTextChars: 0,
+      selectedTextPreview: "",
+      surroundingBefore: fallbackForegroundBefore,
+      surroundingAfter: "",
+      wholeValueHash: "",
+      wholeValueChars: 0,
+      canReplaceSelection: false,
+      captureEpoch: scheduledInputGeneration,
+      capturedAtMs: scheduledAtMs,
+      sourceAppBundleId: currentApp,
+      inputSourceId: inputSourceId,
+      captureFailureReason: "",
+      warnings: textInputClientContext.isEmpty ? ["ime_commit_ledger_same_app"] : ["text_input_client_context"],
+      snapshotId: "ctx_\(UUID().uuidString)",
+      contextGroupId: "app:\(ragImeStableTextHash(currentApp).replacingOccurrences(of: "sha256:", with: "").prefix(16))",
+      contextGroupLevel: "app",
+      contextGroupConfidence: 0.5,
+      commitTextMatched: fallbackCommitMatched
+    )
+    let foregroundText = cachedForegroundText ?? fallbackForegroundText
+    let fingerprint = ragImeRequestFingerprint(
+      rawInput: rawInput,
+      preedit: preedit,
+      commitTextPreview: commitTextPreview,
+      committedContext: ragImeCommittedContext,
+      foregroundText: foregroundText,
+      page: page,
+      highlighted: highlighted,
+      candidates: rimeCandidates
+    )
+    if fingerprint == ragImeLastRequestFingerprint || fingerprint == ragImePendingRequestFingerprint {
+      return
+    }
+    ragImePendingRequestWorkItem?.cancel()
+    ragImeRequestSeq += 1
+    let requestSeq = ragImeRequestSeq
+    ragImeFrontendRevision += 1
+    let frontendRevision = ragImeFrontendRevision
+    let selectionEpoch = ragImeSelectionEpoch
+    let panelSessionId = UUID().uuidString
+    let request = RagImeSidecarRequest(
+      frontendBuild: "rag-ime.foreground-trace.v2",
+      schemaVersion: "rag-ime.squirrel-frontend-trace.v1",
+      predictionFirstMerge: true,
+      sessionId: String(session),
+      requestSeq: requestSeq,
+      inputGeneration: scheduledInputGeneration,
+      createdAtMs: scheduledAtMs,
+      frontendRevision: frontendRevision,
+      selectionEpoch: selectionEpoch,
+      frontAppBundleId: currentApp,
+      inputSourceId: inputSourceId,
+      compositionHash: compositionHash,
+      committedContextHash: committedContextHash,
+      panelSessionId: panelSessionId,
+      capturedAtMs: foregroundText.capturedAtMs,
+      sourceAppBundleId: currentApp,
+      captureEpoch: foregroundText.captureEpoch,
+      captureFailureReason: foregroundText.captureFailureReason,
+      privacyDisposition: ragImePrivacyDisposition,
+      rawInput: rawInput,
+      preedit: preedit,
+      commitTextPreview: commitTextPreview,
+      committedContext: ragImeCommittedContext,
+      project: sidecarClient.project,
+      latencyBudgetMs: sidecarClient.latencyBudgetMs,
+      maxVisibleCandidates: sidecarClient.maxVisibleCandidates,
+      maxSideCandidates: sidecarClient.maxSideCandidates,
+      forceSideCandidates: forceSideCandidates,
+      commitBurstReady: commitBurstReady,
+      acceptedCandidateContinuation: acceptedCandidateContinuation,
+      commitBurstDeltaChars: commitBurstDeltaChars,
+      commitBurstTexts: commitBurstTexts,
+      progressiveFollowUp: false,
+      foregroundText: foregroundText,
+      rimeContext: RagImeRimeContextPayload(
+        candidates: rimeCandidates,
+        highlightedIndex: highlighted,
+        page: page,
+        isLastPage: lastPage
+      )
+    )
+    ragImeInputGeneration = scheduledInputGeneration
+    let inputGeneration = scheduledInputGeneration
+    if forceSideCandidates {
+      showRagImePostCommitActionPlaceholder(request: request)
+    }
+    traceRagImeFrontendEvent("frontend_transaction_created", fields: [
+      "requestSeq": requestSeq,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "frontAppBundleId": currentApp,
+      "inputSourceId": request.inputSourceId,
+      "compositionHash": compositionHash,
+      "committedContextHash": committedContextHash,
+      "compositionChars": ragImeCompactWhitespace(compositionText).count,
+      "committedContextChars": ragImeCompactWhitespace(ragImeCommittedContext).count,
+      "foregroundTextSource": foregroundText.source,
+      "foregroundTextAvailable": foregroundText.available,
+      "foregroundTextConfidence": foregroundText.confidence,
+      "foregroundTextBeforeChars": ragImeCompactWhitespace(foregroundText.surroundingBefore).count,
+      "foregroundTextAfterChars": ragImeCompactWhitespace(foregroundText.surroundingAfter).count,
+      "foregroundTextWarnings": foregroundText.warnings,
+      "panelSessionId": panelSessionId,
+    ])
+    let workItem = DispatchWorkItem { [weak self] in
+      self?.resolveRagImeForegroundContextAndSend(
+        request,
+        preliminaryFingerprint: fingerprint,
+        inputGeneration: inputGeneration,
+        sidecarClient: sidecarClient
+      )
+    }
+    traceRagImeFrontendEvent("foreground_context_capture_scheduled", fields: [
+      "requestSeq": requestSeq,
+      "frontendRevision": frontendRevision,
+      "selectionEpoch": selectionEpoch,
+      "compositionHash": compositionHash,
+      "committedContextHash": committedContextHash,
+      "panelSessionId": panelSessionId,
+      "inputGeneration": inputGeneration,
+      "rawInput": rawInput,
+      "preedit": preedit,
+      "committedContextChars": ragImeCommittedContext.count,
+      "captureEpoch": inputGeneration,
+      "captureDelayMs": immediate ? 16 : sidecarClient.debounceMs,
+      "commitBurstReady": commitBurstReady,
+      "acceptedCandidateContinuation": acceptedCandidateContinuation,
+      "commitBurstDeltaChars": commitBurstDeltaChars,
+      "commitBurstCount": commitBurstTexts.count,
+      "latencyBudgetMs": sidecarClient.latencyBudgetMs,
+      "maxVisibleCandidates": sidecarClient.maxVisibleCandidates,
+      "maxSideCandidates": sidecarClient.maxSideCandidates,
+      "forceSideCandidates": request.forceSideCandidates,
+      "candidateCount": rimeCandidates.count,
+      "candidates": rimeCandidates.prefix(8).map { item in
+        [
+          "label": item.label,
+          "text": item.text,
+          "comment": item.comment,
+          "index": item.index ?? -1,
+        ] as [String: Any]
+      },
+    ])
+    ragImeLastRequestFingerprint = fingerprint
+    ragImePendingRequestFingerprint = fingerprint
+    ragImePendingRequestWorkItem = workItem
+    let delay = TimeInterval(immediate ? 16 : sidecarClient.debounceMs) / 1000
+    if delay <= 0 {
+      DispatchQueue.main.async(execute: workItem)
+    } else {
+      DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: workItem)
+    }
+  }
+
+  func scheduleRagImeCommitBurstPrediction(committedText: String, acceptedCandidate: Bool = false) {
+    guard !enforceRagImeSensitiveFieldGuard(), ragImePrivacyDisposition == "allowed" else { return }
+    guard let sidecarClient = ragImeSidecarClient else { return }
+    let normalizedCommittedText = ragImeCompactWhitespace(committedText)
+    guard acceptedCandidate || !normalizedCommittedText.isEmpty else {
+      traceRagImeFrontendEvent("prediction_trigger_skipped", fields: [
+        "reason": "empty_commit",
+        "generation": ragImeCommitBurstGeneration,
+      ])
+      return
+    }
+    let wasPending = ragImeCommitBurstWorkItem != nil
+    ragImeCommitBurstWorkItem?.cancel()
+    ragImeCommitBurstDeltaChars += committedText.count
+    ragImeCommitBurstTexts.append(committedText)
+    ragImeCommitBurstGeneration += 1
+    let generation = ragImeCommitBurstGeneration
+    let idleMs = acceptedCandidate ? 0 : sidecarClient.postCommitIdleMs
+    traceRagImeFrontendEvent(wasPending ? "prediction_trigger_coalesced" : "prediction_trigger_dirty", fields: [
+      "generation": generation,
+      "commitTextChars": committedText.count,
+      "idleMs": idleMs,
+      "acceptedCandidate": acceptedCandidate,
+    ])
+    let workItem = DispatchWorkItem { [weak self] in
+      guard let self, generation == self.ragImeCommitBurstGeneration else { return }
+      self.ragImeCommitBurstWorkItem = nil
+      let deltaChars = self.ragImeCommitBurstDeltaChars
+      let burstTexts = self.ragImeCommitBurstTexts
+      self.ragImeCommitBurstDeltaChars = 0
+      self.ragImeCommitBurstTexts = []
+      self.traceRagImeFrontendEvent("prediction_trigger_fired", fields: [
+        "generation": generation,
+        "commitTextChars": committedText.count,
+        "acceptedCandidate": acceptedCandidate,
+        "idleMs": idleMs,
+        "deltaChars": deltaChars,
+      ])
+      self.refreshRagImeSidecar(
+        rawInput: "",
+        preedit: "",
+        commitTextPreview: committedText,
+        candidates: [],
+        comments: [],
+        labels: [],
+        highlighted: 0,
+        page: 0,
+        lastPage: true,
+        requestSidecar: true,
+        immediate: true,
+        commitBurstReady: true,
+        acceptedCandidateContinuation: acceptedCandidate,
+        commitBurstDeltaChars: deltaChars,
+        commitBurstTexts: burstTexts
+      )
+    }
+    ragImeCommitBurstWorkItem = workItem
+    let cooldownDelay = max(0, ragImeCommitBurstCooldownUntil.timeIntervalSinceNow)
+    let configuredDelay = TimeInterval(idleMs) / 1000
+    let delay = acceptedCandidate ? 0.0 : max(configuredDelay, cooldownDelay)
+    DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: workItem)
+  }
+
+  func cancelRagImeCommitBurstAfterDelete() {
+    ragImeCommitBurstWorkItem?.cancel()
+    ragImeCommitBurstWorkItem = nil
+    ragImeCommitBurstGeneration += 1
+    ragImeCommitBurstDeltaChars = 0
+    ragImeCommitBurstTexts = []
+    ragImeCommitBurstCooldownUntil = Date().addingTimeInterval(1.5)
+    traceRagImeFrontendEvent("prediction_trigger_skipped", fields: [
+      "reason": "delete_cooldown",
+      "cooldownMs": 1500,
+      "generation": ragImeCommitBurstGeneration,
+    ])
+  }
+
+  func scheduleRagImePostCommitContinuation(committedText: String, sourceCandidate: RagImeDisplayCandidate) {
+    guard ragImeSidecarClient != nil else { return }
+    ragImeCommitBurstWorkItem?.cancel()
+    ragImeCommitBurstWorkItem = nil
+    ragImeCommitBurstDeltaChars = 0
+    ragImeCommitBurstTexts = []
+    let previousContext = syncRagImeCommittedContextFromClient(excludingMarkedText: ragImeDisplayPreedit)
+    ragImePendingContinuationCandidate = sourceCandidate
+    ragImePendingContinuationCommittedText = committedText
+    ragImePendingContinuationPreviousContextHash = ragImeStableTextHash(previousContext)
+    ragImePendingContinuationQueuedAt = Date()
+    ragImePendingContinuationSelectionEpoch = ragImeSelectionEpoch
+    ragImePendingContinuationWorkItem?.cancel()
+    ragImePendingContinuationWorkItem = nil
+    traceRagImeFrontendEvent("side_candidate_commit_pending", fields: [
+      "committedText": committedText,
+      "previousCommittedContextHash": ragImePendingContinuationPreviousContextHash,
+      "previousCommittedContextChars": previousContext.count,
+      "sourceType": sourceCandidate.sourceType,
+      "selectionKey": ragImeSelectionKey(for: sourceCandidate),
+      "sessionFingerprint": ragImeDisplayCandidateSessionFingerprint(sourceCandidate),
+      "selectionEpoch": ragImeSelectionEpoch,
+    ])
+    scheduleRagImePendingContinuationObservation(attempt: 0)
+  }
+
+  func scheduleRagImePendingContinuationObservation(attempt: Int) {
+    guard ragImePendingContinuationCandidate != nil else { return }
+    ragImePendingContinuationWorkItem?.cancel()
+    let delay = attempt == 0 ? 0.03 : 0.08
+    let workItem = DispatchWorkItem { [weak self] in
+      self?.observeRagImePostCommitContinuationIfReady(attempt: attempt)
+    }
+    ragImePendingContinuationWorkItem = workItem
+    DispatchQueue.main.asyncAfter(deadline: .now() + delay, execute: workItem)
+  }
+
+  func observeRagImePostCommitContinuationIfReady() {
+    observeRagImePostCommitContinuationIfReady(attempt: 0)
+  }
+
+  func observeRagImePostCommitContinuationIfReady(attempt: Int) {
+    guard let sourceCandidate = ragImePendingContinuationCandidate else { return }
+    guard ragImeSidecarClient != nil else { return }
+    let committedText = ragImePendingContinuationCommittedText
+    if ragImePendingContinuationSelectionEpoch != 0 && ragImePendingContinuationSelectionEpoch != ragImeSelectionEpoch {
+      cancelRagImePendingContinuation(reason: "selection_epoch_changed", keyCode: nil)
+      return
+    }
+    let queuedAgeMs = Int(Date().timeIntervalSince(ragImePendingContinuationQueuedAt ?? Date()) * 1000)
+    if queuedAgeMs > 1200 {
+      traceRagImeFrontendEvent("commit_observe_timeout", fields: [
+        "committedText": committedText,
+        "queuedAgeMs": queuedAgeMs,
+        "attempt": attempt,
+        "selectionEpoch": ragImeSelectionEpoch,
+        "pendingSelectionEpoch": ragImePendingContinuationSelectionEpoch,
+      ])
+      cancelRagImePendingContinuation(reason: "commit_observe_timeout", keyCode: nil)
+      return
+    }
+    let committedContext = ragImeCommittedContext.isEmpty
+      ? syncRagImeCommittedContextFromClient(excludingMarkedText: "")
+      : ragImeCommittedContext
+    let committedContextHash = ragImeStableTextHash(committedContext)
+    guard !committedContext.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+      scheduleRagImePendingContinuationObservation(attempt: attempt + 1)
+      return
+    }
+    guard committedContextHash != ragImePendingContinuationPreviousContextHash || committedContext.contains(committedText) else {
+      scheduleRagImePendingContinuationObservation(attempt: attempt + 1)
+      return
+    }
+    resetRagImePendingContinuationState()
+    traceRagImeFrontendEvent("commit_observed", fields: [
+      "committedText": committedText,
+      "committedContextChars": committedContext.count,
+      "committedContextHash": committedContextHash,
+      "sourceType": sourceCandidate.sourceType,
+      "selectionKey": ragImeSelectionKey(for: sourceCandidate),
+      "sessionFingerprint": ragImeDisplayCandidateSessionFingerprint(sourceCandidate),
+      "selectionEpoch": ragImeSelectionEpoch,
+    ])
+    traceRagImeFrontendEvent("side_candidate_continuation_scheduled", fields: [
+      "committedText": committedText,
+      "committedContextChars": committedContext.count,
+      "sourceType": sourceCandidate.sourceType,
+      "selectionKey": ragImeSelectionKey(for: sourceCandidate),
+      "sessionFingerprint": ragImeDisplayCandidateSessionFingerprint(sourceCandidate),
+      "selectionEpoch": ragImeSelectionEpoch,
+    ])
+    traceRagImeFrontendEvent("post_commit_prediction_scheduled", fields: [
+      "committedText": committedText,
+      "committedContextChars": committedContext.count,
+      "sourceType": sourceCandidate.sourceType,
+      "selectionKey": ragImeSelectionKey(for: sourceCandidate),
+      "sessionFingerprint": ragImeDisplayCandidateSessionFingerprint(sourceCandidate),
+      "frontendRevision": ragImeFrontendRevision,
+      "selectionEpoch": ragImeSelectionEpoch,
+    ])
+    refreshRagImeSidecar(
+      rawInput: "",
+      preedit: "",
+      commitTextPreview: committedText,
+      candidates: [],
+      comments: [],
+      labels: [],
+      highlighted: 0,
+      page: 0,
+      lastPage: true,
+      requestSidecar: true,
+      immediate: true,
+      commitBurstReady: true,
+      acceptedCandidateContinuation: true,
+      commitBurstDeltaChars: max(committedText.count, 1),
+      commitBurstTexts: []
+    )
+  }
+
+  func cancelRagImePendingContinuation(reason: String, keyCode: UInt16?) {
+    guard ragImePendingContinuationCandidate != nil else { return }
+    let queuedAgeMs = Int(Date().timeIntervalSince(ragImePendingContinuationQueuedAt ?? Date()) * 1000)
+    var fields: [String: Any] = [
+      "reason": reason,
+      "committedText": ragImePendingContinuationCommittedText,
+      "queuedAgeMs": queuedAgeMs,
+      "selectionEpoch": ragImeSelectionEpoch,
+      "pendingSelectionEpoch": ragImePendingContinuationSelectionEpoch,
+    ]
+    if let keyCode = keyCode {
+      fields["keyCode"] = Int(keyCode)
+    }
+    traceRagImeFrontendEvent("post_commit_chain_cancelled", fields: fields)
+    resetRagImePendingContinuationState()
+  }
+
+  func resetRagImePendingContinuationState() {
+    ragImePendingContinuationWorkItem?.cancel()
+    ragImePendingContinuationWorkItem = nil
+    ragImePendingContinuationCandidate = nil
+    ragImePendingContinuationCommittedText = ""
+    ragImePendingContinuationPreviousContextHash = ""
+    ragImePendingContinuationQueuedAt = nil
+    ragImePendingContinuationSelectionEpoch = 0
+  }
+
+  func resolveRagImeForegroundContextAndSend(
+    _ request: RagImeSidecarRequest,
+    preliminaryFingerprint: String,
+    inputGeneration: Int,
+    sidecarClient: RagImeSidecarClient,
+    captureAttempt: Int = 0
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard(),
+      ragImePrivacyDisposition == "allowed",
+      request.privacyDisposition == "allowed" else { return }
+    traceRagImeFrontendEvent("foreground_context_capture_started", fields: [
+      "requestSeq": request.requestSeq,
+      "captureEpoch": inputGeneration,
+      "captureAttempt": captureAttempt,
+      "snapshotId": request.foregroundText.snapshotId,
+    ])
+    guard preliminaryFingerprint == ragImeLastRequestFingerprint else {
+      traceRagImeFrontendEvent("sidecar_response_dropped_stale", fields: [
+        "requestSeq": request.requestSeq,
+        "reason": "stale_before_foreground_capture",
+        "inputGeneration": inputGeneration,
+      ])
+      return
+    }
+    let liveInputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    guard currentApp == request.frontAppBundleId, liveInputSourceId == request.inputSourceId else {
+      failRagImeForegroundContextCapture(
+        request,
+        fingerprint: preliminaryFingerprint,
+        reason: currentApp == request.frontAppBundleId ? "capture_input_source_mismatch" : "capture_app_mismatch",
+        imkReason: "",
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    let imkResult = ragImeForegroundContextResolver.captureFromTextInputClient(
+      client,
+      captureEpoch: inputGeneration,
+      sourceAppBundleId: currentApp,
+      inputSourceId: liveInputSourceId
+    )
+    if let snapshot = imkResult.snapshot {
+      finishRagImeForegroundContextCapture(
+        request,
+        preliminaryFingerprint: preliminaryFingerprint,
+        snapshot: snapshot,
+        captureReason: "text_input_client_ok",
+        inputGeneration: inputGeneration,
+        sidecarClient: sidecarClient,
+        captureAttempt: captureAttempt
+      )
+      return
+    }
+    // The IMK client can disappear immediately after a composition commits.
+    // request.foregroundText was captured synchronously from that same client
+    // before the debounce, so keep it as the first fallback while it is fresh.
+    let fallbackAgeMs = max(0, Int(Date().timeIntervalSince1970 * 1000) - request.foregroundText.capturedAtMs)
+    if request.foregroundText.available,
+       request.foregroundText.source == "text_input_client",
+       !request.foregroundText.surroundingBefore.isEmpty,
+       fallbackAgeMs <= 700 {
+      finishRagImeForegroundContextCapture(
+        request,
+        preliminaryFingerprint: preliminaryFingerprint,
+        snapshot: request.foregroundText.withFreshness(fallbackAgeMs),
+        captureReason: "text_input_client_synchronous_fallback_after_\(imkResult.failureReason)",
+        inputGeneration: inputGeneration,
+        sidecarClient: sidecarClient,
+        captureAttempt: captureAttempt
+      )
+      return
+    }
+    // Terminal-style clients often expose neither attributed text nor AX text.
+    // The same-app IME ledger only contains text committed through this input
+    // method, so it is a bounded and privacy-preserving fallback when the just
+    // committed text is visibly present in that ledger.
+    if request.foregroundText.available,
+       request.foregroundText.source == "ime_commit_ledger",
+       request.foregroundText.commitTextMatched,
+       request.foregroundText.sourceAppBundleId == currentApp,
+       request.foregroundText.inputSourceId == liveInputSourceId,
+       !request.foregroundText.surroundingBefore.isEmpty,
+       fallbackAgeMs <= 700 {
+      finishRagImeForegroundContextCapture(
+        request,
+        preliminaryFingerprint: preliminaryFingerprint,
+        snapshot: request.foregroundText.withFreshness(fallbackAgeMs),
+        captureReason: "same_app_commit_ledger_after_\(imkResult.failureReason)",
+        inputGeneration: inputGeneration,
+        sidecarClient: sidecarClient,
+        captureAttempt: captureAttempt
+      )
+      return
+    }
+
+    let captureToken = UUID()
+    ragImeForegroundCaptureToken = captureToken
+    ragImeForegroundContextQueue.async { [weak self] in
+      guard let self else { return }
+      let axResult = self.ragImeForegroundContextResolver.captureFromAccessibility(
+        captureEpoch: inputGeneration,
+        sourceAppBundleId: request.frontAppBundleId,
+        inputSourceId: request.inputSourceId
+      )
+      DispatchQueue.main.async { [weak self] in
+        guard let self, self.ragImeForegroundCaptureToken == captureToken else { return }
+        self.ragImeForegroundCaptureToken = nil
+        guard request.frontendRevision == self.ragImeFrontendRevision,
+              request.selectionEpoch == self.ragImeSelectionEpoch,
+              request.frontAppBundleId == self.currentApp,
+              request.inputSourceId == (SquirrelInstaller.currentInputSourceID() ?? "") else {
+          self.failRagImeForegroundContextCapture(
+            request,
+            fingerprint: preliminaryFingerprint,
+            reason: "capture_stale",
+            imkReason: imkResult.failureReason,
+            inputGeneration: inputGeneration
+          )
+          return
+        }
+        if let snapshot = axResult.snapshot {
+          self.finishRagImeForegroundContextCapture(
+            request,
+            preliminaryFingerprint: preliminaryFingerprint,
+            snapshot: snapshot,
+            captureReason: "accessibility_fallback_after_\(imkResult.failureReason)",
+            inputGeneration: inputGeneration,
+            sidecarClient: sidecarClient,
+            captureAttempt: captureAttempt
+          )
+        } else {
+          self.failRagImeForegroundContextCapture(
+            request,
+            fingerprint: preliminaryFingerprint,
+            reason: axResult.failureReason,
+            imkReason: imkResult.failureReason,
+            inputGeneration: inputGeneration
+          )
+        }
+      }
+    }
+    DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(ragImeForegroundCaptureTimeoutMs)) { [weak self] in
+      guard let self, self.ragImeForegroundCaptureToken == captureToken else { return }
+      self.ragImeForegroundCaptureToken = nil
+      self.failRagImeForegroundContextCapture(
+        request,
+        fingerprint: preliminaryFingerprint,
+        reason: "accessibility_capture_timeout",
+        imkReason: imkResult.failureReason,
+        inputGeneration: inputGeneration
+      )
+    }
+  }
+
+  func finishRagImeForegroundContextCapture(
+    _ request: RagImeSidecarRequest,
+    preliminaryFingerprint: String,
+    snapshot: RagImeForegroundTextSnapshot,
+    captureReason: String,
+    inputGeneration: Int,
+    sidecarClient: RagImeSidecarClient,
+    captureAttempt: Int
+  ) {
+    guard preliminaryFingerprint == ragImeLastRequestFingerprint,
+          request.frontendRevision == ragImeFrontendRevision,
+          request.selectionEpoch == ragImeSelectionEpoch else {
+      failRagImeForegroundContextCapture(
+        request,
+        fingerprint: preliminaryFingerprint,
+        reason: "capture_stale",
+        imkReason: captureReason,
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    let nowMs = Int(Date().timeIntervalSince1970 * 1000)
+    let freshnessMs = max(0, nowMs - snapshot.capturedAtMs)
+    let commitPreview = request.commitTextPreview.trimmingCharacters(in: .whitespacesAndNewlines)
+    let commitMatched = commitPreview.isEmpty || snapshot.surroundingBefore.contains(commitPreview)
+    if !commitMatched && captureAttempt == 0 {
+      traceRagImeFrontendEvent("foreground_context_capture_retry", fields: [
+        "requestSeq": request.requestSeq,
+        "captureEpoch": inputGeneration,
+        "retryAtMs": 120,
+        "reason": "commit_text_not_observed",
+      ])
+      DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(80)) { [weak self] in
+        self?.resolveRagImeForegroundContextAndSend(
+          request,
+          preliminaryFingerprint: preliminaryFingerprint,
+          inputGeneration: inputGeneration,
+          sidecarClient: sidecarClient,
+          captureAttempt: 1
+        )
+      }
+      return
+    }
+    guard commitMatched else {
+      failRagImeForegroundContextCapture(
+        request,
+        fingerprint: preliminaryFingerprint,
+        reason: "commit_text_not_observed",
+        imkReason: captureReason,
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    let freshSnapshot = snapshot.withCommitTextMatched(commitMatched).withFreshness(freshnessMs)
+    let resolvedContext = boundedRagImeCommittedContext(freshSnapshot.surroundingBefore)
+    guard freshSnapshot.available,
+          ["text_input_client", "accessibility", "ime_commit_ledger"].contains(freshSnapshot.source),
+          !resolvedContext.isEmpty else {
+      failRagImeForegroundContextCapture(
+        request,
+        fingerprint: preliminaryFingerprint,
+        reason: "foreground_context_empty",
+        imkReason: captureReason,
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    ragImeCommittedContext = resolvedContext
+    ragImeCommittedContextUpdatedAt = Date()
+    let resolvedRequest = request.withForegroundTransaction(
+      foregroundText: freshSnapshot,
+      committedContext: resolvedContext,
+      committedContextHash: ragImeStableTextHash(resolvedContext)
+    )
+    let resolvedFingerprint = ragImeRequestFingerprint(
+      rawInput: resolvedRequest.rawInput,
+      preedit: resolvedRequest.preedit,
+      commitTextPreview: resolvedRequest.commitTextPreview,
+      committedContext: resolvedRequest.committedContext,
+      foregroundText: resolvedRequest.foregroundText,
+      page: resolvedRequest.rimeContext.page,
+      highlighted: resolvedRequest.rimeContext.highlightedIndex,
+      candidates: resolvedRequest.rimeContext.candidates
+    )
+    ragImeLastRequestFingerprint = resolvedFingerprint
+    ragImePendingRequestFingerprint = resolvedFingerprint
+    traceRagImeFrontendEvent("foreground_context_capture_succeeded", fields: [
+      "requestSeq": resolvedRequest.requestSeq,
+      "inputGeneration": inputGeneration,
+      "captureEpoch": freshSnapshot.captureEpoch,
+      "capturedAtMs": freshSnapshot.capturedAtMs,
+      "freshnessMs": freshSnapshot.freshnessMs,
+      "source": freshSnapshot.source,
+      "reason": captureReason,
+      "sourceAppBundleId": freshSnapshot.sourceAppBundleId,
+      "inputSourceId": freshSnapshot.inputSourceId,
+      "surroundingBeforeChars": ragImeCompactWhitespace(freshSnapshot.surroundingBefore).count,
+      "surroundingAfterChars": ragImeCompactWhitespace(freshSnapshot.surroundingAfter).count,
+      "snapshotId": freshSnapshot.snapshotId,
+      "contextGroupId": freshSnapshot.contextGroupId,
+      "contextGroupLevel": freshSnapshot.contextGroupLevel,
+      "contextGroupConfidence": freshSnapshot.contextGroupConfidence,
+      "commitTextMatched": freshSnapshot.commitTextMatched,
+    ])
+    traceRagImeFrontendEvent("foreground_context_capture_resolved", fields: [
+      "requestSeq": resolvedRequest.requestSeq,
+      "snapshotId": freshSnapshot.snapshotId,
+      "source": freshSnapshot.source,
+      "contextGroupId": freshSnapshot.contextGroupId,
+      "compatibilityAlias": true,
+    ])
+    traceRagImeFrontendEvent("sidecar_request_scheduled", fields: [
+      "requestSeq": resolvedRequest.requestSeq,
+      "frontendRevision": resolvedRequest.frontendRevision,
+      "selectionEpoch": resolvedRequest.selectionEpoch,
+      "compositionHash": resolvedRequest.compositionHash,
+      "committedContextHash": resolvedRequest.committedContextHash,
+      "panelSessionId": resolvedRequest.panelSessionId,
+      "inputGeneration": inputGeneration,
+      "rawInput": resolvedRequest.rawInput,
+      "preedit": resolvedRequest.preedit,
+      "committedContextChars": resolvedRequest.committedContext.count,
+      "foregroundTextSource": freshSnapshot.source,
+      "foregroundTextAvailable": freshSnapshot.available,
+      "foregroundTextConfidence": freshSnapshot.confidence,
+      "foregroundTextFreshnessMs": freshSnapshot.freshnessMs,
+      "foregroundTextBeforeChars": ragImeCompactWhitespace(freshSnapshot.surroundingBefore).count,
+      "foregroundTextAfterChars": ragImeCompactWhitespace(freshSnapshot.surroundingAfter).count,
+      "foregroundTextWarnings": freshSnapshot.warnings,
+      "latencyBudgetMs": sidecarClient.latencyBudgetMs,
+      "maxVisibleCandidates": sidecarClient.maxVisibleCandidates,
+      "maxSideCandidates": sidecarClient.maxSideCandidates,
+      "forceSideCandidates": resolvedRequest.forceSideCandidates,
+      "candidateCount": resolvedRequest.rimeContext.candidates.count,
+    ])
+    sendRagImeSidecarRequest(
+      resolvedRequest,
+      fingerprint: resolvedFingerprint,
+      inputGeneration: inputGeneration,
+      sentAt: Date(),
+      sidecarClient: sidecarClient
+    )
+  }
+
+  func failRagImeForegroundContextCapture(
+    _ request: RagImeSidecarRequest,
+    fingerprint: String,
+    reason: String,
+    imkReason: String,
+    inputGeneration: Int
+  ) {
+    let traceEvent = reason.contains("stale") ? "foreground_context_rejected_stale" : "foreground_context_capture_failed"
+    traceRagImeFrontendEvent(traceEvent, fields: [
+      "requestSeq": request.requestSeq,
+      "frontendRevision": request.frontendRevision,
+      "selectionEpoch": request.selectionEpoch,
+      "inputGeneration": inputGeneration,
+      "captureEpoch": request.captureEpoch,
+      "frontAppBundleId": request.frontAppBundleId,
+      "inputSourceId": request.inputSourceId,
+      "reason": reason,
+      "imkReason": imkReason,
+    ])
+    completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: true)
+  }
+
+  func sendRagImeSidecarRequest(
+    _ request: RagImeSidecarRequest,
+    fingerprint: String,
+    inputGeneration: Int,
+    sentAt: Date,
+    sidecarClient: RagImeSidecarClient
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard(),
+      ragImePrivacyDisposition == "allowed",
+      request.privacyDisposition == "allowed",
+      request.frontAppBundleId == currentApp else { return }
+    guard fingerprint == ragImeLastRequestFingerprint else {
+      traceRagImeFrontendEvent("sidecar_response_dropped_stale", fields: [
+        "requestSeq": request.requestSeq,
+        "reason": "stale_before_send",
+        "requestRawInput": request.rawInput,
+        "requestPreedit": request.preedit,
+      ])
+      return
+    }
+    DispatchQueue.global(qos: .utility).async { [weak self] in
+      do {
+        let response = try sidecarClient.request(request)
+        DispatchQueue.main.async {
+          self?.applyRagImeSidecarResponse(
+            response,
+            for: request,
+            fingerprint: fingerprint,
+            inputGeneration: inputGeneration,
+            sentAt: sentAt
+          )
+        }
+      } catch {
+        print("RAG IME sidecar request failed: \(error)")
+        DispatchQueue.main.async {
+          guard let self else { return }
+          guard !self.enforceRagImeSensitiveFieldGuard() else {
+            self.completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: false)
+            return
+          }
+          self.traceRagImeFrontendEvent("sidecar_request_failed", fields: [
+            "requestSeq": request.requestSeq,
+            "rawInput": request.rawInput,
+            "preedit": request.preedit,
+            "error": String(describing: error),
+          ])
+          self.completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: false)
+        }
+      }
+    }
+  }
+
+  func applyRagImeSidecarResponse(
+    _ response: RagImeSidecarResponse,
+    for request: RagImeSidecarRequest,
+    fingerprint: String,
+    inputGeneration: Int,
+    sentAt: Date
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard() else {
+      completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: false)
+      return
+    }
+    let responseAgeMs = max(0, Int(Date().timeIntervalSince(sentAt) * 1000))
+    let phase = response.predictionSession?.phase ?? ""
+    let applyWindowMs = phase == "post_commit" ? ragImePostCommitResponseApplyWindowMs : ragImeActiveResponseApplyWindowMs
+    traceRagImeFrontendEvent("sidecar_response_received", fields: [
+      "requestSeq": response.requestSeq,
+      "frontendRevision": response.frontendRevision,
+      "selectionEpoch": response.selectionEpoch,
+      "compositionHash": response.compositionHash,
+      "committedContextHash": response.committedContextHash,
+      "panelSessionId": response.panelSessionId,
+      "displayCount": response.displayCandidates.count,
+      "responseAgeMs": responseAgeMs,
+    ])
+    guard responseAgeMs <= applyWindowMs else {
+      dropRagImeSidecarResponse(
+        "response_too_late_for_foreground",
+        response: response,
+        request: request,
+        fingerprint: fingerprint,
+        responseAgeMs: responseAgeMs,
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    guard response.requestSeq == request.requestSeq else {
+      dropRagImeSidecarResponse("request_seq_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.sessionId == request.sessionId else {
+      dropRagImeSidecarResponse("session_id_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.frontendRevision == request.frontendRevision else {
+      dropRagImeSidecarResponse("frontend_revision_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.selectionEpoch == request.selectionEpoch else {
+      dropRagImeSidecarResponse("selection_epoch_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.compositionHash == request.compositionHash else {
+      dropRagImeSidecarResponse("composition_hash_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.committedContextHash == request.committedContextHash else {
+      dropRagImeSidecarResponse("committed_context_hash_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.panelSessionId == request.panelSessionId else {
+      dropRagImeSidecarResponse("panel_session_mismatch", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard session != 0 && rimeAPI.find_session(session) else {
+      dropRagImeSidecarResponse("session_missing", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.frontendRevision == ragImeFrontendRevision else {
+      dropRagImeSidecarResponse("live_frontend_revision_changed", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard response.selectionEpoch == ragImeSelectionEpoch else {
+      dropRagImeSidecarResponse("live_selection_epoch_changed", response: response, request: request, fingerprint: fingerprint)
+      return
+    }
+    guard request.frontAppBundleId == currentApp else {
+      dropRagImeSidecarResponse("front_app_changed", response: response, request: request, fingerprint: fingerprint, clearDisplay: true)
+      return
+    }
+    let liveInputSourceId = SquirrelInstaller.currentInputSourceID() ?? ""
+    guard request.inputSourceId == liveInputSourceId else {
+      dropRagImeSidecarResponse("input_source_changed", response: response, request: request, fingerprint: fingerprint, clearDisplay: true)
+      return
+    }
+    let currentRawInput = rimeAPI.get_input(session).map { String(cString: $0) } ?? ""
+    let responseContainsRimeFallback = ragImeResponseContainsRimeFallback(response)
+    if inputGeneration != ragImeInputGeneration {
+      let canApplySideOnlyAcrossGeneration = !responseContainsRimeFallback
+        && currentRawInput == request.rawInput
+        && response.preedit == request.preedit
+        && response.committedContext == request.committedContext
+        && ragImeCommittedContext == request.committedContext
+      guard canApplySideOnlyAcrossGeneration else {
+        dropRagImeSidecarResponse(
+          "input_generation_changed",
+          response: response,
+          request: request,
+          fingerprint: fingerprint,
+          currentRawInput: currentRawInput,
+          responseAgeMs: responseAgeMs,
+          inputGeneration: inputGeneration
+        )
+        return
+      }
+      traceRagImeFrontendEvent("sidecar_input_generation_change_allowed", fields: [
+        "requestSeq": response.requestSeq,
+        "inputGeneration": inputGeneration,
+        "liveInputGeneration": ragImeInputGeneration,
+        "responseAgeMs": responseAgeMs,
+        "rawInput": response.rawInput,
+        "preedit": response.preedit,
+        "displayCount": response.displayCandidates.count,
+      ])
+    }
+    if fingerprint != ragImeLastRequestFingerprint {
+      if responseContainsRimeFallback || currentRawInput != request.rawInput || ragImeCommittedContext != request.committedContext {
+        traceRagImeFrontendEvent("sidecar_response_dropped_stale", fields: [
+          "requestSeq": response.requestSeq,
+          "reason": "stale_fingerprint",
+          "inputGeneration": inputGeneration,
+          "liveInputGeneration": ragImeInputGeneration,
+          "responseAgeMs": responseAgeMs,
+          "requestRawInput": request.rawInput,
+          "responseRawInput": response.rawInput,
+          "requestPreedit": request.preedit,
+          "responsePreedit": response.preedit,
+          "containsRimeFallback": responseContainsRimeFallback,
+        ])
+        return
+      }
+      traceRagImeFrontendEvent("sidecar_stale_fingerprint_allowed", fields: [
+        "requestSeq": response.requestSeq,
+        "inputGeneration": inputGeneration,
+        "liveInputGeneration": ragImeInputGeneration,
+        "responseAgeMs": responseAgeMs,
+        "rawInput": response.rawInput,
+        "preedit": response.preedit,
+        "displayCount": response.displayCandidates.count,
+      ])
+    }
+    guard currentRawInput == request.rawInput else {
+      dropRagImeSidecarResponse("raw_input_changed", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput, clearDisplay: true)
+      return
+    }
+    guard response.preedit == request.preedit else {
+      dropRagImeSidecarResponse("response_preedit_mismatch", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+      return
+    }
+    guard response.committedContext == request.committedContext else {
+      dropRagImeSidecarResponse("response_context_mismatch", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+      return
+    }
+    guard ragImeCommittedContext == request.committedContext else {
+      dropRagImeSidecarResponse("live_context_changed", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+      return
+    }
+    guard response.rimeContext.page == request.rimeContext.page else {
+      dropRagImeSidecarResponse("rime_page_changed", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+      return
+    }
+    var displayCandidatesToApply = response.candidatePanel?.candidates ?? response.displayCandidates.filter { candidate in
+      candidate.sourceType == "rime"
+    }
+    if let assistantOverlay = response.assistantOverlay, assistantOverlay.visible {
+      applyRagImeAssistantOverlay(
+        assistantOverlay,
+        semanticQuery: response.semanticQuery,
+        preedit: response.preedit,
+        traceEvent: "assistant_overlay_updated"
+      )
+    } else if response.rawInput.isEmpty && response.preedit.isEmpty {
+      let dismissReason = response.assistantOverlay?.dismissReason ?? "post_commit_overlay_hidden"
+      if dismissReason == "pending_overlay_disabled", ragImeAssistantOverlayController.isVisible {
+        traceRagImeFrontendEvent("assistant_overlay_hidden_update_ignored", fields: [
+          "reason": "keep_local_placeholder_until_progressive_result",
+          "dismissReason": dismissReason,
+          "requestSeq": response.requestSeq,
+          "panelSessionId": response.panelSessionId,
+        ])
+      } else {
+        dismissRagImeAssistantOverlay(reason: dismissReason)
+      }
+    }
+    if ragImeCandidateFingerprint(response.rimeContext.candidates) != ragImeCandidateFingerprint(request.rimeContext.candidates) {
+      if responseContainsRimeFallback {
+        let sideOnlyCandidates = displayCandidatesToApply.filter { candidate in
+          candidate.sourceType != "rime" && candidate.selectionAction != "select_rime_candidate"
+        }
+        if sideOnlyCandidates.isEmpty {
+          dropRagImeSidecarResponse("rime_candidates_changed", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+          return
+        }
+        displayCandidatesToApply = sideOnlyCandidates
+        traceRagImeFrontendEvent("sidecar_rime_fallback_stripped", fields: [
+          "requestSeq": response.requestSeq,
+          "rawInput": response.rawInput,
+          "preedit": response.preedit,
+          "originalDisplayCount": response.displayCandidates.count,
+          "sideDisplayCount": displayCandidatesToApply.count,
+        ])
+      }
+      traceRagImeFrontendEvent("sidecar_rime_candidate_change_allowed", fields: [
+        "requestSeq": response.requestSeq,
+        "rawInput": response.rawInput,
+        "preedit": response.preedit,
+        "displayCount": displayCandidatesToApply.count,
+      ])
+    }
+    guard currentRagImeContextMatches(request, requireRimeFallback: responseContainsRimeFallback) else {
+      dropRagImeSidecarResponse("rime_context_changed", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput)
+      return
+    }
+    guard !displayCandidatesToApply.isEmpty else {
+      let shouldClearEmptyResponse = response.predictionSession?.shouldClearPredictionPanel == true
+      if shouldClearEmptyResponse {
+        clearRagImeDisplayCandidates()
+      }
+      traceRagImeFrontendEvent("sidecar_empty_response_cleared", fields: [
+        "requestSeq": response.requestSeq,
+        "rawInput": response.rawInput,
+        "preedit": response.preedit,
+        "semanticQuery": response.semanticQuery,
+        "queryBasis": response.queryBasis,
+        "triggerReason": response.triggerDecision?.reason ?? "",
+        "cleared": shouldClearEmptyResponse,
+        "keptExistingPanel": !shouldClearEmptyResponse,
+      ])
+      let shouldKeepFingerprintForFollowUp = response.progressive?.enabled == true
+        && response.progressive?.shouldFollowUp == true
+      let assistantOverlayHasCandidates = response.assistantOverlay?.visible == true
+        && !(response.assistantOverlay?.candidates.isEmpty ?? true)
+      if request.rawInput.isEmpty,
+        request.preedit.isEmpty,
+        !shouldKeepFingerprintForFollowUp,
+        !assistantOverlayHasCandidates,
+        ragImeBoolEnvEnabled("RAG_IME_ENABLE_POST_COMMIT_AUTO_MODEL", default: true) {
+        showRagImeAssistantOverlayFeedback(
+          statusText: "这次没有合适建议",
+          snapshotId: "no-result:\(request.panelSessionId):\(response.requestSeq)",
+          semanticQuery: response.semanticQuery,
+          expiresAfterMs: 1_200,
+          animated: false
+        )
+        traceRagImeFrontendEvent("assistant_overlay_no_result_feedback", fields: [
+          "requestSeq": response.requestSeq,
+          "panelSessionId": request.panelSessionId,
+          "expiresAfterMs": 1200,
+        ])
+      }
+      completeRagImeSidecarRequest(
+        fingerprint: fingerprint,
+        keepLastFingerprint: shouldKeepFingerprintForFollowUp
+      )
+      scheduleRagImeProgressiveFollowUpIfNeeded(
+        response: response,
+        request: request,
+        fingerprint: fingerprint,
+        inputGeneration: inputGeneration
+      )
+      return
+    }
+    if response.predictionSession?.shouldClearPredictionPanel == true {
+      clearRagImeDisplayCandidates()
+      traceRagImeFrontendEvent("sidecar_clear_response_applied", fields: [
+        "requestSeq": response.requestSeq,
+        "rawInput": response.rawInput,
+        "preedit": response.preedit,
+        "semanticQuery": response.semanticQuery,
+        "queryBasis": response.queryBasis,
+        "phase": response.predictionSession?.phase ?? "",
+        "clearReason": response.predictionSession?.clearReason ?? "",
+        "sessionFingerprint": response.predictionSession?.sessionFingerprint ?? "",
+      ])
+      completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: false)
+      return
+    }
+    let responseSessionFingerprint = response.predictionSession?.sessionFingerprint ?? ""
+    if !responseSessionFingerprint.isEmpty && !displayCandidatesToApply.allSatisfy({ ragImeDisplayCandidateSessionFingerprint($0) == responseSessionFingerprint }) {
+      dropRagImeSidecarResponse("candidate_session_fingerprint_mismatch", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput, clearDisplay: true)
+      return
+    }
+    guard displayCandidatesToApply.allSatisfy({ ragImeDisplayCandidateMatchesTransaction($0, response: response) }) else {
+      dropRagImeSidecarResponse("candidate_frontend_transaction_mismatch", response: response, request: request, fingerprint: fingerprint, currentRawInput: currentRawInput, clearDisplay: true)
+      return
+    }
+
+    ragImeDisplayCandidates = displayCandidatesToApply
+    ragImePanelUsesDisplayCandidates = !displayCandidatesToApply.isEmpty
+    ragImeDisplayRawInput = response.rawInput
+    ragImeDisplayPreedit = response.preedit
+    ragImeDisplaySemanticQuery = response.semanticQuery
+    ragImeDisplayQueryBasis = response.queryBasis
+    ragImeDisplayUpdatedAt = Date()
+    ragImeDisplaySessionFingerprint = responseSessionFingerprint
+    ragImeDisplaySnapshotId = response.predictionSession?.snapshotId ?? response.predictionSession?.stableSnapshotId ?? ""
+    ragImeDisplayNumberKeyPolicy = response.keyPolicy?.numberKeys ?? ""
+    ragImeDisplayTabPolicy = response.keyPolicy?.tab ?? ""
+    ragImeDisplayOptionNumberPolicy = response.keyPolicy?.optionNumber ?? ""
+    ragImeDisplayPanelSessionId = response.panelSessionId
+    ragImeDisplayCompositionHash = response.compositionHash
+    ragImeDisplayCommittedContextHash = response.committedContextHash
+    ragImeDisplayContextGroupId = request.foregroundText.contextGroupId
+    ragImeDisplayContextGroupLevel = request.foregroundText.contextGroupLevel
+    if let expiresAfterMs = response.predictionSession?.expiresAfterMs, expiresAfterMs > 0 {
+      ragImeDisplayExpiresAt = Date().addingTimeInterval(TimeInterval(expiresAfterMs) / 1000)
+    } else {
+      ragImeDisplayExpiresAt = nil
+    }
+    scheduleRagImeDisplayExpiry()
+    traceRagImeFrontendEvent("sidecar_response_applied", fields: [
+      "requestSeq": response.requestSeq,
+      "frontendRevision": response.frontendRevision,
+      "selectionEpoch": response.selectionEpoch,
+      "compositionHash": response.compositionHash,
+      "committedContextHash": response.committedContextHash,
+      "panelSessionId": response.panelSessionId,
+      "rawInput": response.rawInput,
+      "preedit": response.preedit,
+      "semanticQuery": response.semanticQuery,
+      "queryBasis": response.queryBasis,
+      "displayCount": displayCandidatesToApply.count,
+      "panelUsesDisplayCandidates": ragImePanelUsesDisplayCandidates,
+      "inputGeneration": inputGeneration,
+      "responseAgeMs": responseAgeMs,
+      "applyWindowMs": applyWindowMs,
+      "latencyBudgetMs": response.latencyBudgetMs,
+      "uiMode": response.uiMode ?? "",
+      "laneStatus": response.laneStatus.map { ragImeJSONValueDictionary($0) } ?? [:],
+      "predictionSession": [
+        "phase": response.predictionSession?.phase ?? "",
+        "selectionScope": response.predictionSession?.selectionScope ?? "",
+        "sessionFingerprint": ragImeDisplaySessionFingerprint,
+        "frontendRevision": response.predictionSession?.frontendRevision ?? response.frontendRevision,
+        "selectionEpoch": response.predictionSession?.selectionEpoch ?? response.selectionEpoch,
+        "panelSessionId": response.predictionSession?.panelSessionId ?? response.panelSessionId,
+        "expiresAfterMs": response.predictionSession?.expiresAfterMs ?? 0,
+      ],
+      "candidateCounts": ragImeTraceCandidateCounts(),
+      "candidates": ragImeTraceCandidateSummaries(),
+      "progressive": ragImeTraceProgressive(response.progressive),
+    ])
+    traceRagImePredictionEvents(response.predictionTraceEvents)
+    if phase == "post_commit" {
+      traceRagImeFrontendEvent("post_commit_prediction_applied", fields: [
+        "requestSeq": response.requestSeq,
+        "frontendRevision": response.frontendRevision,
+        "selectionEpoch": response.selectionEpoch,
+        "compositionHash": response.compositionHash,
+        "committedContextHash": response.committedContextHash,
+        "panelSessionId": response.panelSessionId,
+        "displayCount": displayCandidatesToApply.count,
+        "candidateCounts": ragImeTraceCandidateCounts(),
+      ])
+    }
+    completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: true)
+    scheduleRagImeProgressiveFollowUpIfNeeded(
+      response: response,
+      request: request,
+      fingerprint: fingerprint,
+      inputGeneration: inputGeneration
+    )
+    rimeUpdate(clearReservedComments: false, requestSidecar: false)
+  }
+
+  func scheduleRagImeProgressiveFollowUpIfNeeded(
+    response: RagImeSidecarResponse,
+    request: RagImeSidecarRequest,
+    fingerprint: String,
+    inputGeneration: Int
+  ) {
+    guard let progressive = response.progressive,
+          progressive.enabled,
+          progressive.shouldFollowUp else {
+      return
+    }
+    let retryAfterMs = max(80, min(1500, progressive.retryAfterMs))
+    let pendingLanes = progressive.pendingLanes
+    let workItem = DispatchWorkItem { [weak self] in
+      guard let self else { return }
+      guard fingerprint == self.ragImeLastRequestFingerprint else {
+        self.traceRagImeFrontendEvent("sidecar_progressive_followup_skipped", fields: [
+          "requestSeq": request.requestSeq,
+          "reason": "stale_fingerprint",
+          "inputGeneration": inputGeneration,
+          "liveInputGeneration": self.ragImeInputGeneration,
+          "pendingLanes": pendingLanes,
+        ])
+        return
+      }
+      let currentRawInput = self.rimeAPI.get_input(self.session).map { String(cString: $0) } ?? ""
+      if inputGeneration != self.ragImeInputGeneration {
+        guard currentRawInput == request.rawInput else {
+          self.traceRagImeFrontendEvent("sidecar_progressive_followup_skipped", fields: [
+            "requestSeq": request.requestSeq,
+            "reason": "input_generation_changed",
+            "inputGeneration": inputGeneration,
+            "liveInputGeneration": self.ragImeInputGeneration,
+            "currentRawInput": currentRawInput,
+            "pendingLanes": pendingLanes,
+          ])
+          return
+        }
+        self.traceRagImeFrontendEvent("sidecar_progressive_generation_change_allowed", fields: [
+          "requestSeq": request.requestSeq,
+          "inputGeneration": inputGeneration,
+          "liveInputGeneration": self.ragImeInputGeneration,
+          "rawInput": request.rawInput,
+          "pendingLanes": pendingLanes,
+        ])
+      }
+      guard self.ragImeCommittedContext == request.committedContext else {
+        self.traceRagImeFrontendEvent("sidecar_progressive_followup_skipped", fields: [
+          "requestSeq": request.requestSeq,
+          "reason": "live_context_changed",
+          "pendingLanes": pendingLanes,
+        ])
+        return
+      }
+      guard let sidecarClient = self.ragImeSidecarClient else {
+        self.traceRagImeFrontendEvent("sidecar_progressive_followup_skipped", fields: [
+          "requestSeq": request.requestSeq,
+          "reason": "sidecar_not_configured",
+          "pendingLanes": pendingLanes,
+        ])
+        return
+      }
+      let followUpRequest = RagImeSidecarRequest(
+        frontendBuild: request.frontendBuild,
+        schemaVersion: request.schemaVersion,
+        predictionFirstMerge: request.predictionFirstMerge,
+        sessionId: request.sessionId,
+        requestSeq: request.requestSeq,
+        inputGeneration: request.inputGeneration,
+        createdAtMs: request.createdAtMs,
+        frontendRevision: request.frontendRevision,
+        selectionEpoch: request.selectionEpoch,
+        frontAppBundleId: request.frontAppBundleId,
+        inputSourceId: request.inputSourceId,
+        compositionHash: request.compositionHash,
+        committedContextHash: request.committedContextHash,
+        panelSessionId: request.panelSessionId,
+        capturedAtMs: request.capturedAtMs,
+        sourceAppBundleId: request.sourceAppBundleId,
+        captureEpoch: request.captureEpoch,
+        captureFailureReason: request.captureFailureReason,
+        privacyDisposition: request.privacyDisposition,
+        rawInput: request.rawInput,
+        preedit: request.preedit,
+        commitTextPreview: request.commitTextPreview,
+        committedContext: request.committedContext,
+        project: request.project,
+        latencyBudgetMs: request.latencyBudgetMs,
+        maxVisibleCandidates: request.maxVisibleCandidates,
+        maxSideCandidates: request.maxSideCandidates,
+        forceSideCandidates: request.forceSideCandidates,
+        commitBurstReady: request.commitBurstReady,
+        acceptedCandidateContinuation: request.acceptedCandidateContinuation,
+        commitBurstDeltaChars: request.commitBurstDeltaChars,
+        commitBurstTexts: request.commitBurstTexts,
+        progressiveFollowUp: true,
+        foregroundText: request.foregroundText,
+        rimeContext: request.rimeContext
+      )
+      self.ragImePendingRequestFingerprint = fingerprint
+      self.traceRagImeFrontendEvent("sidecar_progressive_followup_sent", fields: [
+        "requestSeq": request.requestSeq,
+        "inputGeneration": inputGeneration,
+        "retryAfterMs": retryAfterMs,
+        "pendingLanes": pendingLanes,
+      ])
+      self.sendRagImeSidecarRequest(
+        followUpRequest,
+        fingerprint: fingerprint,
+        inputGeneration: inputGeneration,
+        sentAt: Date(),
+        sidecarClient: sidecarClient
+      )
+    }
+    ragImePendingRequestWorkItem?.cancel()
+    // An empty first response may clear the visible panel and its display
+    // fingerprint. The progressive poll still belongs to the live foreground
+    // transaction, so restore the request fingerprint before its stale guard.
+    ragImeLastRequestFingerprint = fingerprint
+    ragImePendingRequestFingerprint = fingerprint
+    ragImePendingRequestWorkItem = workItem
+    traceRagImeFrontendEvent("sidecar_progressive_followup_scheduled", fields: [
+      "requestSeq": request.requestSeq,
+      "inputGeneration": inputGeneration,
+      "retryAfterMs": retryAfterMs,
+      "pendingLanes": pendingLanes,
+      "partial": progressive.partial,
+    ])
+    DispatchQueue.main.asyncAfter(deadline: .now() + TimeInterval(retryAfterMs) / 1000, execute: workItem)
+  }
+
+  func dropRagImeSidecarResponse(
+    _ reason: String,
+    response: RagImeSidecarResponse,
+    request: RagImeSidecarRequest,
+    fingerprint: String,
+    currentRawInput: String = "",
+    clearDisplay: Bool = false,
+    responseAgeMs: Int = 0,
+    inputGeneration: Int? = nil
+  ) {
+    if clearDisplay {
+      clearRagImeDisplayCandidates()
+    }
+    traceRagImeFrontendEvent("sidecar_response_dropped_stale", fields: [
+      "requestSeq": response.requestSeq,
+      "requestFrontendRevision": request.frontendRevision,
+      "responseFrontendRevision": response.frontendRevision,
+      "liveFrontendRevision": ragImeFrontendRevision,
+      "requestSelectionEpoch": request.selectionEpoch,
+      "responseSelectionEpoch": response.selectionEpoch,
+      "liveSelectionEpoch": ragImeSelectionEpoch,
+      "requestCompositionHash": request.compositionHash,
+      "responseCompositionHash": response.compositionHash,
+      "requestCommittedContextHash": request.committedContextHash,
+      "responseCommittedContextHash": response.committedContextHash,
+      "requestPanelSessionId": request.panelSessionId,
+      "responsePanelSessionId": response.panelSessionId,
+      "reason": reason,
+      "requestRawInput": request.rawInput,
+      "responseRawInput": response.rawInput,
+      "currentRawInput": currentRawInput,
+      "requestPreedit": request.preedit,
+      "responsePreedit": response.preedit,
+      "requestCommittedContextChars": request.committedContext.count,
+      "liveCommittedContextChars": ragImeCommittedContext.count,
+      "inputGeneration": inputGeneration ?? ragImeInputGeneration,
+      "liveInputGeneration": ragImeInputGeneration,
+      "responseAgeMs": responseAgeMs,
+      "displayCount": response.displayCandidates.count,
+      "cleared": clearDisplay,
+    ])
+    completeRagImeSidecarRequest(fingerprint: fingerprint, keepLastFingerprint: false)
+  }
+
+  func completeRagImeSidecarRequest(fingerprint: String, keepLastFingerprint: Bool) {
+    if ragImePendingRequestFingerprint == fingerprint {
+      ragImePendingRequestFingerprint = ""
+    }
+    if !keepLastFingerprint && ragImeLastRequestFingerprint == fingerprint {
+      ragImeLastRequestFingerprint = ""
+    }
+  }
+
+  func currentRagImeContextMatches(_ request: RagImeSidecarRequest, requireRimeFallback: Bool = true) -> Bool {
+    var ctx = RimeContext_stdbool.rimeStructInit()
+    guard rimeAPI.get_context(session, &ctx) else { return false }
+    defer { _ = rimeAPI.free_context(&ctx) }
+    let currentPreedit = ctx.composition.preedit.map({ String(cString: $0) }) ?? ""
+    guard currentPreedit == request.preedit else { return false }
+    if !requireRimeFallback {
+      return true
+    }
+    guard Int(ctx.menu.page_no) == request.rimeContext.page else { return false }
+    return true
+  }
+
+  func ragImeRequestFingerprint(
+    rawInput: String,
+    preedit: String,
+    commitTextPreview: String,
+    committedContext: String,
+    foregroundText: RagImeForegroundTextSnapshot,
+    page: Int,
+    highlighted: Int,
+    candidates: [RagImeRimeCandidatePayload]
+  ) -> String {
+    return [
+      rawInput,
+      preedit,
+      commitTextPreview,
+      committedContext,
+      foregroundText.source,
+      foregroundText.selectedTextHash,
+      ragImeStableTextHash(foregroundText.surroundingBefore),
+      ragImeStableTextHash(foregroundText.surroundingAfter),
+      foregroundText.wholeValueHash,
+      String(foregroundText.wholeValueChars),
+      String(page),
+      String(highlighted),
+      ragImeCandidateFingerprint(candidates)
+    ].joined(separator: "\u{1f}")
+  }
+
+  func ragImeCandidateFingerprint(_ candidates: [RagImeRimeCandidatePayload]) -> String {
+    return candidates.prefix(4).map { item in
+      [item.label, item.text, item.comment, String(item.index ?? -1)].joined(separator: "\u{1e}")
+    }.joined(separator: "\u{1f}")
+  }
+
+  func ragImeResponseContainsRimeFallback(_ response: RagImeSidecarResponse) -> Bool {
+    return response.displayCandidates.contains { candidate in
+      candidate.sourceType == "rime" || candidate.selectionAction == "select_rime_candidate"
+    }
+  }
+
+  func ragImeDisplayCandidatesContainComposableSideCandidate() -> Bool {
+    return ragImeDisplayCandidates.contains { candidate in
+      let selectionScope = ragImeJSONValueString(candidate.metadata["selectionScope"]) ?? ""
+      return candidate.selectionAction == "commit_side_candidate"
+        && selectionScope == "mixed_prediction_first"
+        && candidate.sourceType != "raw_english"
+    }
+  }
+
+  func mergedRagImePanelCandidates(
+    rawInput: String,
+    preedit: String,
+    fallbackCandidates: [String],
+    fallbackComments: [String],
+    fallbackLabels: [String]
+  ) -> (candidates: [String], comments: [String], labels: [String]) {
+    ragImePanelUsesDisplayCandidates = false
+    guard !ragImeDisplayCandidates.isEmpty else {
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    if rawInput.isEmpty && preedit.isEmpty {
+      guard canUseRagImePostCommitDisplayHoldover(fallbackCandidates: fallbackCandidates) else {
+        clearRagImeDisplayCandidates()
+        return (fallbackCandidates, fallbackComments, fallbackLabels)
+      }
+      ragImePanelUsesDisplayCandidates = true
+      traceRagImeFrontendEvent("panel_display_candidates", fields: [
+        "rawInput": rawInput,
+        "preedit": preedit,
+        "exactMatch": true,
+        "holdover": true,
+        "postCommitHoldover": true,
+        "forcesHorizontalLayout": ragImePanelForcesHorizontalLayout(),
+        "forcesVerticalList": ragImePanelForcesVerticalList(),
+        "candidateCounts": ragImeTraceCandidateCounts(),
+        "candidates": ragImeTraceCandidateSummaries(),
+      ])
+      return ragImeDisplayPanelPayload(fallbackLabels: fallbackLabels)
+    }
+    let exactMatch = ragImeDisplayRawInput == rawInput && ragImeDisplayPreedit == preedit
+    let canHold = canUseRagImeDisplayHoldover(
+      rawInput: rawInput,
+      preedit: preedit,
+      fallbackCandidates: fallbackCandidates
+    )
+    if !rawInput.isEmpty
+      && !ragImeDisplayCandidates.contains(where: { $0.sourceType == "raw_english" })
+      && !ragImeDisplayCandidatesContainComposableSideCandidate() {
+      clearRagImeDisplayCandidates()
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    guard exactMatch || canHold else {
+      clearRagImeDisplayCandidates()
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    ragImePanelUsesDisplayCandidates = true
+    traceRagImeFrontendEvent("panel_display_candidates", fields: [
+      "rawInput": rawInput,
+      "preedit": preedit,
+      "exactMatch": exactMatch,
+      "holdover": canHold,
+      "forcesHorizontalLayout": ragImePanelForcesHorizontalLayout(),
+      "forcesVerticalList": ragImePanelForcesVerticalList(),
+      "candidateCounts": ragImeTraceCandidateCounts(),
+      "candidates": ragImeTraceCandidateSummaries(),
+    ])
+    return ragImeDisplayPanelPayload(fallbackLabels: fallbackLabels)
+  }
+
+  func canUseRagImeDisplayHoldover(
+    rawInput: String,
+    preedit: String,
+    fallbackCandidates: [String],
+    now: Date = Date()
+  ) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    guard !rawInput.isEmpty || !preedit.isEmpty else { return false }
+    guard ragImeDisplayRawInput == rawInput && ragImeDisplayPreedit == preedit else { return false }
+    return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImeDisplayHoldoverDuration
+  }
+
+  func canUseRagImePostCommitDisplayHoldover(
+    fallbackCandidates: [String],
+    now: Date = Date()
+  ) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    guard ragImeDisplayRawInput.isEmpty && ragImeDisplayPreedit.isEmpty else { return false }
+    guard fallbackCandidates.isEmpty else { return false }
+    return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImePostCommitDisplayHoldoverDuration
+  }
+
+  func canSelectCurrentRagImeDisplayCandidates(now: Date = Date()) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    let currentRawInput = rimeAPI.get_input(session).map { String(cString: $0) } ?? ""
+    if currentRawInput.isEmpty && ragImeDisplayRawInput.isEmpty && ragImeDisplayPreedit.isEmpty {
+      return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImePostCommitDisplayHoldoverDuration
+    }
+    guard !currentRawInput.isEmpty else { return false }
+    return currentRawInput == ragImeDisplayRawInput
+  }
+
+  func isRagImeDeleteKey(_ keyCode: UInt16, modifiers: NSEvent.ModifierFlags) -> Bool {
+    guard !modifiers.contains(.command), !modifiers.contains(.control), !modifiers.contains(.option) else {
+      return false
+    }
+    return keyCode == 51 || keyCode == 117
+  }
+
+  func matchesRagImeActiveRagShortcut(_ keyCode: UInt16, modifiers: NSEvent.ModifierFlags) -> Bool {
+    let shortcut = ragImeActiveRagShortcutSetting()
+    let parts = Set(shortcut.split(separator: "+").map { String($0).lowercased() })
+    guard let keyName = parts.first(where: { !["cmd", "command", "ctrl", "control", "option", "alt", "shift"].contains($0) }) else {
+      return false
+    }
+    guard ragImeShortcutKeyMatches(keyName, keyCode: keyCode) else { return false }
+    if parts.contains("ctrl") || parts.contains("control") {
+      guard modifiers.contains(.control) else { return false }
+    } else if modifiers.contains(.control) {
+      return false
+    }
+    if parts.contains("option") || parts.contains("alt") {
+      guard modifiers.contains(.option) else { return false }
+    } else if modifiers.contains(.option) {
+      return false
+    }
+    if parts.contains("cmd") || parts.contains("command") {
+      guard modifiers.contains(.command) else { return false }
+    } else if modifiers.contains(.command) {
+      return false
+    }
+    if parts.contains("shift") {
+      guard modifiers.contains(.shift) else { return false }
+    } else if modifiers.contains(.shift) {
+      return false
+    }
+    return true
+  }
+
+  func ragImeActiveRagShortcutSetting() -> String {
+    let defaultsValue = UserDefaults.standard.string(forKey: "RagImeActiveRagShortcut") ?? ""
+    let envValue = ProcessInfo.processInfo.environment["RAG_IME_ACTIVE_RAG_SHORTCUT"] ?? ""
+    let raw = defaultsValue.isEmpty ? envValue : defaultsValue
+    return raw.isEmpty ? "ctrl+." : raw.lowercased().replacingOccurrences(of: " ", with: "")
+  }
+
+  func requireRagImeActiveRagEnabled(trigger: String) -> Bool {
+    let enabled = ragImeBooleanSetting(
+      userDefaultsKey: "RagImeActiveRagEnabled",
+      environmentKey: "RAG_IME_ACTIVE_RAG_ENABLED",
+      defaultValue: true
+    )
+    guard enabled else {
+      cancelRagImeActiveRagSession(reason: "active_rag_disabled")
+      traceRagImeFrontendEvent("active_rag_start_rejected", fields: [
+        "reason": "active_rag_disabled",
+        "trigger": trigger,
+        "traceIncludesText": false,
+      ])
+      return false
+    }
+    return true
+  }
+
+  func ragImeActiveRagAccessibilityCaptureEnabled() -> Bool {
+    return ragImeBooleanSetting(
+      userDefaultsKey: "RagImeActiveRagCaptureAccessibility",
+      environmentKey: "RAG_IME_ACTIVE_RAG_CAPTURE_ACCESSIBILITY",
+      defaultValue: true
+    )
+  }
+
+  func ragImeActiveRagClipboardFallbackEnabled() -> Bool {
+    return ragImeBooleanSetting(
+      userDefaultsKey: "RagImeActiveRagCaptureClipboardFallback",
+      environmentKey: "RAG_IME_ACTIVE_RAG_CAPTURE_CLIPBOARD_FALLBACK",
+      defaultValue: true
+    )
+  }
