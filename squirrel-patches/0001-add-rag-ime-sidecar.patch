+  func isRagImeDeleteKey(_ keyCode: UInt16, modifiers: NSEvent.ModifierFlags) -> Bool {
+    guard !modifiers.contains(.command), !modifiers.contains(.control), !modifiers.contains(.option) else {
+      return false
+    }
+    return keyCode == 51 || keyCode == 117
+  }
+
+  func matchesRagImeActiveRagShortcut(_ keyCode: UInt16, modifiers: NSEvent.ModifierFlags) -> Bool {
+    let shortcut = ragImeActiveRagShortcutSetting()
+    let parts = Set(shortcut.split(separator: "+").map { String($0).lowercased() })
+    guard let keyName = parts.first(where: { !["cmd", "command", "ctrl", "control", "option", "alt", "shift"].contains($0) }) else {
+      return false
+    }
+    guard ragImeShortcutKeyMatches(keyName, keyCode: keyCode) else { return false }
+    if parts.contains("ctrl") || parts.contains("control") {
+      guard modifiers.contains(.control) else { return false }
+    } else if modifiers.contains(.control) {
+      return false
+    }
+    if parts.contains("option") || parts.contains("alt") {
+      guard modifiers.contains(.option) else { return false }
+    } else if modifiers.contains(.option) {
+      return false
+    }
+    if parts.contains("cmd") || parts.contains("command") {
+      guard modifiers.contains(.command) else { return false }
+    } else if modifiers.contains(.command) {
+      return false
+    }
+    if parts.contains("shift") {
+      guard modifiers.contains(.shift) else { return false }
+    } else if modifiers.contains(.shift) {
+      return false
+    }
+    return true
+  }
+
+  func ragImeActiveRagShortcutSetting() -> String {
+    let defaultsValue = UserDefaults.standard.string(forKey: "RagImeActiveRagShortcut") ?? ""
+    let envValue = ProcessInfo.processInfo.environment["RAG_IME_ACTIVE_RAG_SHORTCUT"] ?? ""
+    let raw = defaultsValue.isEmpty ? envValue : defaultsValue
+    return raw.isEmpty ? "ctrl+." : raw.lowercased().replacingOccurrences(of: " ", with: "")
+  }
