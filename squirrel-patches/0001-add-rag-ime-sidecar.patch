+  func ragImeRequestFingerprint(
+    rawInput: String,
+    preedit: String,
+    commitTextPreview: String,
+    committedContext: String,
+    foregroundText: RagImeForegroundTextSnapshot,
+    page: Int,
+    highlighted: Int,
+    candidates: [RagImeRimeCandidatePayload]
+  ) -> String {
+    return [
+      rawInput,
+      preedit,
+      commitTextPreview,
+      committedContext,
+      foregroundText.source,
+      foregroundText.selectedTextHash,
+      ragImeStableTextHash(foregroundText.surroundingBefore),
+      ragImeStableTextHash(foregroundText.surroundingAfter),
+      foregroundText.wholeValueHash,
+      String(foregroundText.wholeValueChars),
