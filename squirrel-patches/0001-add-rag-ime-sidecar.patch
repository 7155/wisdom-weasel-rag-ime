+  func ragImeNativeCompositionIsActive() -> Bool {
+    guard session != 0 && rimeAPI.find_session(session) else { return false }
+    var status = RimeStatus_stdbool.rimeStructInit()
+    guard rimeAPI.get_status(session, &status) else { return false }
+    let composing = status.is_composing
+    _ = rimeAPI.free_status(&status)
+    return composing
