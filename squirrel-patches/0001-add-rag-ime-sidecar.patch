+  func scheduleRagImeActiveRagStatusPoll(
+    request: RagImeActiveRagRequest,
+    response: RagImeActiveRagResponse,
+    attempt: Int
+  ) {
+    guard attempt <= 80 else { return }
+    guard response.status == "pending" || response.thinkingRow else { return }
+    guard let sidecarClient = ragImeSidecarClient else { return }
+    let serverDelayMs = response.pollAfterMs ?? 0
+    let delayMs = serverDelayMs > 0 ? min(max(serverDelayMs, 120), 1200) : (attempt <= 3 ? 160 : 300)
+    traceRagImeFrontendEvent("active_rag_status_poll_scheduled", fields: [
+      "sessionId": response.sessionId,
+      "attempt": attempt,
+      "delayMs": delayMs,
+      "selectedTextHash": request.selectedTextHash,
+      "selectedTextChars": request.selectedTextChars,
+      "frontendRevision": request.frontendRevision,
+      "selectionEpoch": request.selectionEpoch,
+      "panelSessionId": request.panelSessionId,
+      "frontAppBundleId": request.frontAppBundleId,
+      "traceIncludesText": false,
+    ])
+    DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(delayMs)) { [weak self] in
+      guard let self else { return }
+      guard self.ragImeActiveRagSelectedTextHash == request.selectedTextHash
+        && self.ragImeActiveRagFrontendRevision == request.frontendRevision
+        && self.ragImeActiveRagSelectionEpoch == request.selectionEpoch else {
+        self.traceRagImeFrontendEvent("active_rag_status_poll_cancelled", fields: [
+          "reason": "active_rag_anchor_changed",
+          "attempt": attempt,
+          "selectedTextHash": request.selectedTextHash,
+          "selectedTextChars": request.selectedTextChars,
+          "frontendRevision": request.frontendRevision,
+          "selectionEpoch": request.selectionEpoch,
+          "panelSessionId": request.panelSessionId,
+          "frontAppBundleId": request.frontAppBundleId,
+          "traceIncludesText": false,
+        ])
+        return
+      }
+      sidecarClient.postActiveRagStatus(sessionId: response.sessionId, request: request) { [weak self] nextResponse in
+        guard let self else { return }
+        self.applyRagImeActiveRagResponse(nextResponse, request: request)
+        if nextResponse.status == "pending" || nextResponse.thinkingRow {
+          self.scheduleRagImeActiveRagStatusPoll(request: request, response: nextResponse, attempt: attempt + 1)
         }
