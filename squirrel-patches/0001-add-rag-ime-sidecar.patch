+//
+//  RagImeSelectedTextProvider.swift
+//  Squirrel
+//
+
+import AppKit
+import ApplicationServices
+import Carbon
+import CryptoKit
+import Foundation
+import InputMethodKit
+
+struct RagImeSelectedTextCapture {
+  let selectedText: String
+  let selectedTextHash: String
+  let selectedTextChars: Int
+  let selectedTextPreview: String
+  let surroundingBefore: String
+  let surroundingAfter: String
+  let canReplaceSelection: Bool
+  let captureEpoch: Int
+  let captureSource: String
+}
+
+struct RagImeForegroundTextCaptureResult {
+  let snapshot: RagImeForegroundTextSnapshot?
+  let failureReason: String
+}
+
+struct RagImeSensitiveFieldStatus {
+  let isSensitive: Bool
+  let reason: String
+
+  var privacyDisposition: String {
+    guard isSensitive else { return "allowed" }
+    return reason.hasPrefix("privacy_unknown_") ? "unknown" : "sensitive"
+  }
+}
+
+final class RagImeForegroundContextResolver {
+  private let accessibilityProvider = RagImeSelectedTextProvider()
+
+  func captureFromTextInputClient(
+    _ client: IMKTextInput?,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80
+  ) -> RagImeForegroundTextCaptureResult {
+    let sensitiveStatus = accessibilityProvider.sensitiveFieldStatus(sourceAppBundleId: sourceAppBundleId)
+    guard !sensitiveStatus.isSensitive else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: sensitiveStatus.reason)
+    }
+    guard let client else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "text_input_client_missing")
+    }
+    let selectedRange = client.selectedRange()
+    guard selectedRange.location != NSNotFound, selectedRange.location >= 0, selectedRange.length >= 0 else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "selected_range_invalid")
+    }
+    let beforeLength = min(max(0, selectedRange.location), max(0, beforeLimit))
+    let beforeRange = NSRange(location: max(0, selectedRange.location - beforeLength), length: beforeLength)
+    guard let beforeValue = client.attributedSubstring(from: beforeRange)?.string else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "attributed_substring_unavailable")
+    }
+    let selectedText = selectedRange.length > 0
+      ? (client.attributedSubstring(from: selectedRange)?.string ?? "")
+      : ""
+    let afterRange = NSRange(location: selectedRange.location + selectedRange.length, length: max(0, afterLimit))
+    let afterText = client.attributedSubstring(from: afterRange)?.string ?? ""
+    let before = beforeValue.trimmingCharacters(in: .whitespacesAndNewlines)
+    let selected = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    let after = afterText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !before.isEmpty || !selected.isEmpty || !after.isEmpty else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "attributed_substring_empty")
+    }
+    let capturedAtMs = Int(Date().timeIntervalSince1970 * 1000)
+    let group = accessibilityProvider.resolveContextGroupIdentity(sourceAppBundleId: sourceAppBundleId)
+    return RagImeForegroundTextCaptureResult(
+      snapshot: RagImeForegroundTextSnapshot(
+        available: true,
+        source: "text_input_client",
+        confidence: 0.92,
+        freshnessMs: 0,
+        selectedTextHash: selected.isEmpty ? "" : ragImeStableTextHash(selected),
+        selectedTextChars: selected.count,
+        selectedTextPreview: String(selected.prefix(48)),
+        surroundingBefore: before,
+        surroundingAfter: after,
+        wholeValueHash: "",
+        wholeValueChars: 0,
+        canReplaceSelection: !selected.isEmpty,
+        captureEpoch: captureEpoch,
+        capturedAtMs: capturedAtMs,
+        sourceAppBundleId: sourceAppBundleId,
+        inputSourceId: inputSourceId,
+        captureFailureReason: "",
+        warnings: ["text_input_client_ok"],
+        snapshotId: "ctx_\(UUID().uuidString)",
+        contextGroupId: group.id,
+        contextGroupLevel: group.level,
+        contextGroupConfidence: group.confidence,
+        commitTextMatched: false
+      ),
+      failureReason: ""
+    )
+  }
+
+  func captureFromAccessibility(
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80
+  ) -> RagImeForegroundTextCaptureResult {
+    accessibilityProvider.resolveForegroundTextForSidecar(
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit,
+      allowAccessibility: true
+    )
+  }
+}
+
+final class RagImeSelectedTextProvider {
+  private static let defaultSensitiveBundleIds: Set<String> = [
+    "com.apple.passwords",
+    "com.1password.1password",
+    "com.agilebits.onepassword7",
+    "com.bitwarden.desktop",
+    "com.lastpass.lastpass",
+    "com.dashlane.dashlane",
+    "org.keepassxc.keepassxc",
+    "com.authy.authy-mac",
+    "org.torproject.torbrowser",
+    "com.duckduckgo.macos.browser",
+  ]
+  private static let defaultSensitiveBundleTokens: Set<String> = [
+    "password", "1password", "bitwarden", "lastpass", "dashlane", "keepass", "enpass",
+    "bank", "banking", "privatebrowser", "torbrowser",
+  ]
+
+  func sensitiveFieldStatus(sourceAppBundleId: String = "") -> RagImeSensitiveFieldStatus {
+    if IsSecureEventInputEnabled() {
+      return RagImeSensitiveFieldStatus(isSensitive: true, reason: "secure_event_input")
+    }
+    let appBundleId = resolvedSourceAppBundleId(sourceAppBundleId)
+    guard !appBundleId.isEmpty else {
+      return RagImeSensitiveFieldStatus(isSensitive: true, reason: "privacy_unknown_app_bundle_missing")
+    }
+    if sensitiveApplicationReason(bundleIdentifier: appBundleId) != nil {
+      return RagImeSensitiveFieldStatus(isSensitive: true, reason: "sensitive_application_bundle")
+    }
+    // InputMethodKit already owns the active text client. Accessibility metadata is
+    // optional enrichment for field classification, not a prerequisite for local
+    // completion. Ad-hoc development builds change code identity frequently, so
+    // failing closed here would silently disable every ordinary text field after
+    // each reinstall. Secure Event Input and known sensitive apps above still
+    // remain hard stops; readable AX metadata below adds field-level protection.
+    guard AXIsProcessTrusted() else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_ax_not_trusted")
+    }
+    guard let focused = focusedTextElement() else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_focused_element_missing")
+    }
+    let roleRead = privacyStringAttribute(kAXRoleAttribute as CFString, element: focused, required: true)
+    guard !roleRead.failed, let role = roleRead.value else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_metadata_read_failed")
+    }
+    let subroleRead = privacyStringAttribute(kAXSubroleAttribute as CFString, element: focused)
+    guard !subroleRead.failed else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_metadata_read_failed")
+    }
+    let subrole = subroleRead.value ?? ""
+    let secureRole = "\(role) \(subrole)".lowercased()
+    if secureRole.contains("securetextfield") || secureRole.contains("secure text") {
+      return RagImeSensitiveFieldStatus(isSensitive: true, reason: "ax_secure_text_field")
+    }
+    let metadataAttributes = [
+      kAXTitleAttribute as CFString,
+      kAXDescriptionAttribute as CFString,
+      kAXHelpAttribute as CFString,
+      "AXPlaceholderValue" as CFString,
+      "AXIdentifier" as CFString,
+    ]
+    let metadataReads = metadataAttributes.map {
+      privacyStringAttribute($0, element: focused)
+    }
+    guard !metadataReads.contains(where: { $0.failed }) else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_metadata_read_failed")
+    }
+    let windowTitleRead = privacyWindowTitle(element: focused)
+    guard !windowTitleRead.failed else {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_metadata_read_failed")
+    }
+    let metadataValues = metadataReads.compactMap { $0.value } + [windowTitleRead.value ?? ""]
+    let metadata = metadataValues.joined(separator: " ").lowercased()
+    // Field-level blocking is deliberately narrow: explicit password fields only.
+    // Password managers, banking apps, and private browsers are handled by the
+    // application denylist above, so ordinary login/email/OTP fields keep AI enabled.
+    let sensitiveTokens = [
+      "password", "passcode", "密码", "口令",
+    ]
+    if sensitiveTokens.contains(where: metadata.contains) {
+      return RagImeSensitiveFieldStatus(isSensitive: true, reason: "sensitive_field_metadata")
+    }
+    if (secureRole.contains("textfield") || secureRole.contains("combobox"))
+      && metadata.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+      return RagImeSensitiveFieldStatus(isSensitive: false, reason: "privacy_unknown_text_field_metadata_missing")
+    }
+    return RagImeSensitiveFieldStatus(isSensitive: false, reason: "")
+  }
+
+  func captureForegroundTextForSidecar(
+    captureEpoch: Int,
+    sourceAppBundleId: String = "",
+    inputSourceId: String = "",
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80,
+    allowAccessibility: Bool = true
+  ) -> RagImeForegroundTextSnapshot? {
+    resolveForegroundTextForSidecar(
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit,
+      allowAccessibility: allowAccessibility
+    ).snapshot
+  }
+
+  func resolveForegroundTextForSidecar(
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int = 300,
+    afterLimit: Int = 80,
+    allowAccessibility: Bool = true
+  ) -> RagImeForegroundTextCaptureResult {
+    let sensitiveStatus = sensitiveFieldStatus(sourceAppBundleId: sourceAppBundleId)
+    guard !sensitiveStatus.isSensitive else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: sensitiveStatus.reason)
+    }
+    guard allowAccessibility else {
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: "accessibility_disabled")
+    }
+    guard let focused = focusedTextElement() else {
+      let reason = AXIsProcessTrusted() ? "ax_focused_element_missing" : "ax_not_trusted"
+      return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: reason)
+    }
+    let selectedRange = selectedTextRange(in: focused)
+    if let range = selectedRange,
+       let snapshot = foregroundSnapshotFromStringForRange(
+        focused,
+        selectedRange: range,
+        captureEpoch: captureEpoch,
+        sourceAppBundleId: sourceAppBundleId,
+        inputSourceId: inputSourceId,
+        beforeLimit: beforeLimit,
+        afterLimit: afterLimit
+       ) {
+      return RagImeForegroundTextCaptureResult(snapshot: snapshot, failureReason: "")
+    }
+    if let snapshot = foregroundSnapshotFromWholeValue(
+      focused,
+      selectedRange: selectedRange,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      beforeLimit: beforeLimit,
+      afterLimit: afterLimit
+    ) {
+      return RagImeForegroundTextCaptureResult(snapshot: snapshot, failureReason: "")
+    }
+    let reason = selectedRange == nil ? "ax_selected_range_unavailable" : "ax_string_for_range_failed"
+    return RagImeForegroundTextCaptureResult(snapshot: nil, failureReason: reason)
+  }
+
+  func captureSelectedTextForActiveRag(
+    captureEpoch: Int,
+    sourceAppBundleId: String = "",
+    allowAccessibility: Bool = true,
+    allowClipboardFallback: Bool = true
+  ) -> RagImeSelectedTextCapture? {
+    guard !sensitiveFieldStatus(sourceAppBundleId: sourceAppBundleId).isSensitive else { return nil }
+    if allowAccessibility, let axCapture = captureSelectedTextViaAccessibility(captureEpoch: captureEpoch) {
+      return axCapture
+    }
+    guard allowClipboardFallback else { return nil }
+    return captureSelectedTextViaClipboardFallbackPreservingPasteboard(captureEpoch: captureEpoch)
+  }
+
+  private func captureSelectedTextViaAccessibility(captureEpoch: Int) -> RagImeSelectedTextCapture? {
+    guard let focused = focusedTextElement() else { return nil }
+    var selectedObject: AnyObject?
+    let selectedResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXSelectedTextAttribute as CFString,
+      &selectedObject
+    )
+    guard selectedResult == .success, let selectedText = selectedObject as? String else {
+      return nil
+    }
+    return makeCapture(
+      selectedText: selectedText,
+      surroundingBefore: "",
+      surroundingAfter: "",
+      canReplaceSelection: true,
+      captureEpoch: captureEpoch,
+      captureSource: "accessibility_selected_text"
+    )
+  }
+
+  private func focusedTextElement() -> AXUIElement? {
+    let systemWide = AXUIElementCreateSystemWide()
+    var focusedObject: AnyObject?
+    let focusedResult = AXUIElementCopyAttributeValue(
+      systemWide,
+      kAXFocusedUIElementAttribute as CFString,
+      &focusedObject
+    )
+    guard focusedResult == .success, let focused = focusedObject else {
+      return nil
+    }
+    return (focused as! AXUIElement)
+  }
+
+  private func selectedTextRange(in focused: AXUIElement) -> CFRange? {
+    var rangeObject: AnyObject?
+    let rangeResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXSelectedTextRangeAttribute as CFString,
+      &rangeObject
+    )
+    guard rangeResult == .success, let rangeObject = rangeObject else {
+      return nil
+    }
+    let rangeValue = rangeObject as! AXValue
+    var range = CFRange(location: 0, length: 0)
+    guard AXValueGetValue(rangeValue, .cfRange, &range), range.location != kCFNotFound else {
+      return nil
+    }
+    return range
+  }
+
+  private func foregroundSnapshotFromStringForRange(
+    _ focused: AXUIElement,
+    selectedRange: CFRange,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int,
+    afterLimit: Int
+  ) -> RagImeForegroundTextSnapshot? {
+    let cursorStart = max(0, selectedRange.location)
+    let selectedLength = max(0, selectedRange.length)
+    let beforeStart = max(0, cursorStart - max(0, beforeLimit))
+    let beforeLength = max(0, cursorStart - beforeStart)
+    let afterStart = max(0, cursorStart + selectedLength)
+    guard let before = accessibilityString(for: CFRange(location: beforeStart, length: beforeLength), in: focused) else {
+      return nil
+    }
+    let selectedText = selectedLength > 0
+      ? (accessibilityString(for: CFRange(location: cursorStart, length: selectedLength), in: focused) ?? "")
+      : ""
+    let after = accessibilityString(for: CFRange(location: afterStart, length: max(0, afterLimit)), in: focused) ?? ""
+    return makeForegroundSnapshot(
+      surroundingBefore: before,
+      surroundingAfter: after,
+      selectedText: selectedText,
+      wholeValue: "",
+      confidence: 0.86,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      warnings: ["string_for_range"]
+    )
+  }
+
+  private func foregroundSnapshotFromWholeValue(
+    _ focused: AXUIElement,
+    selectedRange: CFRange?,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    beforeLimit: Int,
+    afterLimit: Int
+  ) -> RagImeForegroundTextSnapshot? {
+    guard let value = accessibilityValueString(in: focused), !value.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+      return nil
+    }
+    let whole = value as NSString
+    let location = min(max(0, selectedRange?.location ?? whole.length), whole.length)
+    let selectedLength = min(max(0, selectedRange?.length ?? 0), max(0, whole.length - location))
+    let beforeStart = max(0, location - max(0, beforeLimit))
+    let before = whole.substring(with: NSRange(location: beforeStart, length: location - beforeStart))
+    let selectedText = selectedLength > 0
+      ? whole.substring(with: NSRange(location: location, length: selectedLength))
+      : ""
+    let afterStart = min(whole.length, location + selectedLength)
+    let afterLength = min(max(0, afterLimit), max(0, whole.length - afterStart))
+    let after = whole.substring(with: NSRange(location: afterStart, length: afterLength))
+    var warnings = ["ax_value_fallback"]
+    if selectedRange == nil {
+      warnings.append("selected_range_unavailable")
+    }
+    return makeForegroundSnapshot(
+      surroundingBefore: before,
+      surroundingAfter: after,
+      selectedText: selectedText,
+      wholeValue: value,
+      confidence: selectedRange == nil ? 0.62 : 0.72,
+      captureEpoch: captureEpoch,
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      warnings: warnings
+    )
+  }
+
+  private func accessibilityString(for range: CFRange, in focused: AXUIElement) -> String? {
+    guard range.location >= 0, range.length > 0 else { return "" }
+    var mutableRange = range
+    guard let rangeValue = AXValueCreate(.cfRange, &mutableRange) else { return nil }
+    var textObject: AnyObject?
+    let textResult = AXUIElementCopyParameterizedAttributeValue(
+      focused,
+      kAXStringForRangeParameterizedAttribute as CFString,
+      rangeValue,
+      &textObject
+    )
+    guard textResult == .success else { return nil }
+    return textObject as? String
+  }
+
+  private func accessibilityValueString(in focused: AXUIElement) -> String? {
+    var valueObject: AnyObject?
+    let valueResult = AXUIElementCopyAttributeValue(
+      focused,
+      kAXValueAttribute as CFString,
+      &valueObject
+    )
+    guard valueResult == .success else { return nil }
+    return valueObject as? String
+  }
+
+  private func makeForegroundSnapshot(
+    surroundingBefore: String,
+    surroundingAfter: String,
+    selectedText: String,
+    wholeValue: String,
+    confidence: Double,
+    captureEpoch: Int,
+    sourceAppBundleId: String,
+    inputSourceId: String,
+    warnings: [String]
+  ) -> RagImeForegroundTextSnapshot? {
+    let compactBefore = surroundingBefore.trimmingCharacters(in: .whitespacesAndNewlines)
+    let compactAfter = surroundingAfter.trimmingCharacters(in: .whitespacesAndNewlines)
+    let compactSelected = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !compactBefore.isEmpty || !compactAfter.isEmpty || !compactSelected.isEmpty else { return nil }
+    let group = resolveContextGroupIdentity(sourceAppBundleId: sourceAppBundleId)
+    return RagImeForegroundTextSnapshot(
+      available: true,
+      source: "accessibility",
+      confidence: confidence,
+      freshnessMs: 0,
+      selectedTextHash: compactSelected.isEmpty ? "" : ragImeStableTextHash(compactSelected),
+      selectedTextChars: compactSelected.count,
+      selectedTextPreview: String(compactSelected.prefix(48)),
+      surroundingBefore: compactBefore,
+      surroundingAfter: compactAfter,
+      wholeValueHash: wholeValue.isEmpty ? "" : ragImeStableTextHash(wholeValue),
+      wholeValueChars: wholeValue.count,
+      canReplaceSelection: !compactSelected.isEmpty,
+      captureEpoch: captureEpoch,
+      capturedAtMs: Int(Date().timeIntervalSince1970 * 1000),
+      sourceAppBundleId: sourceAppBundleId,
+      inputSourceId: inputSourceId,
+      captureFailureReason: "",
+      warnings: warnings,
+      snapshotId: "ctx_\(UUID().uuidString)",
+      contextGroupId: group.id,
+      contextGroupLevel: group.level,
+      contextGroupConfidence: group.confidence,
+      commitTextMatched: false
+    )
+  }
+
+  func resolveContextGroupIdentity(sourceAppBundleId: String) -> (id: String, level: String, confidence: Double) {
+    guard let focused = focusedTextElement() else {
+      return (ragImeContextGroupId(prefix: "app", values: [sourceAppBundleId]), "app", 0.5)
+    }
+    if let document = accessibilityStringAttribute(kAXDocumentAttribute as CFString, element: focused), !document.isEmpty {
+      return (ragImeContextGroupId(prefix: "doc", values: [sourceAppBundleId, document]), "document", 1.0)
+    }
+    var windowObject: AnyObject?
+    if AXUIElementCopyAttributeValue(focused, kAXWindowAttribute as CFString, &windowObject) == .success,
+       let windowObject {
+      let window = windowObject as! AXUIElement
+      if let title = accessibilityStringAttribute(kAXTitleAttribute as CFString, element: window), !title.isEmpty {
+        return (ragImeContextGroupId(prefix: "doc", values: [sourceAppBundleId, title]), "document", 0.85)
+      }
+    }
+    return (ragImeContextGroupId(prefix: "app", values: [sourceAppBundleId]), "app", 0.5)
+  }
+
+  private func accessibilityStringAttribute(_ attribute: CFString, element: AXUIElement) -> String? {
+    var value: AnyObject?
+    guard AXUIElementCopyAttributeValue(element, attribute, &value) == .success else { return nil }
+    return value as? String
+  }
+
+  private func privacyStringAttribute(
+    _ attribute: CFString,
+    element: AXUIElement,
+    required: Bool = false
+  ) -> (value: String?, failed: Bool) {
+    var value: AnyObject?
+    let result = AXUIElementCopyAttributeValue(element, attribute, &value)
+    if result == .attributeUnsupported || result == .noValue {
+      return (nil, required)
+    }
+    guard result == .success else { return (nil, true) }
+    guard let value else { return (nil, required) }
+    guard let text = value as? String else { return (nil, true) }
+    let normalized = text.trimmingCharacters(in: .whitespacesAndNewlines)
+    if required && normalized.isEmpty { return (nil, true) }
+    return (text, false)
+  }
+
+  private func privacyWindowTitle(element: AXUIElement) -> (value: String?, failed: Bool) {
+    var value: AnyObject?
+    let result = AXUIElementCopyAttributeValue(element, kAXWindowAttribute as CFString, &value)
+    if result == .attributeUnsupported || result == .noValue {
+      return (nil, false)
+    }
+    guard result == .success, let value else { return (nil, true) }
+    let window = value as! AXUIElement
+    return privacyStringAttribute(kAXTitleAttribute as CFString, element: window)
+  }
+
+  private func resolvedSourceAppBundleId(_ configured: String) -> String {
+    let explicit = configured.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    if !explicit.isEmpty { return explicit }
+    return NSWorkspace.shared.frontmostApplication?.bundleIdentifier?
+      .trimmingCharacters(in: .whitespacesAndNewlines).lowercased() ?? ""
+  }
+
+  private func sensitiveApplicationReason(bundleIdentifier: String) -> String? {
+    let normalized = bundleIdentifier.trimmingCharacters(in: .whitespacesAndNewlines).lowercased()
+    guard !normalized.isEmpty else { return "privacy_unknown_app_bundle_missing" }
+    var exactIds = Self.defaultSensitiveBundleIds
+    exactIds.formUnion(sensitiveAppConfigValues(
+      ProcessInfo.processInfo.environment["RAG_IME_SENSITIVE_APP_BUNDLE_IDS"] ?? ""
+    ))
+    exactIds.formUnion(sensitiveAppConfigValues(
+      UserDefaults.standard.string(forKey: "RagImeSensitiveAppBundleIds") ?? ""
+    ))
+    if exactIds.contains(normalized) { return "sensitive_application_bundle" }
+
+    var tokens = Self.defaultSensitiveBundleTokens
+    tokens.formUnion(sensitiveAppConfigValues(
+      ProcessInfo.processInfo.environment["RAG_IME_SENSITIVE_APP_BUNDLE_TOKENS"] ?? ""
+    ))
+    tokens.formUnion(sensitiveAppConfigValues(
+      UserDefaults.standard.string(forKey: "RagImeSensitiveAppBundleTokens") ?? ""
+    ))
+    return tokens.contains(where: normalized.contains) ? "sensitive_application_bundle" : nil
+  }
+
+  private func sensitiveAppConfigValues(_ raw: String) -> Set<String> {
+    Set(raw.split { character in
+      character == "," || character == ";" || character == "\n" || character == " " || character == "\t"
+    }.map { String($0).lowercased() }.filter { !$0.isEmpty })
+  }
+
+  private func captureSelectedTextViaClipboardFallbackPreservingPasteboard(captureEpoch: Int) -> RagImeSelectedTextCapture? {
+    let pasteboard = NSPasteboard.general
+    let previousChangeCount = pasteboard.changeCount
+    let previousItems = pasteboard.pasteboardItems ?? []
+    sendCopyShortcutForActiveRagSelection()
+    Thread.sleep(forTimeInterval: 0.08)
+    let selectedText = pasteboard.string(forType: .string) ?? ""
+    restorePasteboardItems(previousItems, previousChangeCount: previousChangeCount)
+    return makeCapture(
+      selectedText: selectedText,
+      surroundingBefore: "",
+      surroundingAfter: "",
+      canReplaceSelection: !selectedText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+      captureEpoch: captureEpoch,
+      captureSource: "clipboard_fallback_restored"
+    )
+  }
+
+  private func sendCopyShortcutForActiveRagSelection() {
+    let source = CGEventSource(stateID: .combinedSessionState)
+    let keyDown = CGEvent(keyboardEventSource: source, virtualKey: 8, keyDown: true)
+    let keyUp = CGEvent(keyboardEventSource: source, virtualKey: 8, keyDown: false)
+    keyDown?.flags = .maskCommand
+    keyUp?.flags = .maskCommand
+    keyDown?.post(tap: .cghidEventTap)
+    keyUp?.post(tap: .cghidEventTap)
+  }
+
+  private func restorePasteboardItems(_ items: [NSPasteboardItem], previousChangeCount: Int) {
+    let pasteboard = NSPasteboard.general
+    pasteboard.clearContents()
+    if !items.isEmpty {
+      pasteboard.writeObjects(items)
+    }
+    traceRagImeSelectedTextProviderContract("clipboard_fallback_restores_clipboard_contract", previousChangeCount: previousChangeCount)
+  }
+
+  private func makeCapture(
+    selectedText: String,
+    surroundingBefore: String,
+    surroundingAfter: String,
+    canReplaceSelection: Bool,
+    captureEpoch: Int,
+    captureSource: String
+  ) -> RagImeSelectedTextCapture? {
+    let compact = selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+    guard !compact.isEmpty else { return nil }
+    return RagImeSelectedTextCapture(
+      selectedText: compact,
+      selectedTextHash: ragImeStableTextHash(compact),
+      selectedTextChars: compact.count,
+      selectedTextPreview: String(compact.prefix(48)),
+      surroundingBefore: surroundingBefore,
+      surroundingAfter: surroundingAfter,
+      canReplaceSelection: canReplaceSelection,
+      captureEpoch: captureEpoch,
+      captureSource: captureSource
+    )
+  }
+}
+
+func traceRagImeSelectedTextProviderContract(_ event: String, previousChangeCount: Int) {
+  _ = event
+  _ = previousChangeCount
+}
+
+private func ragImeContextGroupId(prefix: String, values: [String]) -> String {
+  let material = values.map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.joined(separator: "\u{001f}")
+  let digest = ragImeStableTextHash(material).replacingOccurrences(of: "sha256:", with: "")
+  return "\(prefix):\(digest.prefix(16))"
+}
