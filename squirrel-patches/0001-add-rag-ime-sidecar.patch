+  @discardableResult
+  func refreshRagImeInputClient(_ sender: Any!, reason: String) -> String {
+    let liveClient = sender as? IMKTextInput
+    if let liveClient {
+      // Chromium may rotate IMK text clients while keeping one controller alive.
+      // Always follow the sender instead of retaining the first client forever.
+      client = liveClient
+    }
+
+    let clientBundleId = client?.bundleIdentifier()?
+      .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+    if reason == "key_event", !clientBundleId.isEmpty, clientBundleId == currentApp {
+      // The common path must not query NSWorkspace or rebuild app state.
+      return currentApp
+    }
+    let frontmostBundleId = NSWorkspace.shared.frontmostApplication?.bundleIdentifier?
+      .trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
+    let resolvedBundleId: String
+    let identitySource: String
+    if !clientBundleId.isEmpty {
+      resolvedBundleId = clientBundleId
+      identitySource = "text_input_client"
+    } else if !frontmostBundleId.isEmpty {
+      // Edge/Chromium can activate an IMK client whose bundleIdentifier() is nil.
+      // The frontmost application is the safest non-text fallback and restores
+      // per-app Squirrel options such as inline preedit for those clients.
+      resolvedBundleId = frontmostBundleId
+      identitySource = "frontmost_application"
+    } else {
+      resolvedBundleId = currentApp
+      identitySource = currentApp.isEmpty ? "unresolved" : "existing_session"
+    }
+
+    let previousApp = currentApp
+    if !resolvedBundleId.isEmpty && resolvedBundleId != previousApp {
+      invalidateRagImeForegroundTransaction(reason: "front_app_changed")
+      dismissRagImeAssistantOverlay(reason: "front_app_changed")
+      currentApp = resolvedBundleId
+      if session != 0 {
+        updateAppOptions()
+      }
+    }
+    if reason == "activate_server" || resolvedBundleId != previousApp {
+      traceRagImeFrontendEvent("input_client_identity_resolved", fields: [
+        "reason": reason,
+        "resolvedBundleId": resolvedBundleId,
+        "identitySource": identitySource,
+        "clientBundleMissing": clientBundleId.isEmpty,
+        "clientRefreshed": liveClient != nil,
+        "appChanged": resolvedBundleId != previousApp,
+      ])
+    }
+    return resolvedBundleId
+  }
