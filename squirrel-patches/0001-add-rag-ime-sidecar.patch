+  func mergedRagImePanelCandidates(
+    rawInput: String,
+    preedit: String,
+    fallbackCandidates: [String],
+    fallbackComments: [String],
+    fallbackLabels: [String]
+  ) -> (candidates: [String], comments: [String], labels: [String]) {
+    ragImePanelUsesDisplayCandidates = false
+    guard !ragImeDisplayCandidates.isEmpty else {
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    if rawInput.isEmpty && preedit.isEmpty {
+      guard canUseRagImePostCommitDisplayHoldover(fallbackCandidates: fallbackCandidates) else {
+        clearRagImeDisplayCandidates()
+        return (fallbackCandidates, fallbackComments, fallbackLabels)
+      }
+      ragImePanelUsesDisplayCandidates = true
+      traceRagImeFrontendEvent("panel_display_candidates", fields: [
+        "rawInput": rawInput,
+        "preedit": preedit,
+        "exactMatch": true,
+        "holdover": true,
+        "postCommitHoldover": true,
+        "forcesHorizontalLayout": ragImePanelForcesHorizontalLayout(),
+        "forcesVerticalList": ragImePanelForcesVerticalList(),
+        "candidateCounts": ragImeTraceCandidateCounts(),
+        "candidates": ragImeTraceCandidateSummaries(),
+      ])
+      return ragImeDisplayPanelPayload(fallbackLabels: fallbackLabels)
+    }
+    let exactMatch = ragImeDisplayRawInput == rawInput && ragImeDisplayPreedit == preedit
+    let canHold = canUseRagImeDisplayHoldover(
+      rawInput: rawInput,
+      preedit: preedit,
+      fallbackCandidates: fallbackCandidates
+    )
+    if !rawInput.isEmpty
+      && !ragImeDisplayCandidates.contains(where: { $0.sourceType == "raw_english" })
+      && !ragImeDisplayCandidatesContainComposableSideCandidate() {
+      clearRagImeDisplayCandidates()
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    guard exactMatch || canHold else {
+      clearRagImeDisplayCandidates()
+      return (fallbackCandidates, fallbackComments, fallbackLabels)
+    }
+    ragImePanelUsesDisplayCandidates = true
+    traceRagImeFrontendEvent("panel_display_candidates", fields: [
+      "rawInput": rawInput,
+      "preedit": preedit,
+      "exactMatch": exactMatch,
+      "holdover": canHold,
+      "forcesHorizontalLayout": ragImePanelForcesHorizontalLayout(),
+      "forcesVerticalList": ragImePanelForcesVerticalList(),
+      "candidateCounts": ragImeTraceCandidateCounts(),
+      "candidates": ragImeTraceCandidateSummaries(),
+    ])
+    return ragImeDisplayPanelPayload(fallbackLabels: fallbackLabels)
+  }
+
+  func canUseRagImeDisplayHoldover(
+    rawInput: String,
+    preedit: String,
+    fallbackCandidates: [String],
+    now: Date = Date()
+  ) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    guard !rawInput.isEmpty || !preedit.isEmpty else { return false }
+    guard ragImeDisplayRawInput == rawInput && ragImeDisplayPreedit == preedit else { return false }
+    return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImeDisplayHoldoverDuration
+  }
+
+  func canUseRagImePostCommitDisplayHoldover(
+    fallbackCandidates: [String],
+    now: Date = Date()
+  ) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    guard ragImeDisplayRawInput.isEmpty && ragImeDisplayPreedit.isEmpty else { return false }
+    guard fallbackCandidates.isEmpty else { return false }
+    return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImePostCommitDisplayHoldoverDuration
+  }
+
+  func canSelectCurrentRagImeDisplayCandidates(now: Date = Date()) -> Bool {
+    guard !ragImeDisplayCandidates.isEmpty else { return false }
+    guard ragImeDisplaySessionStillLive(now: now) else { return false }
+    let currentRawInput = rimeAPI.get_input(session).map { String(cString: $0) } ?? ""
+    if currentRawInput.isEmpty && ragImeDisplayRawInput.isEmpty && ragImeDisplayPreedit.isEmpty {
+      return now.timeIntervalSince(ragImeDisplayUpdatedAt) <= ragImePostCommitDisplayHoldoverDuration
+    }
+    guard !currentRawInput.isEmpty else { return false }
+    return currentRawInput == ragImeDisplayRawInput
+  }
