+  func applyRagImeAssistantOverlay(
+    _ incomingPayload: RagImeAssistantOverlayPayload?,
+    semanticQuery: String,
+    preedit: String,
+    traceEvent: String = "assistant_overlay_updated"
+  ) {
+    guard !enforceRagImeSensitiveFieldGuard() else { return }
+    guard let incomingPayload, incomingPayload.visible else {
+      dismissRagImeAssistantOverlay(reason: incomingPayload?.dismissReason ?? "hidden")
+      return
+    }
+    let payload = ragImeAssistantOverlayPreservingSessionActions(incomingPayload)
+    let containsResult = ragImeAssistantOverlayContainsResult(payload)
+    if !ragImePostCommitPendingOverlayEnabled(),
+      payload.phase == "post_commit",
+      !containsResult {
+      // A pending-only sidecar frame must not tear down an already visible
+      // local placeholder. The following progressive frame owns replacement.
+      traceRagImeFrontendEvent("assistant_overlay_suppressed", fields: [
+        "reason": "post_commit_pending_update_ignored",
+        "uiMode": payload.uiMode,
+        "phase": payload.phase,
+        "candidateCount": payload.candidates.count,
+        "keptExistingPanel": ragImeAssistantOverlayController.isVisible,
+      ])
+      return
+    }
+    ragImeOverlayCandidates = payload.candidates
+    ragImeOverlayPanelSessionId = payload.candidates.first.map { ragImeDisplayCandidateStringMetadata($0, "panelSessionId") } ?? ""
+    if ragImeOverlayPanelSessionId.isEmpty {
+      ragImeOverlayPanelSessionId = payload.frontendTransaction?["panelSessionId"].flatMap { ragImeJSONValueString($0) } ?? ""
+    }
+    if ragImeOverlayPanelSessionId.isEmpty {
+      ragImeOverlayPanelSessionId = payload.snapshotId
+    }
+    ragImeOverlaySnapshotId = payload.snapshotId
+    ragImeOverlaySessionFingerprint = payload.sessionFingerprint
+    ragImeOverlayNumberKeyPolicy = payload.overlayConfigKeyPolicy("numberKeys")
+      ?? payload.keyPolicy?.numberKeys ?? "pass_through"
+    ragImeOverlayTabPolicy = payload.overlayConfigKeyPolicy("tab")
+      ?? payload.keyPolicy?.tab ?? "accept_top_prediction"
+    ragImeOverlayOptionNumberPolicy = payload.overlayConfigKeyPolicy("optionNumber")
+      ?? payload.keyPolicy?.optionNumber ?? "select_prediction_by_ordinal"
+    ragImeOverlayCompositionHash = payload.candidates.first.map { ragImeDisplayCandidateStringMetadata($0, "compositionHash") } ?? ""
+    if ragImeOverlayCompositionHash.isEmpty {
+      ragImeOverlayCompositionHash = ragImeDisplayCompositionHash
+    }
+    ragImeOverlayCommittedContextHash = payload.candidates.first.map { ragImeDisplayCandidateStringMetadata($0, "committedContextHash") } ?? ""
+    if ragImeOverlayCommittedContextHash.isEmpty {
+      ragImeOverlayCommittedContextHash = ragImeDisplayCommittedContextHash
+    }
+    ragImeOverlaySemanticQuery = semanticQuery
+    ragImeOverlayPreedit = preedit
+    let configuredTTL = Int(payload.overlayConfigNumber("expiresAfterMs") ?? Double(payload.expiresAfterMs))
+    let isExplicitOverlay = payload.phase == "active_rag" || payload.uiMode.contains("active_rag")
+    let isPendingFeedback = payload.uiMode.contains("pending")
+    let maximumTTL = containsResult ? 30000 : (isPendingFeedback ? 12000 : 2000)
+    let effectiveTTL = min(max(configuredTTL > 0 ? configuredTTL : 8000, 500), maximumTTL)
+    // Explicit generation is user-paid and remains actionable until accept,
+    // close, retry or focus change. A hidden selection TTL would otherwise
+    // leave a pinned card visible but impossible to insert after 30 seconds.
+    ragImeOverlayExpiresAt = isExplicitOverlay
+      ? nil
+      : Date().addingTimeInterval(TimeInterval(effectiveTTL) / 1000)
+    ragImeAssistantOverlayController.update(
+      payload,
+      anchor: currentRagImeInputAnchor(),
+      onSelect: { [weak self] candidate, index, mode in
+        _ = self?.commitRagImeAssistantCandidate(
+          candidate,
+          route: mode == .replace ? "replace_button" : "click",
+          index: index,
+          replaceSelection: mode == .replace
+        )
+      },
+      onAction: { [weak self] action in
+        self?.handleRagImeAssistantAction(action)
+      },
+      onRestore: { [weak self] in
+        self?.applyRagImeAssistantOverlay(
+          payload,
+          semanticQuery: semanticQuery,
+          preedit: preedit,
+          traceEvent: "assistant_overlay_explicit_restored"
+        )
+      },
+      onDismiss: { [weak self] reason in
+        self?.ragImeAssistantOverlayDidDismiss(reason: reason)
+      },
+      onTrace: { [weak self] event, fields in
+        self?.traceRagImeFrontendEvent(event, fields: fields)
+      }
+    )
+    let overlayCandidates = payload.candidates.enumerated().map { index, candidate in
+      ragImeOverlayTraceCandidateSummary(candidate, index: index)
+    }
+    let overlayKeyPolicy: [String: Any] = [
+      "numberKeys": ragImeOverlayNumberKeyPolicy,
+      "tab": ragImeOverlayTabPolicy,
+      "optionNumber": ragImeOverlayOptionNumberPolicy,
+      "escape": payload.overlayConfigKeyPolicy("escape") ?? payload.keyPolicy?.escape ?? "dismiss_prediction",
+    ]
+    let activeOverlayTraceAnchor: [String: Any] = isExplicitOverlay ? [
+      "selectedTextHash": ragImeActiveRagSelectedTextHash,
+      "frontendRevision": ragImeActiveRagFrontendRevision,
+      "selectionEpoch": ragImeActiveRagSelectionEpoch,
+      "panelSessionId": ragImeActiveRagPanelSessionId,
+      "frontAppBundleId": ragImeActiveRagFrontAppBundleId,
+      "traceIncludesText": false,
+    ] : [:]
+    traceRagImeFrontendEvent(traceEvent, fields: activeOverlayTraceAnchor.merging([
+      "uiMode": payload.uiMode,
+      "phase": payload.phase,
+      "candidateCount": payload.candidates.count,
+      "candidates": overlayCandidates,
+      "keyPolicy": overlayKeyPolicy,
+      "sourceCardCount": payload.sourceCards.count,
+      "statusText": payload.statusText,
+      "snapshotId": payload.snapshotId,
+      "panelSessionId": ragImeOverlayPanelSessionId,
+    ]) { _, new in new })
+    if !payload.sourceCards.isEmpty {
+      traceRagImeFrontendEvent("assistant_overlay_source_cards_visible", fields: activeOverlayTraceAnchor.merging([
+        "sourceCardCount": payload.sourceCards.count,
+        "uiMode": payload.uiMode,
+      ]) { _, new in new })
+    }
+    if !payload.candidates.isEmpty {
+      traceRagImeFrontendEvent("assistant_overlay_candidate_visible", fields: activeOverlayTraceAnchor.merging([
+        "candidateCount": payload.candidates.count,
+        "uiMode": payload.uiMode,
+        "phase": payload.phase,
+        "snapshotId": payload.snapshotId,
+        "panelSessionId": ragImeOverlayPanelSessionId,
+        "keyPolicy": overlayKeyPolicy,
+        "candidates": overlayCandidates,
+      ]) { _, new in new })
+    }
+  }
