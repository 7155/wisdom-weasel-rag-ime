{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-ime.contract.work-document-context.v1",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "rag-ime.work-document-context.v1"},
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["documentId", "title", "path", "contentSha256", "authorityKey"],
        "properties": {
          "documentId": {"type": "string", "pattern": "^workdoc_[a-f0-9]{32}$"},
          "title": {"type": "string", "maxLength": 240},
          "path": {"type": "string", "minLength": 1, "maxLength": 1000},
          "contentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "authorityKey": {"type": "string", "minLength": 1, "maxLength": 320}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
