{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-ime.contract.control-tool-manifest.v1",
  "type": "object",
  "required": ["schemaVersion", "id", "domain", "displayName", "description", "category", "riskLevel", "sessionModes", "operations", "resultPresentation", "availability", "version"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "rag-ime.control-tool-manifest.v1"},
    "id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["overview", "input", "voice", "planning", "memory", "knowledge", "models", "runtime", "configuration", "agents", "workspace"]},
    "riskLevel": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]},
    "operationRisks": {
      "type": "object",
      "additionalProperties": {"type": "string", "enum": ["R0", "R1", "R2", "R3"]}
    },
    "sessionModes": {"type": "array", "items": {"type": "string", "enum": ["assistant", "coordinator"]}},
    "operations": {"type": "array", "items": {"type": "string"}},
    "resultPresentation": {"type": "string", "enum": ["status", "table", "citation", "tool_result", "diff", "approval", "terminal", "media"]},
    "availability": {"type": "string", "enum": ["online", "offline", "disabled", "unconfigured"]},
    "version": {"type": "string", "minLength": 1}
  }
}
