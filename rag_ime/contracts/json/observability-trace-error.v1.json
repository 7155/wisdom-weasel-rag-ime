    "schemaVersion": {"const": "rag-ime.observability-trace-error.v1"},
    "ok": {"const": false},
    "errorCode": {"enum": ["trace_not_found", "invalid_trace_id", "trace_invalid"]},
    "error": {"type": "string", "minLength": 1},
    "traceId": {"type": "string"}
  }
}
