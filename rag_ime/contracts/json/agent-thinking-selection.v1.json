{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-ime.contract.agent-thinking-selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ok", "sessionId", "thinkingLevel", "selected"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "rag-ime.agent-thinking-selection.v1"},
    "ok": {"type": "boolean", "const": true},
    "sessionId": {"type": "string", "minLength": 1},
    "thinkingLevel": {"type": "string", "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]},
    "selected": {"type": ["object", "null"]}
  }
}
