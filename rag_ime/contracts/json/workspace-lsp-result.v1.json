{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rag-ime.contract.workspace-lsp-result.v1",
  "type": "object",
  "required": ["schemaVersion", "summary", "operation", "root", "server"],
  "properties": {
    "schemaVersion": {"type": "string", "const": "rag-ime.workspace-lsp-result.v1"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "operation": {"type": "string", "enum": ["symbols", "hover", "definition", "references", "diagnostics"]},
    "root": {"type": "string", "minLength": 1, "maxLength": 4096},
    "server": {"type": "string", "maxLength": 1000},
    "items": {"type": "array", "maxItems": 200, "items": {"type": "object"}},
    "content": {"type": "string", "maxLength": 16384},
    "range": {
      "type": ["object", "null"],
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "endLine": {"type": "integer", "minimum": 1},
        "endColumn": {"type": "integer", "minimum": 1}
      },
      "required": ["line", "column", "endLine", "endColumn"],
      "additionalProperties": false
    },
    "truncated": {"type": "boolean"}
  },
  "additionalProperties": false
}
