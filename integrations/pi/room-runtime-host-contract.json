    "session": "packages/rag-ime-runtime-host/src/pi-session.ts"
  },
  "requiredSourceMarkers": {
    "protocol": ["export const PROTOCOL_VERSION = \"2\" as const;"],
    "runtimeHost": [
      "case \"room.dispatch\"",
      "case \"room.cancel\"",
      "roomSkillPolicy: optionalRoomSkillPolicy(params)",
      "roomSkillLoad: opened.session.roomSkillLoadReceipt()"
    ],
    "providerContextHook": ["before_provider_request"],
    "contextInspection": [
      "pi.on(\"before_provider_request\"",
      "return record ? structuredClone(record) : undefined;",
      "normalizeDebugContextRecord(parsed, this.maxCallsPerTurn)",
      "loadedSkillRecoveryReceipts()",
      "safeReasoningInspectionValue"
    ],
    "skills": [
      "input: routing?.input",
      "Cards contain name, when, notFor, input, output, and does; load only on a positive match."
    ],
    "discoveryTools": [
      "Use tool_search for detail and tool_load for one schema.",
      "tool: backendToolRouteEntry(loaded.tool)"
    ],
    "toolBridge": [
      "when?: string[];",
      "notFor?: string[];",
      "input?: string;",
      "output?: string;",
      "does?: string;",
      "const artifacts = new ToolArtifactBuffer();"
    ],
    "toolArtifacts": [
      "export class ToolArtifactBuffer",
      "export function modelVisibleResult",
      "const ROOM_DELIVERY_TOOLS = new Set([\"room_post\", \"room_commit\"]);"
    ],
    "providerContextJournal": [
      "export class ProviderContextJournal",
      "Provider context epoch transition is stale or non-monotonic",
      "<rag-ime-context type=\"${entry.kind}\">"
    ],
    "sessionContextRefresh": [
      "Managed Room compaction is missing compactionEntryId",
      "rag-ime.managed-room-compaction-pointer.v1",
      "session_before_compact",
      "roomRecoveryContext",
      "expectedContextEpoch",
      "preCompactionMessages",
      "getAgentSkillRecovery"
    ],
    "summarizationCompletion": [
      "export async function completeSummarizationWithRetry(",
      "isRetryableAssistantError",
      "Compaction cancelled"
    ],
    "cancellationReceipts": [
      "export function roomCancellationSurfaces",
      "wisdom-weasel.runtime-surface-termination-receipt.v1",
      "pendingRoomCancellationSurfaces"
    ],
    "roomSettleLifecycle": [
      "origin: \"room_settle_guard\"",
      "maxAttempts: 1",
      "event.message.stopReason === \"error\" || event.message.stopReason === \"aborted\""
    ],
    "workflowControl": [
      "const showPlan = Boolean(planStatus) && (planStatus !== \"draft\" || planItems.length > 0);",
      "<rag-ime-context type=\"workflow_control\">"
    ],
    "lifecycleHooks": [
      "const isManagedRoom = (): boolean => options.isManagedRoom?.() === true;",
      "contextOwner: \"room_context_epoch\""
    ],
    "deterministicTestAdapter": [
      "export function projectTaskCanaryResponse",
      "PROJECT_TASK_SCENARIO = \"project-task\"",
      "export function projectCollaborationCanaryResponse",
      "export function agentSessionCanaryResponse"
    ],
    "session": [
      "SKILL_REVISION_MISMATCH",
      "loadReason: \"stage_required\"",
      "requiredRoomSkill(options.roomSkillPolicy)",
      "RAG_IME_PI_DEBUG_CONTEXT_MAX_CALLS"
    ]
  }
}
