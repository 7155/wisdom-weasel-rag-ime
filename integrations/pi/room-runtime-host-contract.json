{
  "schemaVersion": "rag-ime.pi-room-runtime-host-contract.v1",
  "sourceRepository": "https://github.com/7155/pi.git",
  "sourcePackage": "@earendil-works/pi-rag-ime-runtime-host",
  "protocolVersion": "2",
  "minimumHandlersCommit": "58c7070348db40e0bf2442a66a1afe341a615e70",
  "requiredMethods": [
    "room.dispatch",
    "room.cancel"
  ],
  "handlerSources": {
    "protocol": "packages/rag-ime-runtime-host/src/protocol.ts",
    "runtimeHost": "packages/rag-ime-runtime-host/src/runtime-host.ts",
    "providerContextHook": "packages/coding-agent/src/core/sdk.ts",
    "contextInspection": "packages/rag-ime-runtime-host/src/debug-context.ts",
    "skills": "packages/coding-agent/src/core/skills.ts",
    "discoveryTools": "packages/rag-ime-runtime-host/src/discovery-tools.ts",
    "toolBridge": "packages/rag-ime-runtime-host/src/tool-bridge.ts",
    "toolArtifacts": "packages/rag-ime-runtime-host/src/tool-artifact-buffer.ts",
    "providerContextJournal": "packages/rag-ime-runtime-host/src/provider-context-journal.ts",
    "sessionContextRefresh": "packages/rag-ime-runtime-host/src/session-context-refresh.ts",
    "cancellationReceipts": "packages/rag-ime-runtime-host/src/cancellation-receipts.ts",
    "roomSettleLifecycle": "packages/rag-ime-runtime-host/src/room-settle-lifecycle.ts",
    "session": "packages/rag-ime-runtime-host/src/pi-session.ts"
  },
  "requiredSourceMarkers": {
    "protocol": ["export const PROTOCOL_VERSION = \"2\" as const;"],
    "runtimeHost": [
      "case \"room.dispatch\"",
      "case \"room.cancel\"",
      "roomSkillPolicy: optionalRoomSkillPolicy(params)",
      "roomSkillLoad: opened.session.roomSkillLoadReceipt()"
    ],
    "providerContextHook": ["before_provider_request"],
    "contextInspection": ["pi.on(\"before_provider_request\""],
    "skills": [
      "input: routing?.input",
      "Each JSON line contains only name, when[], notFor[], input, output, and does."
    ],
    "discoveryTools": [
      "Use tool_load before calling a tool",
      "tool: backendToolRouteEntry(loaded.tool)"
    ],
    "toolBridge": [
      "when?: string[];",
      "notFor?: string[];",
      "input?: string;",
      "output?: string;",
      "does?: string;",
      "const artifacts = new ToolArtifactBuffer();"
    ],
    "toolArtifacts": [
      "export class ToolArtifactBuffer",
      "export function modelVisibleResult",
      "const ROOM_DELIVERY_TOOLS = new Set([\"room_post\", \"room_commit\"]);"
    ],
    "providerContextJournal": [
      "export class ProviderContextJournal",
      "Provider context epoch transition is stale or non-monotonic",
      "<rag-ime-context type=\"${entry.kind}\">"
    ],
    "sessionContextRefresh": [
      "Managed Room compaction is missing compactionEntryId",
      "roomRecoveryContext",
      "expectedContextEpoch"
    ],
    "cancellationReceipts": [
      "export function roomCancellationSurfaces",
      "wisdom-weasel.runtime-surface-termination-receipt.v1",
      "pendingRoomCancellationSurfaces"
    ],
    "roomSettleLifecycle": [
      "origin: \"room_settle_guard\"",
      "maxAttempts: 1"
    ],
    "session": [
      "SKILL_REVISION_MISMATCH",
      "loadReason: \"stage_required\"",
      "requiredRoomSkill(options.roomSkillPolicy)"
    ]
  }
}
